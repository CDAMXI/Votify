                <div class="grid grid-cols-2 md:grid-cols-5 gap-2 mb-6 bg-[#F8FAF7] p-4 rounded-lg">
                    <div class="text-center">
                        <div class="text-[10px] uppercase font-bold text-[#6C8A6C]">Innovación</div>
                        <div class="font-bold text-[#1A281B]">@myProject.CriteriaScores.Innovation</div>
                    </div>
                    <div class="text-center border-l border-[#B5D6AC]/30">
                        <div class="text-[10px] uppercase font-bold text-[#6C8A6C]">Técnica</div>
                        <div class="font-bold text-[#1A281B]">@myProject.CriteriaScores.Technical</div>
                    </div>
                    <div class="text-center border-l border-[#B5D6AC]/30">
                        <div class="text-[10px] uppercase font-bold text-[#6C8A6C]">Impacto</div>
                        <div class="font-bold text-[#1A281B]">@myProject.CriteriaScores.Impact</div>
                    </div>
                    <div class="text-center border-l border-[#B5D6AC]/30">
                        <div class="text-[10px] uppercase font-bold text-[#6C8A6C]">Presentación</div>
                        <div class="font-bold text-[#1A281B]">@myProject.CriteriaScores.Presentation</div>
                    </div>
                    <div class="text-center border-l border-[#B5D6AC]/30">
                        <div class="text-[10px] uppercase font-bold text-[#6C8A6C]">Diseño</div>
                        <div class="font-bold text-[#1A281B]">@myProject.CriteriaScores.Design</div>
                    </div>
                </div>

                @if (myProject.Comments.Any())
                {
                    <div class="bg-[#EFEFEE] rounded-lg p-4">
                        <p class="text-xs font-bold text-[#4C6B4F] mb-2 uppercase tracking-wider">Feedback recibido:</p>
                        <ul class="space-y-1">
                            @foreach (var comment in myProject.Comments)
                            {
                                <li class="text-sm text-[#6C8A6C]">" @comment "</li>
                            }
                        </ul>
                    </div>
                }
            </div>
        }
    </main>
</div>

@if (mostrandoConfiguracion && PuedeGestionarResultados)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-[#1A281B]/25 backdrop-blur-sm p-4">
        <div class="w-full max-w-2xl rounded-[2rem] bg-[#DCEBCF] p-5 shadow-2xl">
            <div class="rounded-[1.75rem] bg-white p-6 md:p-8">
                <div class="flex items-start justify-between gap-4 mb-6">
                    <div>
                        <div class="inline-flex rounded-full bg-[#6C8A6C] px-5 py-3 text-white text-2xl font-bold shadow-md">
                            Configuración de la votación
                        </div>
                        <p class="text-sm text-[#6C8A6C] mt-4">
                            Ajusta el peso de cada tipo de voto. Si necesitas neutralizar una posible parcialidad del jurado, puedes dejar el voto experto al 0%.
                        </p>
                    </div>
                    <button @onclick="CerrarConfiguracion"
                            class="rounded-full border border-[#D8E3D1] px-3 py-1 text-[#6C8A6C] hover:bg-[#F5F8F2] transition-colors">
                        ✕
                    </button>
                </div>

                @if (!string.IsNullOrWhiteSpace(mensajeConfiguracion))
                {
                    <div class="mb-5 rounded-2xl px-4 py-3 text-sm @(errorConfiguracion ? "bg-red-50 text-red-700 border border-red-200" : "bg-[#E9EFE1] text-[#4C6B4F] border border-[#B5D6AC]")">
                        @mensajeConfiguracion
                    </div>
                }

                <div class="space-y-5">
                    <div class="flex items-center justify-between gap-4 text-lg md:text-2xl">
                        <span class="font-bold text-[#1A281B]">Peso de voto experto</span>
                        <div class="flex items-center gap-2">
                            <input type="number" min="0" max="100" @bind="configuracionResultados.PesoJurado"
                                   class="w-24 rounded-2xl border border-[#B5D6AC] bg-[#F8FAF7] px-4 py-3 text-right text-[#6C8A6C] font-bold focus:outline-none focus:border-[#6C8A6C]" />
                            <span class="text-[#6C8A6C] font-bold">%</span>
                        </div>
                    </div>

                    <div class="flex items-center justify-between gap-4 text-lg md:text-2xl">
                        <span class="font-bold text-[#1A281B]">Peso de voto popular</span>
                        <div class="flex items-center gap-2">
                            <input type="number" min="0" max="100" @bind="configuracionResultados.PesoPublico"
                                   class="w-24 rounded-2xl border border-[#B5D6AC] bg-[#F8FAF7] px-4 py-3 text-right text-[#6C8A6C] font-bold focus:outline-none focus:border-[#6C8A6C]" />
                            <span class="text-[#6C8A6C] font-bold">%</span>
                        </div>
                    </div>

                    <div class="rounded-2xl bg-[#F8FAF7] border border-[#E9EFE1] px-4 py-3 text-sm text-[#6C8A6C]">
                        Total actual: <span class="font-bold">@SumaPesosActual%</span>
                    </div>

                    <div class="flex flex-wrap gap-3">
                        <button @onclick="AplicarAnulacionJurado"
                                type="button"
                                class="px-4 py-2 rounded-xl border border-[#B5D6AC] text-[#4C6B4F] hover:bg-[#E9EFE1] transition-colors">
                            Anular voto experto
                        </button>
                        <button @onclick="RestablecerPesos"
                                type="button"
                                class="px-4 py-2 rounded-xl border border-[#B5D6AC] text-[#4C6B4F] hover:bg-[#E9EFE1] transition-colors">
                            Restablecer 70/30
                        </button>
                    </div>
                </div>

                <div class="mt-8 flex flex-col-reverse sm:flex-row sm:justify-end gap-3">
                    <button @onclick="CerrarConfiguracion"
                            type="button"
                            class="px-5 py-3 rounded-xl border border-[#B5D6AC] text-[#6C8A6C] font-semibold hover:bg-[#F8FAF7] transition-colors">
                        Cancelar
                    </button>
                    <button @onclick="GuardarConfiguracionAsync"
                            type="button"
                            disabled="@guardandoConfiguracion"
                            class="px-5 py-3 rounded-xl bg-gradient-to-r from-[#6C8A6C] to-[#4C6B4F] text-white font-semibold shadow-md hover:opacity-90 transition-opacity disabled:opacity-60">
                        @(guardandoConfiguracion ? "Guardando..." : "Guardar cambios")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? EventId { get; set; }
    [Parameter]
    [SupplyParameterFromQuery]
    public string? Rol { get; set; }

    private string tabActiva = "resultados";
    private string nombreEvento = "Evento";
    private MonitorVotacionDTO? monitor;
    private List<ProyectoResultadoDTO> resultadosReales = new();
    private ConfiguracionResultadosDTO configuracionResultados = new();
    private bool cargandoResultados = true;
    private bool cargandoMonitor = false;
    private string? errorMonitor;
    private bool mostrandoConfiguracion = false;
    private bool guardandoConfiguracion = false;
    private string? mensajeConfiguracion;
    private bool errorConfiguracion = false;

    private bool PuedeGestionarResultados => Rol == "ENCARGADO" || Rol == "ORGANIZADOR";
    private int SumaPesosActual => configuracionResultados.PesoJurado + configuracionResultados.PesoPublico;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(Rol))
        {
            NavigationManager.NavigateTo($"/event-access/{EventId}?dest=results");
            return;
        }

        if (int.TryParse(EventId, out var idVotacion))
        {
            await CargarNombreEventoAsync(idVotacion);
        }

        if (PuedeGestionarResultados)
        {
            await CargarResultadosRealesAsync();
            await CargarConfiguracionAsync();
        }
        else
        {
            cargandoResultados = false;
        }
    }

    private async Task CargarNombreEventoAsync(int idVotacion)
    {
        try
        {
            var votacion = await Http.GetFromJsonAsync<VotacionDTO>($"/api/votaciones/{idVotacion}");
            if (votacion != null && !string.IsNullOrWhiteSpace(votacion.Titulo))
                nombreEvento = votacion.Titulo;
        }
        catch
        {
            nombreEvento = "Evento";
        }
    }

    private async Task CargarResultadosRealesAsync()
    {
        cargandoResultados = true;
        try
        {
            resultadosReales = await Http.GetFromJsonAsync<List<ProyectoResultadoDTO>>($"/api/resultados/{EventId}") ?? new();
        }
        catch
        {
            resultadosReales = new();
        }
        finally
        {
            cargandoResultados = false;
        }
    }

    private async Task CargarConfiguracionAsync()
    {
        try
        {
            configuracionResultados = await Http.GetFromJsonAsync<ConfiguracionResultadosDTO>($"/api/votaciones/{EventId}/configuracion-resultados")
                ?? new ConfiguracionResultadosDTO();
        }
        catch
        {
            configuracionResultados = new ConfiguracionResultadosDTO();
        }
    }

    private async Task AbrirMonitorAsync()
    {
        tabActiva = "monitor";
        cargandoMonitor = true;
        errorMonitor = null;
        try
        {
            var response = await Http.GetAsync($"/api/monitor/{EventId}");
            if (!response.IsSuccessStatusCode)
            {
                errorMonitor = NormalizarMensajeError(await response.Content.ReadAsStringAsync());
                if (string.IsNullOrWhiteSpace(errorMonitor))
                    errorMonitor = "El servidor no pudo devolver el monitor.";
                monitor = null;
                return;
            }

            monitor = await response.Content.ReadFromJsonAsync<MonitorVotacionDTO>();
            if (monitor == null)
                errorMonitor = "El monitor llegó vacío.";
        }
        catch (Exception ex)
        {
            monitor = null;
            errorMonitor = ex.Message;
        }
        finally
        {
            cargandoMonitor = false;
        }
    }

    private static string? NormalizarMensajeError(string? rawError)
    {
        if (string.IsNullOrWhiteSpace(rawError))
            return rawError;

        try
        {
            using var document = System.Text.Json.JsonDocument.Parse(rawError);
            if (document.RootElement.ValueKind != System.Text.Json.JsonValueKind.Object)
                return rawError;

            if (document.RootElement.TryGetProperty("detail", out var detail) &&
                detail.ValueKind == System.Text.Json.JsonValueKind.String)
                return detail.GetString();

            if (document.RootElement.TryGetProperty("title", out var title) &&
                title.ValueKind == System.Text.Json.JsonValueKind.String)
                return title.GetString();
        }
        catch
        {
        }

        return rawError;
    }

    private void AbrirConfiguracion()
    {
        mensajeConfiguracion = null;
        errorConfiguracion = false;
        mostrandoConfiguracion = true;
    }

    private void CerrarConfiguracion()
    {
        mostrandoConfiguracion = false;
        mensajeConfiguracion = null;
        errorConfiguracion = false;
    }

    private void AplicarAnulacionJurado()
    {
        configuracionResultados.PesoJurado = 0;
        configuracionResultados.PesoPublico = 100;
    }

    private void RestablecerPesos()
    {
        configuracionResultados.PesoJurado = 70;
        configuracionResultados.PesoPublico = 30;
    }

    private async Task GuardarConfiguracionAsync()
    {
        mensajeConfiguracion = null;
        errorConfiguracion = false;

        if (configuracionResultados.PesoJurado < 0 || configuracionResultados.PesoJurado > 100 ||
            configuracionResultados.PesoPublico < 0 || configuracionResultados.PesoPublico > 100)
        {
            mensajeConfiguracion = "Los pesos deben estar entre 0 y 100.";
            errorConfiguracion = true;
            return;
        }

        if (SumaPesosActual != 100)
        {
            mensajeConfiguracion = $"Los pesos deben sumar 100%. Ahora mismo suman {SumaPesosActual}%.";
            errorConfiguracion = true;
            return;
        }

        guardandoConfiguracion = true;
        try
        {
            var response = await Http.PutAsJsonAsync($"/api/votaciones/{EventId}/configuracion-resultados", configuracionResultados);
            if (!response.IsSuccessStatusCode)
            {
                mensajeConfiguracion = await response.Content.ReadAsStringAsync();
                if (string.IsNullOrWhiteSpace(mensajeConfiguracion))
                    mensajeConfiguracion = "No se pudo guardar la configuración.";
                errorConfiguracion = true;
                return;
            }

            var actualizada = await response.Content.ReadFromJsonAsync<ConfiguracionResultadosDTO>();
            if (actualizada != null)
                configuracionResultados = actualizada;

            mensajeConfiguracion = "Configuración actualizada correctamente.";
            errorConfiguracion = false;

            await CargarResultadosRealesAsync();
            if (tabActiva == "monitor")
                await AbrirMonitorAsync();
        }
        catch
        {
            mensajeConfiguracion = "Error de conexión al guardar la configuración.";
            errorConfiguracion = true;
        }
        finally
        {
            guardandoConfiguracion = false;
        }
    }

    private double GetVoteProgressPct(ProyectoMonitorDTO proyecto)
    {
        if (proyecto.TotalVotantesEsperados <= 0)
            return 0;

        return Math.Min(100, Math.Round(proyecto.NumVotos * 100d / proyecto.TotalVotantesEsperados, 2));
    }

    private static string GetVotanteBadgeClass(string tipo) => tipo switch
    {
        "Jurado" => "bg-[#B5D6AC] text-[#1A281B]",
        "Competidor" => "bg-amber-100 text-amber-700",
        _ => "bg-blue-100 text-blue-700"
