        3 => "from-orange-400 to-orange-600",
        _ => "from-[#6C8A6C] to-[#4C6B4F]"
    };

    private static readonly Dictionary<string, List<ProjectResult>> resultadosPorEvento = new()
    {
        ["1"] = new()
        {
            new ProjectResult { Id="1", Name="HealthAI", Team="MedTech", Category="Salud", TotalScore=8.7, Votes=45, Rank=1, Comments=new(){"Excelente IA", "Impacto real"}, CriteriaScores=new(){Innovation=9.2, Technical=8.5, Impact=9.0, Presentation=8.3, Design=8.2}},
