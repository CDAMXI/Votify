@page "/event-results/{EventId}"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using System.Linq
@using Votify.shared
@layout EmptyLayout
@inject NavigationManager NavigationManager
@inject HttpClient Http

<div class="min-h-screen bg-gradient-to-br from-[#E9EFE1] to-[#B5D6AC]">
    <header class="bg-white shadow-sm border-b border-[#B5D6AC]">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-4">
                    <a href="/dashboard" class="flex items-center text-[#6C8A6C] hover:bg-[#E9EFE1] px-4 py-2 rounded-md transition-colors text-sm">
                        <span class="mr-2">←</span> Volver
                    </a>
                    <img src="imagenes/logo-votify.png" alt="Votify" class="h-16 object-contain" />
                    <h1 class="text-xl font-bold text-[#1A281B]">Resultados - @nombreEvento</h1>
                </div>
            </div>
        </div>
    </header>

    <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        @if (PuedeGestionarResultados)
        {
            <div class="flex flex-wrap gap-2 mb-6">
                <button @onclick='() => tabActiva = "resultados"'
                        class="px-5 py-2 rounded-xl font-medium text-sm transition-all @(tabActiva == "resultados" ? "bg-gradient-to-r from-[#6C8A6C] to-[#4C6B4F] text-white shadow-md" : "bg-white text-[#6C8A6C] border border-[#B5D6AC] hover:bg-[#E9EFE1]")">
                    Resultados
                </button>
                <button @onclick="AbrirMonitorAsync"
                        class="px-5 py-2 rounded-xl font-medium text-sm transition-all @(tabActiva == "monitor" ? "bg-gradient-to-r from-[#6C8A6C] to-[#4C6B4F] text-white shadow-md" : "bg-white text-[#6C8A6C] border border-[#B5D6AC] hover:bg-[#E9EFE1]")">
                    Seguimiento
                </button>
            </div>
        }

        @if (PuedeGestionarResultados && tabActiva == "monitor")
        {
            @if (cargandoMonitor)
            {
                <div class="flex justify-center items-center py-24">
                    <div class="w-10 h-10 border-4 border-[#6C8A6C] border-t-transparent rounded-full animate-spin"></div>
                </div>
            }
            else if (monitor == null)
            {
                <div class="bg-white rounded-2xl shadow-lg p-8 text-center">
                    @if (!string.IsNullOrWhiteSpace(errorMonitor))
                    {
                        <p class="mb-3 text-sm text-red-600">@errorMonitor</p>
                    }
                    No se pudo cargar el monitor de votación.
                </div>
            }
            else
            {
                <div class="bg-white rounded-[2rem] shadow-xl border border-white/70 p-6 md:p-8 mb-8">
                    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
                        <div>
                            <h2 class="text-3xl font-bold text-[#1A281B]">Estado por proyecto</h2>
                            <p class="text-sm text-[#6C8A6C] mt-1">
                                Participación en tiempo real y resultado ajustado con la configuración actual.
                            </p>
                        </div>
                        <button @onclick="AbrirConfiguracion"
                                class="px-6 py-3 rounded-[1.25rem] bg-[#6C8A6C] hover:bg-[#4C6B4F] text-white font-bold shadow-md transition-colors">
                            Configuración
                        </button>
                    </div>

                    @if (monitor.PesoJurado == 0)
                    {
                        <div class="mb-5 rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-700">
                            El voto experto está suprimido en esta votación. El ranking actual solo usa voto popular.
                        </div>
                    }

                    <div class="space-y-4">
                        @foreach (var proyecto in monitor.Proyectos)
                        {
                            <div class="rounded-3xl border border-[#E9EFE1] bg-[#F9FBF7] px-5 py-5 shadow-sm">
                                <div class="flex items-start justify-between gap-4 mb-3">
                                    <div>
                                        <h3 class="text-2xl font-bold text-[#1A281B]">@proyecto.Nombre</h3>
                                        <p class="text-sm text-[#6C8A6C] mt-1">
                                            Ajustado @proyecto.Media.ToString("0.00")
                                            <span class="text-[#A6AAA9]">· Jurado @proyecto.MediaJurado.ToString("0.00") · Popular @proyecto.MediaPopular.ToString("0.00")</span>
                                        </p>
                                    </div>
                                    <div class="text-right">
                                        <p class="text-2xl font-bold text-[#4C6B4F]">
                                            @proyecto.NumVotos/@proyecto.TotalVotantesEsperados votos
                                        </p>
                                        <p class="text-xs text-[#A6AAA9]">
                                            @proyecto.NumVotosJurado expertos · @proyecto.NumVotosPopular populares
                                        </p>
                                    </div>
                                </div>

                                <div class="w-full h-4 rounded-full bg-white overflow-hidden border border-[#EEF3E8]">
                                    <div class="h-full rounded-full bg-gradient-to-r from-[#6C8A6C] to-[#70D939] transition-all duration-300"
                                         style="width:@GetVoteProgressPct(proyecto)%"></div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                    <div class="bg-white rounded-xl p-6 shadow-sm flex items-center gap-4">
                        <div class="w-12 h-12 rounded-full bg-gradient-to-br from-[#6C8A6C] to-[#70D939] flex items-center justify-center text-white text-xl">🗳️</div>
                        <div>
                            <p class="text-sm text-[#6C8A6C]">Votos emitidos</p>
                            <p class="text-2xl font-bold text-[#1A281B]">
                                @monitor.VotosEmitidos
                                @if (monitor.TotalVotantes > 0)
                                {
                                    <span class="text-sm font-normal text-[#A6AAA9]"> / @monitor.TotalVotantes votantes</span>
                                }
                            </p>
                        </div>
                    </div>
                    <div class="bg-white rounded-xl p-6 shadow-sm flex items-center gap-4">
                        <div class="w-12 h-12 rounded-full bg-gradient-to-br from-[#6C8A6C] to-[#70D939] flex items-center justify-center text-white text-xl">⚖️</div>
                        <div>
                            <p class="text-sm text-[#6C8A6C]">Pesos activos</p>
                            <p class="text-2xl font-bold text-[#1A281B]">@monitor.PesoJurado% / @monitor.PesoPublico%</p>
                            <p class="text-xs text-[#A6AAA9]">Experto / Popular</p>
                        </div>
                    </div>
                    <div class="bg-white rounded-xl p-6 shadow-sm flex items-center gap-4">
                        <div class="w-12 h-12 rounded-full bg-gradient-to-br from-[#6C8A6C] to-[#70D939] flex items-center justify-center text-white text-xl">📈</div>
                        <div>
                            <p class="text-sm text-[#6C8A6C]">Promedio ajustado</p>
                            <p class="text-2xl font-bold text-[#1A281B]">@monitor.PromedioGeneral <span class="text-sm font-normal text-[#A6AAA9]">/ 10</span></p>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
                    <div class="bg-white rounded-2xl shadow-lg p-6">
                        <h2 class="text-lg font-bold text-[#1A281B] mb-4">Clasificación provisional</h2>
                        @if (!monitor.Proyectos.Any())
                        {
                            <p class="text-[#A6AAA9] text-sm">Sin votos aún.</p>
                        }
                        else
                        {
                            <div class="space-y-3">
                                @for (var i = 0; i < monitor.Proyectos.Count; i++)
                                {
                                    var proy = monitor.Proyectos[i];
                                    var pct = (int)Math.Round(proy.Media * 10);
                                    <div>
                                        <div class="flex justify-between text-sm mb-1">
                                            <span class="font-medium text-[#1A281B]">#@(i + 1) @proy.Nombre</span>
                                            <span class="font-bold text-[#6C8A6C]">@proy.Media.ToString("0.00") <span class="text-[#A6AAA9] font-normal">(@proy.NumVotos v.)</span></span>
                                        </div>
                                        <div class="w-full bg-[#E9EFE1] rounded-full h-2">
                                            <div class="bg-gradient-to-r from-[#6C8A6C] to-[#70D939] h-2 rounded-full transition-all"
                                                 style="width:@pct%"></div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <div class="bg-white rounded-2xl shadow-lg p-6">
                        <h2 class="text-lg font-bold text-[#1A281B] mb-4">Estado de votantes</h2>
                        @if (!monitor.Votantes.Any())
                        {
                            <p class="text-[#A6AAA9] text-sm">No hay jurados ni público registrados.</p>
                        }
                        else
                        {
                            <div class="space-y-2 max-h-64 overflow-y-auto pr-1">
                                @foreach (var v in monitor.Votantes.OrderBy(v => v.HaVotado ? 1 : 0))
                                {
                                    <div class="flex items-center justify-between px-3 py-2 rounded-lg @(v.HaVotado ? "bg-[#E9EFE1]" : "bg-red-50")">
                                        <div class="flex items-center gap-2">
                                            <span class="text-xs px-2 py-0.5 rounded-full font-medium @(GetVotanteBadgeClass(v.Tipo))">
                                                @v.Tipo
                                            </span>
                                            <span class="text-sm font-medium text-[#1A281B]">@v.Nombre</span>
                                        </div>
                                        <span class="text-sm font-bold @(v.HaVotado ? "text-[#6C8A6C]" : "text-red-400")">
                                            @(v.HaVotado ? "Votó" : "Pendiente")
                                        </span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="bg-white rounded-2xl shadow-lg p-6">
                    <h2 class="text-lg font-bold text-[#1A281B] mb-4">Historial de votos</h2>
                    @if (!monitor.Historial.Any())
                    {
                        <p class="text-[#A6AAA9] text-sm">Sin votos registrados.</p>
                    }
                    else
                    {
                        <div class="overflow-x-auto">
                            <table class="w-full text-sm">
                                <thead>
                                    <tr class="text-left text-[#6C8A6C] border-b border-[#B5D6AC]">
                                        <th class="pb-2 pr-4">Fecha</th>
                                        <th class="pb-2 pr-4">Votante</th>
                                        <th class="pb-2 pr-4">Proyecto</th>
                                        <th class="pb-2 pr-4 text-right">Valor</th>
                                        <th class="pb-2">Comentario</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-[#E9EFE1]">
                                    @foreach (var h in monitor.Historial)
                                    {
                                        <tr class="hover:bg-[#F8FAF7]">
                                            <td class="py-2 pr-4 text-[#A6AAA9] whitespace-nowrap">@h.Fecha.ToString("dd/MM HH:mm")</td>
                                            <td class="py-2 pr-4 font-medium text-[#1A281B]">@h.Votante</td>
                                            <td class="py-2 pr-4 text-[#4C6B4F]">@h.Proyecto</td>
                                            <td class="py-2 pr-4 text-right font-bold text-[#6C8A6C]">@h.Valor.ToString("0.00")</td>
                                            <td class="py-2 text-[#A6AAA9] italic max-w-xs truncate">@(h.Comentario ?? "—")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            }
        }
        else if (Rol == "JURADO" || Rol == "ORGANIZADOR" || Rol == "ENCARGADO")
        {
            @if (PuedeGestionarResultados)
            {
                @if (cargandoResultados)
                {
                    <div class="flex justify-center items-center py-24">
                        <div class="w-10 h-10 border-4 border-[#6C8A6C] border-t-transparent rounded-full animate-spin"></div>
                    </div>
                }
                else if (!resultadosReales.Any())
                {
                    <div class="bg-white rounded-2xl shadow-lg p-8 text-center text-[#A6AAA9]">
                        <p class="text-4xl mb-3">📭</p>
                        <p class="text-lg font-medium">No hay proyectos registrados en este evento.</p>
                    </div>
                }
                else
                {
                    var promedio = resultadosReales.Where(r => r.NumVotos > 0).Any()
                        ? Math.Round(resultadosReales.Where(r => r.NumVotos > 0).Average(r => r.Media), 2)
                        : 0.0;

                    <div class="bg-white rounded-2xl shadow-lg p-6 mb-8 border border-[#E9EFE1]">
                        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3">
                            <div>
                                <h2 class="text-xl font-bold text-[#1A281B]">Configuración de resultados</h2>
                                <p class="text-sm text-[#6C8A6C] mt-1">
                                    Experto @configuracionResultados.PesoJurado% · Popular @configuracionResultados.PesoPublico%
                                </p>
                            </div>
                            <button @onclick="AbrirConfiguracion"
                                    class="px-5 py-2 rounded-xl bg-[#6C8A6C] hover:bg-[#4C6B4F] text-white font-semibold transition-colors">
                                Ajustar
                            </button>
                        </div>
                        @if (configuracionResultados.PesoJurado == 0)
                        {
                            <p class="mt-3 text-sm text-amber-700 bg-amber-50 border border-amber-200 rounded-xl px-4 py-3">
                                El voto experto está anulado. El ranking se corrige usando solo voto popular.
                            </p>
                        }
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                        <div class="bg-white rounded-xl p-6 shadow-sm flex items-center gap-4">
                            <div class="w-12 h-12 rounded-full bg-gradient-to-br from-[#6C8A6C] to-[#70D939] flex items-center justify-center text-white font-bold">🏆</div>
                            <div>
                                <p class="text-sm text-[#6C8A6C]">Proyectos</p>
                                <p class="text-2xl font-bold text-[#1A281B]">@resultadosReales.Count</p>
                            </div>
                        </div>
                        <div class="bg-white rounded-xl p-6 shadow-sm flex items-center gap-4">
                            <div class="w-12 h-12 rounded-full bg-gradient-to-br from-[#6C8A6C] to-[#70D939] flex items-center justify-center text-white font-bold">🗳️</div>
                            <div>
                                <p class="text-sm text-[#6C8A6C]">Votos totales</p>
                                <p class="text-2xl font-bold text-[#1A281B]">@resultadosReales.Sum(r => r.NumVotos)</p>
                            </div>
                        </div>
                        <div class="bg-white rounded-xl p-6 shadow-sm flex items-center gap-4">
                            <div class="w-12 h-12 rounded-full bg-gradient-to-br from-[#6C8A6C] to-[#70D939] flex items-center justify-center text-white font-bold">📈</div>
                            <div>
                                <p class="text-sm text-[#6C8A6C]">Promedio ajustado</p>
                                <p class="text-2xl font-bold text-[#1A281B]">@promedio</p>
                            </div>
                        </div>
                    </div>

                    @if (resultadosReales.Count >= 3)
                    {
                        <div class="bg-white rounded-2xl shadow-xl p-8 mb-8">
                            <h2 class="text-2xl font-bold text-[#1A281B] mb-6">Proyectos ganadores</h2>
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                                @foreach (var proyecto in resultadosReales.Take(3))
                                {
                                    <div class="relative @(proyecto.Rank == 1 ? "md:order-2" : proyecto.Rank == 2 ? "md:order-1" : "md:order-3")">
                                        <div class="rounded-xl p-6 bg-gradient-to-br @GetRankColor(proyecto.Rank) text-white shadow-lg">
                                            <div class="flex justify-between items-start mb-4">
                                                <div class="text-2xl">@(proyecto.Rank == 1 ? "🥇" : proyecto.Rank == 2 ? "🥈" : "🥉")</div>
                                                <div class="text-4xl font-black">#@proyecto.Rank</div>
                                            </div>
                                            <h3 class="text-xl font-bold mb-1">@proyecto.Nombre</h3>
                                            @if (!string.IsNullOrEmpty(proyecto.Competidor))
                                            {
                                                <p class="text-sm opacity-90 mb-3">@proyecto.Competidor</p>
                                            }
                                            <div class="flex items-center justify-between pt-4 border-t border-white/20 font-bold">
                                                <span class="text-sm">Puntuación ajustada</span>
                                                <span class="text-2xl">@proyecto.Media.ToString("0.00")</span>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <div class="space-y-4">
                        <h2 class="text-2xl font-bold text-[#1A281B] mb-4">Ranking completo</h2>
                        @foreach (var proyecto in resultadosReales)
                        {
                            <div class="bg-white rounded-xl p-6 hover:shadow-lg transition-shadow border border-[#B5D6AC]/30">
                                <div class="flex flex-col lg:flex-row lg:items-center gap-5">
                                    <div class="flex items-center gap-5 flex-1">
                                        <div class="w-14 h-14 rounded-full bg-gradient-to-br @GetRankColor(proyecto.Rank) flex items-center justify-center text-white flex-shrink-0 font-bold text-xl shadow-md">
                                            #@proyecto.Rank
                                        </div>
                                        <div class="flex-1">
                                            <h3 class="text-xl font-bold text-[#1A281B]">@proyecto.Nombre</h3>
                                            @if (!string.IsNullOrEmpty(proyecto.Competidor))
                                            {
                                                <p class="text-sm text-[#6C8A6C]">@proyecto.Competidor</p>
                                            }
                                            @if (!string.IsNullOrEmpty(proyecto.Descripcion))
                                            {
                                                <p class="text-sm text-[#A6AAA9] mt-1 line-clamp-2">@proyecto.Descripcion</p>
                                            }
                                            <p class="text-xs text-[#A6AAA9] mt-2">
                                                Jurado @proyecto.MediaJurado.ToString("0.00") (@proyecto.NumVotosJurado) ·
                                                Popular @proyecto.MediaPopular.ToString("0.00") (@proyecto.NumVotosPopular) ·
                                                Bruta @proyecto.MediaBruta.ToString("0.00")
                                            </p>
                                        </div>
                                    </div>
                                    <div class="text-right flex-shrink-0">
                                        <div class="text-4xl font-black text-[#6C8A6C]">@proyecto.Media.ToString("0.00")</div>
                                        <div class="text-sm text-[#A6AAA9]">@proyecto.NumVotos votos</div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                    @foreach (var project in mockResults.Take(3))
                    {
                        <div class="bg-white rounded-xl p-6 hover:shadow-lg transition-shadow border border-[#B5D6AC]/30 flex items-center gap-4">
                            <div class="w-14 h-14 rounded-full bg-gradient-to-br @GetRankColor(project.Rank) flex items-center justify-center text-white font-bold text-xl shadow-md">#@project.Rank</div>
                            <div>
                                <h3 class="font-bold text-[#1A281B]">@project.Name</h3>
                                <p class="text-[#6C8A6C] text-sm">@project.Team</p>
                                <p class="text-2xl font-black text-[#6C8A6C]">@project.TotalScore</p>
                            </div>
                        </div>
                    }
                </div>
                <div class="space-y-4">
                    @foreach (var project in mockResults)
                    {
                        <div class="bg-white rounded-xl p-6 hover:shadow-lg transition-shadow border border-[#B5D6AC]/30">
                            <div class="flex items-center gap-6">
                                <div class="w-14 h-14 rounded-full bg-gradient-to-br @GetRankColor(project.Rank) flex items-center justify-center text-white font-bold text-xl shadow-md">#@project.Rank</div>
                                <div class="flex-1">
                                    <h3 class="text-xl font-bold text-[#1A281B]">@project.Name</h3>
                                    <p class="text-[#6C8A6C]">@project.Team · @project.Category</p>
                                </div>
                                <div class="text-4xl font-black text-[#6C8A6C]">@project.TotalScore</div>
                            </div>
                        </div>
                    }
                </div>
            }
        }
        else if (Rol == "PUBLICO")
        {
            <div class="bg-white rounded-2xl shadow-xl p-8 mb-8">
                <h2 class="text-2xl font-bold text-[#1A281B] mb-6">Clasificación final</h2>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                    @foreach (var project in mockResults.Take(3))
                    {
                        <div class="relative @(project.Rank == 1 ? "md:order-2" : project.Rank == 2 ? "md:order-1" : "md:order-3")">
                            <div class="rounded-xl p-6 bg-gradient-to-br @GetRankColor(project.Rank) text-white shadow-lg text-center">
                                <div class="text-4xl mb-2">@(project.Rank == 1 ? "🥇" : project.Rank == 2 ? "🥈" : "🥉")</div>
                                <h3 class="text-xl font-bold mb-1">@project.Name</h3>
                                <p class="text-sm opacity-90 mb-4">@project.Team</p>
                                <div class="text-3xl font-black">@project.TotalScore</div>
                                <div class="text-xs opacity-75 mt-1">puntos</div>
                            </div>
                        </div>
                    }
                </div>
                <h3 class="text-lg font-bold text-[#1A281B] mb-4">Ranking completo</h3>
                <div class="space-y-3">
                    @foreach (var project in mockResults)
                    {
                        <div class="flex items-center gap-4 p-4 bg-[#F8FAF7] rounded-xl border border-[#B5D6AC]/30">
                            <div class="w-10 h-10 rounded-full bg-gradient-to-br @GetRankColor(project.Rank) flex items-center justify-center text-white font-bold text-sm flex-shrink-0">
                                #@project.Rank
                            </div>
                            <div class="flex-1">
                                <p class="font-bold text-[#1A281B]">@project.Name</p>
                                <p class="text-sm text-[#6C8A6C]">@project.Team · @project.Category</p>
                            </div>
                            <div class="text-2xl font-black text-[#6C8A6C]">@project.TotalScore</div>
                        </div>
                    }
                </div>
            </div>
        }
        else if (Rol == "COMPETIDOR")
        {
            var myProject = mockResults[0];

            <div class="bg-white rounded-2xl shadow-xl p-8 mb-6">
                <div class="flex items-center justify-between mb-6">
                    <div>
                        <h2 class="text-3xl font-bold text-[#1A281B]">@myProject.Name</h2>
                        <p class="text-[#6C8A6C]">@myProject.Team</p>
                        <span class="inline-block px-3 py-1 bg-[#E9EFE1] text-[#4C6B4F] rounded-full text-xs font-bold mt-2">@myProject.Category</span>
                    </div>
                    <div class="text-right">
                        <div class="text-sm text-[#6C8A6C] mb-1">Tu puntuación</div>
                        <div class="text-5xl font-black text-[#6C8A6C]">@myProject.TotalScore</div>
                        <div class="text-sm text-[#A6AAA9]">/10</div>
