@page "/perfil"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@layout EmptyLayout
@using Votify.shared
@inject NavigationManager NavigationManager
@inject HttpClient Http
@inject IJSRuntime JS

<div class="min-h-screen bg-gradient-to-br from-[#E9EFE1] to-[#B5D6AC]">
    <header class="bg-white shadow-sm border-b border-[#B5D6AC]">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 grid grid-cols-3 items-center">
            <div></div>
            <div class="flex items-center justify-center gap-4">
                <img src="imagenes/logo-votify.png" alt="Votify" class="h-16 object-contain" />
                <h1 class="text-3xl font-bold text-[#1A281B]">Mi Perfil</h1>
            </div>
            <div></div>
        </div>
    </header>

    <main class="max-w-2xl mx-auto px-4 py-10 space-y-6">

        @if (cargando)
        {
            <div class="flex justify-center items-center py-24">
                <div class="w-10 h-10 border-4 border-[#6C8A6C] border-t-transparent rounded-full animate-spin"></div>
            </div>
        }
        else
        {
            <!-- Foto de perfil -->
            <div class="bg-white rounded-2xl shadow-xl p-8 flex flex-col items-center gap-4">
                <div class="w-28 h-28 rounded-full bg-gradient-to-br from-[#E9EFE1] to-[#B5D6AC] overflow-hidden border-4 border-[#6C8A6C] flex items-center justify-center">
                    @if (!string.IsNullOrEmpty(fotoPreview))
                    {
                        <img src="@fotoPreview" class="w-full h-full object-cover" alt="Foto de perfil" />
                    }
                    else
                    {
                        <span class="text-4xl text-[#6C8A6C] font-bold">@(username?.Length > 0 ? username[0].ToString().ToUpper() : "?")</span>
                    }
                </div>
                <p class="text-xl font-bold text-[#1A281B]">@username</p>
                <div class="flex gap-2">
                    <label class="cursor-pointer bg-[#E9EFE1] hover:bg-[#B5D6AC] text-[#4C6B4F] px-4 py-2 rounded-xl text-sm font-medium transition-colors">
                        Cambiar foto
                        <InputFile OnChange="HandleFotoChange" accept="image/*" class="hidden" />
                    </label>
                    @if (!string.IsNullOrEmpty(fotoPreview))
                    {
                        <button @onclick="QuitarFoto"
                                class="bg-red-50 hover:bg-red-100 text-red-500 px-4 py-2 rounded-xl text-sm font-medium transition-colors">
                            Quitar foto
                        </button>
                    }
                </div>
                @if (!string.IsNullOrEmpty(fotoMsg))
                {
                    <p class="text-sm @(fotoError ? "text-red-500" : "text-[#6C8A6C]")">@fotoMsg</p>
                }
            </div>

            <!-- Cambiar email -->
            <div class="bg-white rounded-2xl shadow-xl p-8 space-y-4">
                <h2 class="text-lg font-bold text-[#1A281B] flex items-center gap-2">
                    <Icon Name="mail" CssClass="w-5 h-5 text-[#6C8A6C]" />
                    Correo electrónico
                </h2>
                <p class="text-sm text-[#6C8A6C]">Actual: <span class="font-medium text-[#1A281B]">@email</span></p>
                <div class="space-y-1">
                    <label class="text-sm font-medium text-[#4C6B4F]">Nuevo correo electrónico</label>
                    <input @bind="nuevoEmail" type="email" placeholder="Nuevo correo electrónico"
                           class="w-full h-10 px-3 py-2 text-sm bg-[#E9EFE1] border border-[#B5D6AC] rounded-md focus:outline-none focus:border-[#6C8A6C]" />
                </div>
                @if (!string.IsNullOrEmpty(emailMsg))
                {
                    <p class="text-sm @(emailError ? "text-red-500" : "text-[#6C8A6C]")">@emailMsg</p>
                }
                <button @onclick="GuardarEmail" disabled="@guardandoEmail"
                        class="bg-gradient-to-r from-[#6C8A6C] to-[#4C6B4F] text-white px-6 py-2 rounded-xl font-medium hover:opacity-90 transition-opacity disabled:opacity-60">
                    @(guardandoEmail ? "Guardando..." : "Guardar email")
                </button>
            </div>

            <!-- Cambiar contraseña -->
            <div class="bg-white rounded-2xl shadow-xl p-8 space-y-4">
                <h2 class="text-lg font-bold text-[#1A281B] flex items-center gap-2">
                    <Icon Name="lock" CssClass="w-5 h-5 text-[#6C8A6C]" />
                    Contraseña
                </h2>
                <div class="space-y-1">
                    <label class="text-sm font-medium text-[#4C6B4F]">Contraseña actual</label>
                    <input @bind="passwordActual" type="password" placeholder="Contraseña actual"
                           class="w-full h-10 px-3 py-2 text-sm bg-[#E9EFE1] border border-[#B5D6AC] rounded-md focus:outline-none focus:border-[#6C8A6C]" />
                </div>
                <div class="space-y-1">
                    <label class="text-sm font-medium text-[#4C6B4F]">Nueva contraseña</label>
                    <input @bind="nuevaPassword" type="password" placeholder="Nueva contraseña"
                           class="w-full h-10 px-3 py-2 text-sm bg-[#E9EFE1] border border-[#B5D6AC] rounded-md focus:outline-none focus:border-[#6C8A6C]" />
                </div>
                <div class="space-y-1">
                    <label class="text-sm font-medium text-[#4C6B4F]">Confirmar nueva contraseña</label>
                    <input @bind="confirmarPassword" type="password" placeholder="Confirmar nueva contraseña"
                           class="w-full h-10 px-3 py-2 text-sm bg-[#E9EFE1] border border-[#B5D6AC] rounded-md focus:outline-none focus:border-[#6C8A6C]" />
                </div>
                @if (!string.IsNullOrEmpty(passwordMsg))
                {
                    <p class="text-sm @(passwordError ? "text-red-500" : "text-[#6C8A6C]")">@passwordMsg</p>
                }
                <div class="flex items-center justify-between">
                    <button @onclick="GuardarPassword" disabled="@guardandoPassword"
                            class="bg-gradient-to-r from-[#6C8A6C] to-[#4C6B4F] text-white px-6 py-2 rounded-xl font-medium hover:opacity-90 transition-opacity disabled:opacity-60">
                        @(guardandoPassword ? "Guardando..." : "Cambiar contraseña")
                    </button>
                    <button @onclick="IrARecuperarPassword" class="text-sm text-[#6C8A6C] hover:text-[#70D939] transition-colors bg-transparent border-none p-0 cursor-pointer">
                        ¿Olvidaste tu contraseña?
                    </button>
                </div>
            </div>

            <!-- Estadísticas -->
            <div class="bg-white rounded-2xl shadow-xl p-8 space-y-4">
                <h2 class="text-lg font-bold text-[#1A281B] flex items-center gap-2">
                    <Icon Name="chart-bar" CssClass="w-5 h-5 text-[#6C8A6C]" />
                    Estadísticas
                </h2>
                @if (cargandoHistorial)
                {
                    <div class="flex justify-center py-4">
                        <div class="w-6 h-6 border-4 border-[#6C8A6C] border-t-transparent rounded-full animate-spin"></div>
                    </div>
                }
                else if (historial != null)
                {
                    <div class="grid grid-cols-2 gap-4">
                        <div class="bg-gradient-to-br from-[#E9EFE1] to-[#B5D6AC] rounded-xl p-4">
                            <p class="text-sm text-[#4C6B4F] flex items-center gap-2">
                                <Icon Name="trophy" CssClass="w-4 h-4 text-[#4C6B4F]" />
                                Eventos Participados
                            </p>
                            <p class="text-3xl font-bold text-[#1A281B]">@historial.EventosParticipados</p>
                        </div>
                        <div class="bg-gradient-to-br from-[#E9EFE1] to-[#B5D6AC] rounded-xl p-4">
                            <p class="text-sm text-[#4C6B4F] flex items-center gap-2">
                                <Icon Name="check-circle" CssClass="w-4 h-4 text-[#4C6B4F]" />
                                Votos Emitidos
                            </p>
                            <p class="text-3xl font-bold text-[#1A281B]">@historial.VotosEmitidos</p>
                        </div>
                    </div>
                }
            </div>

            <!-- Historial de Eventos -->
            <div class="bg-white rounded-2xl shadow-xl p-8 space-y-4">
                <h2 class="text-lg font-bold text-[#1A281B] flex items-center gap-2">
                    <Icon Name="calendar" CssClass="w-5 h-5 text-[#6C8A6C]" />
                    Historial de Eventos
                </h2>
                @if (cargandoHistorial)
                {
                    <div class="flex justify-center py-6">
                        <div class="w-8 h-8 border-4 border-[#6C8A6C] border-t-transparent rounded-full animate-spin"></div>
                    </div>
                }
                else if (historial == null || !historial.Eventos.Any())
                {
                    <p class="text-sm text-[#6C8A6C]">Aún no has participado en ningún evento.</p>
                }
                else
                {
                    <div class="space-y-3">
                        @foreach (var ev in historial.Eventos)
                        {
                            <div class="border border-[#B5D6AC] rounded-xl p-4 flex items-start justify-between gap-4">
                                <div class="flex-1 min-w-0">
                                    <p class="font-bold text-[#1A281B]">@ev.Nombre</p>
                                    <p class="text-sm text-[#6C8A6C]">📅 @FormatearRangoFechas(ev.FechaIni, ev.FechaFin)</p>
                                    <p class="text-sm text-[#4C6B4F] mt-1">@DescribirParticipacion(ev)</p>
                                </div>
                                @if (ev.Voto)
                                {
                                    <button @onclick="() => AbrirReclamacion(ev)"
                                            disabled="@ev.YaReclamado"
                                            class="@(ev.YaReclamado
                                                ? "bg-[#E9EFE1] text-[#A6AAA9] cursor-not-allowed"
                                                : "bg-white border border-[#6C8A6C] text-[#4C6B4F] hover:bg-[#E9EFE1]")
                                                px-3 py-2 rounded-lg text-sm font-medium transition-colors flex items-center gap-1 shrink-0">
                                        <span>⚠</span>
                                        <span>@(ev.YaReclamado ? "Reclamado" : "Reclamar")</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </main>

    @if (eventoReclamando != null)
    {
        <div class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 px-4">
            <div class="bg-white rounded-2xl p-6 max-w-md w-full">
                <div class="flex justify-between items-start mb-4">
                    <h3 class="text-lg font-bold text-[#1A281B]">Reclamación de Resultados</h3>
                    <button @onclick="CerrarReclamacion" class="text-[#6C8A6C] hover:text-[#1A281B]">✕</button>
                </div>

                <div class="bg-[#E9EFE1] border border-[#B5D6AC] rounded-xl p-4 mb-4">
                    <p class="text-sm text-[#4C6B4F]">Evento:</p>
                    <p class="font-bold text-[#1A281B]">@eventoReclamando.Nombre</p>
                    <p class="text-sm text-[#6C8A6C]">@FormatearRangoFechas(eventoReclamando.FechaIni, eventoReclamando.FechaFin)</p>
                </div>

                <label class="text-sm font-bold text-[#1A281B] flex items-center gap-1 mb-2">
                    💬 Descripción del Problema
                </label>
                <textarea @bind="descripcionReclamacion" rows="5"
                          placeholder="Describe el problema con los resultados del evento..."
                          class="w-full px-3 py-2 text-sm bg-[#E9EFE1] border border-[#B5D6AC] rounded-md focus:outline-none focus:border-[#6C8A6C] resize-none"></textarea>

                @if (!string.IsNullOrEmpty(errorReclamacion))
                {
                    <p class="text-sm text-red-500 mt-2">@errorReclamacion</p>
                }

                <div class="mt-5 flex gap-2">
                    <button @onclick="EnviarReclamacion" disabled="@enviandoReclamacion"
                            class="flex-1 bg-gradient-to-r from-[#6C8A6C] to-[#4C6B4F] text-white px-6 py-2 rounded-xl font-medium hover:opacity-90 transition-opacity disabled:opacity-60">
                        @(enviandoReclamacion ? "Enviando..." : "Enviar Reclamación")
                    </button>
                    <button @onclick="CerrarReclamacion" disabled="@enviandoReclamacion"
                            class="px-6 py-2 border border-[#B5D6AC] rounded-xl font-medium text-[#4C6B4F] hover:bg-[#E9EFE1] disabled:opacity-60">
                        Cancelar
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool cargando = true;
    private string? username;
    private string? email;
    private string? fotoPreview;

    private string nuevoEmail = string.Empty;
    private string emailMsg = string.Empty;
    private bool emailError = false;
    private bool guardandoEmail = false;

    private string passwordActual = string.Empty;
    private string nuevaPassword = string.Empty;
    private string confirmarPassword = string.Empty;
    private string passwordMsg = string.Empty;
    private bool passwordError = false;
    private bool guardandoPassword = false;

    private string fotoMsg = string.Empty;
    private bool fotoError = false;

    private HistorialEventosDTO? historial;
    private bool cargandoHistorial = true;

    private EventoHistorialItemDTO? eventoReclamando;
    private string descripcionReclamacion = string.Empty;
    private string errorReclamacion = string.Empty;
    private bool enviandoReclamacion = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var res = await Http.GetFromJsonAsync<PerfilDTO>("/api/perfil");
            if (res != null)
            {
                username = res.Username;
                email = res.Email;
                fotoPreview = res.FotoPerfil;
            }
        }
        catch
        {
            NavigationManager.NavigateTo("/login");
            return;
        }
        finally
        {
            cargando = false;
        }

        await CargarHistorial();
    }

    private async Task CargarHistorial()
    {
        cargandoHistorial = true;
        try
        {
            historial = await Http.GetFromJsonAsync<HistorialEventosDTO>("/api/perfil/historial");
        }
        catch
        {
            historial = null;
        }
        finally
        {
            cargandoHistorial = false;
        }
    }

    private void AbrirReclamacion(EventoHistorialItemDTO ev)
    {
        if (ev.YaReclamado) return;
        eventoReclamando = ev;
        descripcionReclamacion = string.Empty;
        errorReclamacion = string.Empty;
    }

    private void CerrarReclamacion()
    {
        eventoReclamando = null;
        descripcionReclamacion = string.Empty;
        errorReclamacion = string.Empty;
    }

    private async Task EnviarReclamacion()
    {
        if (eventoReclamando == null) return;
        if (string.IsNullOrWhiteSpace(descripcionReclamacion))
        {
            errorReclamacion = "Describe el problema antes de enviar.";
            return;
        }

        enviandoReclamacion = true;
        errorReclamacion = string.Empty;
        try
        {
            var res = await Http.PostAsJsonAsync("/api/reclamaciones", new CrearReclamacionRequest
            {
                EventoId = eventoReclamando.IdEvento,
                Descripcion = descripcionReclamacion
            });
            if (res.IsSuccessStatusCode)
            {
                eventoReclamando.YaReclamado = true;
                eventoReclamando.EstadoReclamacion = "PENDIENTE";
                CerrarReclamacion();
            }
            else
            {
                errorReclamacion = await res.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            errorReclamacion = $"Error al enviar: {ex.Message}";
        }
        finally
        {
            enviandoReclamacion = false;
        }
    }

    private static string FormatearRangoFechas(DateTime ini, DateTime fin)
    {
        var meses = new[] { "Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre" };
        if (ini.Year == fin.Year && ini.Month == fin.Month)
            return $"{ini.Day}-{fin.Day} {meses[ini.Month - 1]} {ini.Year}";
        return $"{ini:dd/MM/yyyy} - {fin:dd/MM/yyyy}";
    }

    private static string DescribirParticipacion(EventoHistorialItemDTO ev)
    {
        if (!ev.Voto && string.IsNullOrEmpty(ev.ProyectoDestacado))
            return "No votaste en este evento";
        if (!string.IsNullOrEmpty(ev.ProyectoDestacado) && ev.PosicionProyecto.HasValue)
            return $"Proyecto \"{ev.ProyectoDestacado}\" - {Ordinal(ev.PosicionProyecto.Value)} lugar";
        if (!string.IsNullOrEmpty(ev.ProyectoDestacado))
            return $"Proyecto \"{ev.ProyectoDestacado}\"";
        return "Participaste votando";
    }

    private static string Ordinal(int n) => n switch
    {
        1 => "1er",
        2 => "2do",
        3 => "3er",
        _ => $"{n}to"
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Cuando esta pestaña recupera el foco (ej: se cerró la pestaña del reset),
            // verificar si la sesión sigue activa. Si no, mandar al login.
            await JS.InvokeVoidAsync("eval", """
                document.addEventListener('visibilitychange', async function() {
                    if (!document.hidden) {
                        try {
                            const res = await fetch('/api/perfil');
                            if (res.status === 401) window.location.href = '/login';
                        } catch {}
                    }
                });
            """);
        }
    }

    private async Task GuardarEmail()
    {
        if (string.IsNullOrWhiteSpace(nuevoEmail)) { emailMsg = "Introduce un email válido."; emailError = true; return; }
        guardandoEmail = true; emailMsg = string.Empty;
        var res = await Http.PutAsJsonAsync("/api/perfil/email", new { NuevoEmail = nuevoEmail });
        if (res.IsSuccessStatusCode) { email = nuevoEmail; nuevoEmail = string.Empty; emailMsg = "Email actualizado."; emailError = false; }
        else { emailMsg = await res.Content.ReadAsStringAsync(); emailError = true; }
        guardandoEmail = false;
    }

    private async Task GuardarPassword()
    {
        if (nuevaPassword != confirmarPassword) { passwordMsg = "Las contraseñas no coinciden."; passwordError = true; return; }
        if (string.IsNullOrWhiteSpace(nuevaPassword)) { passwordMsg = "Introduce una contraseña válida."; passwordError = true; return; }
        guardandoPassword = true; passwordMsg = string.Empty;
        var res = await Http.PutAsJsonAsync("/api/perfil/password", new { PasswordActual = passwordActual, NuevaPassword = nuevaPassword });
        if (res.IsSuccessStatusCode)
        {
            await Http.PostAsync("/api/auth/logout", null);
            NavigationManager.NavigateTo("/login", forceLoad: true);
        }
        else { passwordMsg = await res.Content.ReadAsStringAsync(); passwordError = true; }
        guardandoPassword = false;
    }

    private void IrARecuperarPassword()
    {
        NavigationManager.NavigateTo("/recuperar-password?returnUrl=/perfil");
    }

    private async Task QuitarFoto()
    {
        fotoMsg = string.Empty;
        var res = await Http.PutAsJsonAsync("/api/perfil/foto", new { Base64Foto = "" });
        if (res.IsSuccessStatusCode) { fotoPreview = null; fotoMsg = "Foto eliminada."; fotoError = false; }
        else { fotoMsg = "Error al eliminar la foto."; fotoError = true; }
    }

    private async Task HandleFotoChange(InputFileChangeEventArgs e)
    {
        fotoMsg = string.Empty;
        try
        {
            var file = e.File;
            var resized = await file.RequestImageFileAsync("image/jpeg", 300, 300);
            var buffer = new byte[resized.Size];
            await resized.OpenReadStream(maxAllowedSize: 1024 * 1024).ReadAsync(buffer);
            var base64 = $"data:image/jpeg;base64,{Convert.ToBase64String(buffer)}";
            var res = await Http.PutAsJsonAsync("/api/perfil/foto", new { Base64Foto = base64 });
            if (res.IsSuccessStatusCode) { fotoPreview = base64; fotoMsg = "Foto actualizada."; fotoError = false; }
            else { fotoMsg = "Error al subir la foto."; fotoError = true; }
        }
        catch { fotoMsg = "Error al procesar la imagen."; fotoError = true; }
    }

    private class PerfilDTO
    {
        public string Username { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string? FotoPerfil { get; set; }
    }
}
