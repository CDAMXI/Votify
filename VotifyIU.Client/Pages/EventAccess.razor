    private string GetCodigoRol(string tipoRol)
        => codigosRol.TryGetValue(tipoRol, out var codigo) ? codigo : string.Empty;

    private void SetCodigoRol(string tipoRol, string value)
        => codigosRol[tipoRol] = value;

    private void IrADestino(int idVotacion)
    {
        var destino = string.Equals(Dest, "results", StringComparison.OrdinalIgnoreCase)
            ? "event-results"
            : "event-voting";

        NavigationManager.NavigateTo($"/{destino}/{idVotacion}?rol={Uri.EscapeDataString(rolActual ?? string.Empty)}");
    }

    private bool PuedeMostrarBotonVotarParticipante(VotacionDTO votacion)
    {
        if (!string.Equals(rolActual, "COMPETIDOR", StringComparison.OrdinalIgnoreCase))
            return false;

        return votacion.NombreEstado == "Activa" && votacion.FechaFin > DateTime.Now;
    }

    private void IrAVotarComoParticipante(int idVotacion)
    {
        NavigationManager.NavigateTo($"/event-voting/{idVotacion}?rol=COMPETIDOR&modo=votar");
    }

