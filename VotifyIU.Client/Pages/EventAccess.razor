@page "/event-access/{EventId}"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using Votify.shared
@layout EmptyLayout
@inject NavigationManager NavigationManager
@inject HttpClient Http

<div class="min-h-screen bg-gradient-to-br from-[#E9EFE1] to-[#B5D6AC]">
    <header class="bg-white shadow-sm border-b border-[#B5D6AC]">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
            <div class="flex items-center justify-center">
                <img src="imagenes/logo-votify.png" alt="Votify" class="h-16 object-contain" />
            </div>
        </div>
    </header>

    <main class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        @if (cargando)
        {
            <div class="bg-white rounded-2xl shadow-xl p-10 text-center">
                <p class="text-xl font-bold text-[#1A281B] mb-2">Preparando acceso al evento</p>
                <p class="text-[#6C8A6C]">Estamos comprobando si ya tienes un rol asignado.</p>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="bg-white rounded-2xl shadow-xl p-10 text-center">
                <p class="text-xl font-bold text-[#1A281B] mb-2">No se pudo acceder al evento</p>
                <p class="text-[#6C8A6C] mb-6">@error</p>
                <div class="flex justify-center gap-3">
                    <button @onclick="CargarEstado"
                            class="bg-gradient-to-r from-[#6C8A6C] to-[#4C6B4F] text-white px-6 py-3 rounded-xl font-bold hover:opacity-90 transition-opacity">
                        Reintentar
                    </button>
                    <a href="/dashboard"
                       class="border-2 border-[#6C8A6C] text-[#6C8A6C] px-6 py-3 rounded-xl font-bold hover:bg-[#E9EFE1] transition-colors">
                        Volver
                    </a>
                </div>
            </div>
        }
        else
        {
            @if (string.IsNullOrWhiteSpace(rolActual))
            {
                <div class="bg-white rounded-2xl shadow-xl p-10">
                    <p class="text-sm font-bold uppercase tracking-wide text-[#6C8A6C] mb-3">Acceso al evento</p>
                    <h1 class="text-3xl font-bold text-[#1A281B] mb-3">@TituloEvento</h1>
                    <p class="text-[#4C6B4F] mb-8">
                        Elige cómo quieres participar en este evento. Este rol se guardará solo para este evento, así que puedes ser competidor en uno y jurado o público en otro.
                    </p>

                    <div class="grid gap-4 md:grid-cols-3">
                        @foreach (var opcion in opcionesRol)
                        {
                            <div class="rounded-2xl border border-[#B5D6AC] bg-[#F8FAF7] p-6 flex flex-col">
                                <div class="flex items-start justify-between mb-3">
                                    <div class="w-12 h-12 rounded-xl bg-[#6C8A6C]/15 flex items-center justify-center text-[#4C6B4F]">
                                        <Icon Name="@IconoParaRol(opcion.Tipo)" CssClass="w-6 h-6" />
                                    </div>
                                    @if (RolRequiereCodigo(opcion.Tipo))
                                    {
                                        <Icon Name="lock" CssClass="w-4 h-4 text-[#A6AAA9]" />
                                    }
                                </div>
                                <p class="text-lg font-bold text-[#1A281B] mb-2">@opcion.Titulo</p>
                                <p class="text-sm text-[#6C8A6C] mb-3">@opcion.Descripcion</p>

                                <div class="mt-auto">
                                    @if (RolRequiereCodigo(opcion.Tipo))
                                    {
                                        <input value="@GetCodigoRol(opcion.Tipo)"
                                               @oninput="e => SetCodigoRol(opcion.Tipo, e.Value?.ToString() ?? string.Empty)"
                                               placeholder="Código de acceso"
                                               disabled="@asignando"
                                               class="w-full h-10 rounded-md border bg-white border-[#B5D6AC] px-3 text-sm font-mono focus:outline-none focus:border-[#6C8A6C] focus:ring-1 focus:ring-[#6C8A6C] mb-2" />
                                        <button @onclick="() => SeleccionarRol(opcion.Tipo, GetCodigoRol(opcion.Tipo))"
                                                disabled="@asignando"
                                                class="w-full rounded-xl bg-gradient-to-r from-[#6C8A6C] to-[#4C6B4F] text-white py-2 font-semibold hover:opacity-90 transition-opacity disabled:opacity-60">
                                            Entrar
                                        </button>
                                    }
                                    else
                                    {
                                        <button @onclick="() => SeleccionarRol(opcion.Tipo)"
                                                disabled="@asignando"
                                                class="w-full rounded-xl bg-gradient-to-r from-[#6C8A6C] to-[#4C6B4F] text-white py-2 font-semibold hover:opacity-90 transition-opacity disabled:opacity-60">
                                            Entrar
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(errorAsignacion))
                    {
                        <div class="mt-6 rounded-xl bg-red-50 border border-red-200 text-red-700 px-4 py-3 text-sm">
                            @errorAsignacion
                        </div>
                    }

                    <p class="mt-6 text-xs text-[#6C8A6C]">
                        Si ya tienes un rol asignado por la organización, entrarás directamente sin volver a elegir.
                    </p>
                </div>
            }
            else
            {
                <div class="bg-white rounded-2xl shadow-xl p-10">
                    <p class="text-sm font-bold uppercase tracking-wide text-[#6C8A6C] mb-3">Votaciones del evento</p>
                    <h1 class="text-3xl font-bold text-[#1A281B] mb-3">@TituloEvento</h1>
                    <p class="text-[#6C8A6C] mb-4">
                        @(string.IsNullOrWhiteSpace(DescripcionEvento) ? "El evento no tiene descripcion" : DescripcionEvento)
                    </p>

                    @if (string.Equals(rolActual, "ORGANIZADOR", StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="mb-8 rounded-2xl border border-[#B5D6AC] bg-[#F8FAF7] p-6">
                            <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
                                <div>
                                    <p class="text-xs font-semibold uppercase tracking-wider text-[#6C8A6C]">Acciones de organización</p>
                                    <h2 class="text-2xl font-bold text-[#1A281B] mt-1">Gestionar mensajes e invitaciones</h2>
                                    <p class="text-sm text-[#6C8A6C] mt-1">Puedes enviar un mensaje general o invitar por correo a jurados y encargados.</p>
                                </div>
                                <div class="flex flex-wrap gap-2">
                                    <button @onclick='() => MostrarAccionOrganizador("mensaje")'
                                            class="bg-gradient-to-r from-[#6C8A6C] to-[#4C6B4F] text-white px-5 py-3 rounded-xl font-bold hover:opacity-90 transition-opacity">
                                        Enviar mensaje
                                    </button>
                                    <button @onclick='() => MostrarAccionOrganizador("jurado")'
                                            class="bg-white border-2 border-[#6C8A6C] text-[#6C8A6C] px-5 py-3 rounded-xl font-bold hover:bg-[#E9EFE1] transition-colors">
                                        Invitar jurado
                                    </button>
                                    <button @onclick='() => MostrarAccionOrganizador("encargado")'
                                            class="bg-white border-2 border-[#6C8A6C] text-[#6C8A6C] px-5 py-3 rounded-xl font-bold hover:bg-[#E9EFE1] transition-colors">
                                        Invitar encargado
                                    </button>
                                    <button @onclick="() => mostrarConfirmEliminarEvento = !mostrarConfirmEliminarEvento"
                                            class="inline-flex items-center gap-2 border-2 border-red-400 text-red-600 px-5 py-3 rounded-xl font-bold hover:bg-red-50 transition-colors">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M1 7h22M9 7V4a1 1 0 011-1h4a1 1 0 011 1v3" />
                                        </svg>
                                        Eliminar evento
                                    </button>
                                </div>

                                @if (mostrarConfirmEliminarEvento)
                                {
                                    <div class="mt-4 bg-red-50 border border-red-200 rounded-xl p-4">
                                        <p class="text-red-700 font-medium mb-3 text-sm">¿Eliminar este evento? Se borrarán todos los proyectos y votos de forma permanente.</p>
                                        <div class="flex gap-3">
                                            <button @onclick="EliminarEventoAsync" disabled="@eliminandoEvento"
                                                    class="bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded-lg font-bold text-sm transition-colors disabled:opacity-50">
                                                @(eliminandoEvento ? "Eliminando..." : "Sí, eliminar")
                                            </button>
                                            <button @onclick="() => mostrarConfirmEliminarEvento = false"
                                                    class="border border-gray-300 text-gray-500 px-4 py-2 rounded-lg text-sm hover:bg-gray-50 transition-colors">
                                                Cancelar
                                            </button>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(errorEliminarEvento))
                                        {
                                            <p class="text-red-500 text-sm mt-2">⚠️ @errorEliminarEvento</p>
                                        }
                                    </div>
                                }
                            </div>

                            @if (accionOrganizadorActiva == "mensaje")
                            {
                                <EditForm Model="@mensajeEvento" OnValidSubmit="EnviarMensajeOrganizadorAsync">
                                    <div class="mt-6 space-y-4 bg-white rounded-2xl shadow p-6 border border-[#E9EFE1]">
                                        <div class="space-y-1">
                                            <label class="text-sm font-medium text-[#4C6B4F]">Asunto</label>
                                            <InputText @bind-Value="mensajeEvento.Asunto" disabled="@enviandoMensaje" class="w-full h-10 rounded-md border bg-[#E9EFE1] border-[#B5D6AC] px-3 text-sm focus:outline-none focus:border-[#6C8A6C] focus:ring-1 focus:ring-[#6C8A6C]" />
                                        </div>
                                        <div class="space-y-1">
                                            <label class="text-sm font-medium text-[#4C6B4F]">Mensaje</label>
                                            <textarea @bind="mensajeEvento.Mensaje" disabled="@enviandoMensaje" rows="5" class="w-full rounded-md border bg-[#E9EFE1] border-[#B5D6AC] px-3 py-2 text-sm focus:outline-none focus:border-[#6C8A6C] focus:ring-1 focus:ring-[#6C8A6C] resize-none"></textarea>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(errorMensajeOrganizador))
                                        {
                                            <div class="rounded-xl bg-red-50 border border-red-200 text-red-700 px-4 py-3 text-sm">@errorMensajeOrganizador</div>
                                        }
                                        <div class="flex justify-end gap-3 pt-2">
                                            <button type="button" @onclick='() => accionOrganizadorActiva = null' class="px-5 py-2 rounded-xl border-2 border-[#6C8A6C] text-[#6C8A6C] font-bold hover:bg-[#E9EFE1] transition-colors">Cancelar</button>
                                            <button type="submit" disabled="@enviandoMensaje" class="bg-gradient-to-r from-[#6C8A6C] to-[#4C6B4F] text-white px-6 py-2 rounded-xl font-bold hover:opacity-90 transition-opacity disabled:opacity-60">Enviar</button>
                                        </div>
                                    </div>
                                </EditForm>
                            }
                            else if (accionOrganizadorActiva == "jurado")
                            {
                                <EditForm Model="@invitacionJurado" OnValidSubmit="InvitarJuradoAsync">
                                    <div class="mt-6 space-y-4 bg-white rounded-2xl shadow p-6 border border-[#E9EFE1]">
                                        <div class="space-y-1">
                                            <label class="text-sm font-medium text-[#4C6B4F]">Correo electrónico</label>
                                            <InputText @bind-Value="invitacionJurado.Email" disabled="@enviandoInvitacion" placeholder="correo@ejemplo.com" class="w-full h-10 rounded-md border bg-[#E9EFE1] border-[#B5D6AC] px-3 text-sm focus:outline-none focus:border-[#6C8A6C] focus:ring-1 focus:ring-[#6C8A6C]" />
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(errorInvitacionJurado))
                                        {
                                            <div class="rounded-xl bg-red-50 border border-red-200 text-red-700 px-4 py-3 text-sm">@errorInvitacionJurado</div>
                                        }
                                        <div class="flex justify-end gap-3 pt-2">
                                            <button type="button" @onclick='() => accionOrganizadorActiva = null' class="px-5 py-2 rounded-xl border-2 border-[#6C8A6C] text-[#6C8A6C] font-bold hover:bg-[#E9EFE1] transition-colors">Cancelar</button>
                                            <button type="submit" disabled="@enviandoInvitacion" class="bg-gradient-to-r from-[#6C8A6C] to-[#4C6B4F] text-white px-6 py-2 rounded-xl font-bold hover:opacity-90 transition-opacity disabled:opacity-60">Invitar</button>
                                        </div>
                                    </div>
                                </EditForm>
                            }
                            else if (accionOrganizadorActiva == "encargado")
                            {
                                <EditForm Model="@invitacionEncargado" OnValidSubmit="InvitarEncargadoAsync">
                                    <div class="mt-6 space-y-4 bg-white rounded-2xl shadow p-6 border border-[#E9EFE1]">
                                        <div class="space-y-1">
                                            <label class="text-sm font-medium text-[#4C6B4F]">Correo electrónico</label>
                                            <InputText @bind-Value="invitacionEncargado.Email" disabled="@enviandoInvitacion" placeholder="correo@ejemplo.com" class="w-full h-10 rounded-md border bg-[#E9EFE1] border-[#B5D6AC] px-3 text-sm focus:outline-none focus:border-[#6C8A6C] focus:ring-1 focus:ring-[#6C8A6C]" />
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(errorInvitacionEncargado))
                                        {
                                            <div class="rounded-xl bg-red-50 border border-red-200 text-red-700 px-4 py-3 text-sm">@errorInvitacionEncargado</div>
                                        }
                                        <div class="flex justify-end gap-3 pt-2">
                                            <button type="button" @onclick='() => accionOrganizadorActiva = null' class="px-5 py-2 rounded-xl border-2 border-[#6C8A6C] text-[#6C8A6C] font-bold hover:bg-[#E9EFE1] transition-colors">Cancelar</button>
                                            <button type="submit" disabled="@enviandoInvitacion" class="bg-gradient-to-r from-[#6C8A6C] to-[#4C6B4F] text-white px-6 py-2 rounded-xl font-bold hover:opacity-90 transition-opacity disabled:opacity-60">Invitar</button>
                                        </div>
                                    </div>
                                </EditForm>
                            }
                        </div>
                    }

                    <p class="text-[#4C6B4F] mb-8">
                        Selecciona a qué votación quieres entrar.
                    </p>

                    <div class="space-y-4">
                        @foreach (var v in votacionesEvento)
                        {
                            <div class="rounded-2xl border border-[#B5D6AC] bg-[#F8FAF7] p-5">
                                <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                                    <div>
                                        <p class="text-lg font-bold text-[#1A281B]">@v.Titulo</p>
                                        <p class="text-xs mt-2 @GetEstadoVotacionClase(v)">@GetEstadoVotacionTexto(v)</p>
                                    </div>
                                    <div class="flex flex-wrap items-center gap-2">
                                        <button @onclick="() => IrADestino(v.Id)"
                                                class="bg-gradient-to-r from-[#6C8A6C] to-[#4C6B4F] text-white px-6 py-3 rounded-xl font-bold hover:opacity-90 transition-opacity">
                                            @TextoAccion
                                        </button>

                                        @if (PuedeMostrarBotonVotarParticipante(v))
                                        {
                                            <button @onclick="() => IrAVotarComoParticipante(v.Id)"
                                                    class="bg-white border-2 border-[#6C8A6C] text-[#6C8A6C] px-6 py-3 rounded-xl font-bold hover:bg-[#E9EFE1] transition-colors">
                                                Votar
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </main>
</div>

@code {
    [Parameter] public string? EventId { get; set; }
    [Parameter]
    [SupplyParameterFromQuery]
    public string? Dest { get; set; }

    private bool cargando = true;
    private bool asignando = false;
    private bool enviandoMensaje = false;
    private bool enviandoInvitacion = false;
    private string? error;
    private string? errorAsignacion;
    private string? errorMensajeOrganizador;
    private string? errorInvitacionJurado;
    private string? errorInvitacionEncargado;
    private string? rolActual;
    private List<VotacionDTO> votacionesEvento = new();
    private readonly Dictionary<string, string> codigosRol = new(StringComparer.OrdinalIgnoreCase);
    private string? accionOrganizadorActiva;
    private MensajeOrganizadorModel mensajeEvento = new();
    private InvitacionEmailModel invitacionJurado = new();
    private InvitacionEmailModel invitacionEncargado = new();

    private readonly List<OpcionRol> opcionesRol = new()
    {
        new() { Tipo = "PUBLICO", Titulo = "Público", Descripcion = "Puedes recorrer el evento y votar como asistente." },
        new() { Tipo = "JURADO", Titulo = "Jurado", Descripcion = "Evaluarás proyectos y emitirás tus votaciones." },
        new() { Tipo = "COMPETIDOR", Titulo = "Competidor", Descripcion = "Participas con un proyecto dentro del evento." },
        new() { Tipo = "ENCARGADO", Titulo = "Encargado de votación", Descripcion = "Controlas la votación del evento sin asumir el rol de organizador." }
    };

    private string TituloEvento => votacionesEvento.FirstOrDefault()?.NombreEvento
        ?? votacionesEvento.FirstOrDefault()?.Titulo
        ?? "Evento";

    private string? DescripcionEvento => votacionesEvento.FirstOrDefault()?.Descripcion;

    private static string IconoParaRol(string tipo) => tipo switch
    {
        "ENCARGADO" => "shield",
        "JURADO" => "award",
        "PUBLICO" => "users",
        "COMPETIDOR" => "trophy",
        _ => "user"
    };

    private static bool RolRequiereCodigo(string tipo) =>
        tipo == "ENCARGADO" || tipo == "JURADO";

    // ── Eliminar evento (solo ORGANIZADOR) ─────────────────────────────────
    private bool mostrarConfirmEliminarEvento = false;
    private bool eliminandoEvento = false;
    private string? errorEliminarEvento = null;

    private async Task EliminarEventoAsync()
    {
        var primeraVotacion = votacionesEvento.FirstOrDefault();
        if (primeraVotacion == null)
        {
            errorEliminarEvento = "No hay votaciones en este evento.";
            return;
        }

        eliminandoEvento = true;
        errorEliminarEvento = null;
        try
        {
            var resp = await Http.DeleteAsync($"/api/votaciones/{primeraVotacion.Id}");
            if (resp.IsSuccessStatusCode)
            {
                NavigationManager.NavigateTo("/dashboard");
            }
            else
            {
                errorEliminarEvento = await resp.Content.ReadAsStringAsync();
                if (string.IsNullOrWhiteSpace(errorEliminarEvento))
                    errorEliminarEvento = "No se pudo eliminar el evento.";
            }
        }
        catch (Exception ex)
        {
            errorEliminarEvento = $"Error de conexión: {ex.Message}";
        }
        finally
        {
            eliminandoEvento = false;
        }
    }

    private string TextoAccion => string.Equals(Dest, "results", StringComparison.OrdinalIgnoreCase)
        ? "Ver resultados"
        : "Entrar";

    private static string GetEstadoVotacionTexto(VotacionDTO votacion)
    {
        if (votacion.FechaFin <= DateTime.Now)
            return "Cerrada definitivamente";

        if (votacion.NombreEstado == "Pausada")
            return "Pausada";

        return $"Finaliza: {votacion.FechaFin:dd/MM/yyyy}";
    }

    private static string GetEstadoVotacionClase(VotacionDTO votacion)
    {
        if (votacion.FechaFin <= DateTime.Now)
            return "text-red-600 font-semibold";

        if (votacion.NombreEstado == "Pausada")
            return "text-[#90A896] font-semibold";

        return "text-[#6C8A6C]";
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarEstado();
    }

    private async Task CargarEstado()
    {
        cargando = true;
        error = null;
        errorAsignacion = null;

        if (!int.TryParse(EventId, out var idEvento))
        {
            error = "El identificador del evento no es válido.";
            cargando = false;
            return;
        }

        try
        {
            votacionesEvento = await Http.GetFromJsonAsync<List<VotacionDTO>>($"/api/eventos/{idEvento}/votaciones") ?? new List<VotacionDTO>();
            if (!votacionesEvento.Any())
            {
                error = "Este evento no tiene votaciones disponibles.";
                return;
            }

            var rol = await Http.GetFromJsonAsync<RolEventoInfo>($"/api/eventos/{idEvento}/rol");
            rolActual = rol?.Rol;
        }
        catch (Exception ex)
        {
            error = $"No pudimos comprobar tu acceso ahora mismo: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task SeleccionarRol(string tipoRol, string? codigoAcceso = null)
    {
        errorAsignacion = null;
        asignando = true;

        try
        {
            if (RolRequiereCodigo(tipoRol) && string.IsNullOrWhiteSpace(codigoAcceso))
            {
                errorAsignacion = $"Debes introducir el código de {(tipoRol == "JURADO" ? "jurado" : "encargado")}.";
                return;
            }

            var response = await Http.PostAsJsonAsync($"/api/eventos/{EventId}/rol", new { TipoRol = tipoRol, CodigoAcceso = codigoAcceso });
            if (!response.IsSuccessStatusCode)
            {
                errorAsignacion = await response.Content.ReadAsStringAsync();
                if (string.IsNullOrWhiteSpace(errorAsignacion))
                    errorAsignacion = "No se pudo asignar el rol en este evento.";
                return;
            }

            rolActual = tipoRol;
        }
        catch (Exception ex)
        {
            errorAsignacion = $"Error de conexión: {ex.Message}";
        }
        finally
        {
            asignando = false;
        }
    }

    private async Task EnviarMensajeOrganizadorAsync()
    {
        errorMensajeOrganizador = null;
        enviandoMensaje = true;

        try
        {
            if (!int.TryParse(EventId, out var idEvento))
            {
                errorMensajeOrganizador = "El identificador del evento no es válido.";
                return;
            }

            var response = await Http.PostAsJsonAsync($"/api/eventos/{idEvento}/mensaje", new
            {
                Asunto = mensajeEvento.Asunto,
                Mensaje = mensajeEvento.Mensaje
            });

            if (response.IsSuccessStatusCode)
            {
                mensajeEvento = new MensajeOrganizadorModel();
                accionOrganizadorActiva = null;
                errorMensajeOrganizador = null;
            }
            else
            {
                errorMensajeOrganizador = await response.Content.ReadAsStringAsync();
                if (string.IsNullOrWhiteSpace(errorMensajeOrganizador))
                    errorMensajeOrganizador = "No se pudo enviar el mensaje.";
            }
        }
        catch (Exception ex)
        {
            errorMensajeOrganizador = $"Error de conexión: {ex.Message}";
        }
        finally
        {
            enviandoMensaje = false;
        }
    }

    private void MostrarAccionOrganizador(string accion)
    {
        accionOrganizadorActiva = accionOrganizadorActiva == accion ? null : accion;
    }

    private async Task InvitarJuradoAsync()
    {
        errorInvitacionJurado = null;
        enviandoInvitacion = true;

        try
        {
            if (!int.TryParse(EventId, out var idEvento))
            {
                errorInvitacionJurado = "El identificador del evento no es válido.";
                return;
            }

            var response = await Http.PostAsJsonAsync($"/api/eventos/{idEvento}/invitar-jurado", new { Email = invitacionJurado.Email });
            if (response.IsSuccessStatusCode)
            {
                invitacionJurado = new InvitacionEmailModel();
                accionOrganizadorActiva = null;
            }
            else
            {
                errorInvitacionJurado = await response.Content.ReadAsStringAsync();
                if (string.IsNullOrWhiteSpace(errorInvitacionJurado))
                    errorInvitacionJurado = "No se pudo enviar la invitación.";
            }
        }
        catch (Exception ex)
        {
            errorInvitacionJurado = $"Error de conexión: {ex.Message}";
        }
        finally
        {
            enviandoInvitacion = false;
        }
    }

    private async Task InvitarEncargadoAsync()
    {
        errorInvitacionEncargado = null;
        enviandoInvitacion = true;

        try
        {
            if (!int.TryParse(EventId, out var idEvento))
            {
                errorInvitacionEncargado = "El identificador del evento no es válido.";
                return;
            }

            var response = await Http.PostAsJsonAsync($"/api/eventos/{idEvento}/invitar-encargado", new { Email = invitacionEncargado.Email });
            if (response.IsSuccessStatusCode)
