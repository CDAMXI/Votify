@page "/register"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using Votify.shared
@layout EmptyLayout
@inject NavigationManager NavigationManager
@inject HttpClient Http

<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-[#90A896] via-[#6C8A6C] to-[#4C6B4F] py-12 px-4">
    <div class="w-full max-w-md">
        <div class="bg-white rounded-2xl shadow-2xl p-8">

            <div class="flex justify-center mb-6">
                <img src="imagenes/logo-votify.png" alt="Votify" class="h-16 object-contain" />
            </div>

            <div class="text-center mb-8">
                <h1 class="text-3xl text-[#1A281B] mb-2">Crear Cuenta</h1>
                <p class="text-[#6C8A6C]">Únete a la comunidad Votify</p>
            </div>

            <EditForm Model="@registerDto" OnValidSubmit="HandleSubmit" class="space-y-5">

                <div class="space-y-2">
                    <label class="text-[#4C6B4F] font-medium">Foto de Perfil (opcional)</label>
                    <div class="flex items-center gap-4">
                        <div class="w-20 h-20 rounded-full bg-gradient-to-br from-[#E9EFE1] to-[#B5D6AC] flex items-center justify-center overflow-hidden border-2 border-[#90A896]">
                            @if (!string.IsNullOrEmpty(profileImagePreview))
                            {
                                <img src="@profileImagePreview" alt="Profile" class="w-full h-full object-cover" />
                            }
                            else
                            {
                                <svg class="w-8 h-8 text-[#6C8A6C]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
                                </svg>
                            }
                        </div>
                        <label for="profile-image" class="flex-1">
                            <div class="cursor-pointer bg-[#E9EFE1] hover:bg-[#B5D6AC] border border-[#B5D6AC] rounded-lg px-4 py-3 text-center text-[#4C6B4F] transition-colors">
                                Seleccionar imagen
                            </div>
                            <InputFile id="profile-image" OnChange="HandleImageChange" accept="image/*" class="hidden" />
                        </label>
                    </div>
                </div>

                <div class="space-y-2">
                    <label for="username" class="text-[#4C6B4F] flex items-center gap-2">
                        <Icon Name="user" CssClass="w-4 h-4 text-[#6C8A6C]" />
                        Nombre de Usuario
                    </label>
                    <InputText id="username" @bind-Value="registerDto.Username" placeholder="Ingresa tu usuario" required
                               class="w-full flex h-10 px-3 py-2 text-sm bg-[#E9EFE1] border border-[#B5D6AC] rounded-md focus:outline-none focus:border-[#6C8A6C] focus:ring-1 focus:ring-[#6C8A6C]" />
                </div>

                <div class="space-y-2">
                    <label for="email" class="text-[#4C6B4F] flex items-center gap-2">
                        <Icon Name="mail" CssClass="w-4 h-4 text-[#6C8A6C]" />
                        Correo Electrónico
                    </label>
                    <InputText id="email" type="email" @bind-Value="registerDto.Email" placeholder="tu@email.com" required
                               class="w-full flex h-10 px-3 py-2 text-sm bg-[#E9EFE1] border border-[#B5D6AC] rounded-md focus:outline-none focus:border-[#6C8A6C] focus:ring-1 focus:ring-[#6C8A6C]" />
                </div>

                <div class="space-y-2">
                    <label for="password" class="text-[#4C6B4F] flex items-center gap-2">
                        <Icon Name="lock" CssClass="w-4 h-4 text-[#6C8A6C]" />
                        Contraseña
                    </label>
                    <div class="relative">
                        <input id="password" type="@PasswordInputType" @bind="registerDto.Password" @bind:event="oninput" placeholder="Crea una contraseña segura" required
                               class="w-full flex h-10 px-3 pr-11 py-2 text-sm bg-[#E9EFE1] border border-[#B5D6AC] rounded-md focus:outline-none focus:border-[#6C8A6C] focus:ring-1 focus:ring-[#6C8A6C]" />
                        <button type="button"
                                title="@PasswordToggleTitle"
                                aria-label="@PasswordToggleTitle"
                                @onclick="TogglePasswordVisibility"
                                class="absolute inset-y-0 right-2 w-8 flex items-center justify-center text-[#6C8A6C] hover:text-[#4C6B4F]">
                            <Icon Name="@PasswordToggleIcon" CssClass="w-5 h-5" />
                        </button>
                    </div>
                    <div class="rounded-md border border-[#B5D6AC] bg-[#F5F8F2] px-3 py-2 text-sm space-y-1">
                        <div class="@GetPasswordRuleClass(TieneLongitudMinima)">
                            <Icon Name="check" CssClass="w-4 h-4" />
                            <span>Minimo 8 caracteres</span>
                        </div>
                        <div class="@GetPasswordRuleClass(TieneLetrasYNumeros)">
                            <Icon Name="check" CssClass="w-4 h-4" />
                            <span>Letras y numeros</span>
                        </div>
                        <div class="@GetPasswordRuleClass(TieneCaracterEspecial)">
                            <Icon Name="check" CssClass="w-4 h-4" />
                            <span>Caracter especial</span>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="p-3 bg-red-100 text-red-700 rounded-xl text-sm text-center">
                        @errorMessage
                    </div>
                }

                <button type="submit" disabled="@isLoading"
                        class="w-full bg-gradient-to-r from-[#6C8A6C] to-[#4C6B4F] hover:from-[#4C6B4F] hover:to-[#345F35] text-white py-4 rounded-xl transition-all duration-300 shadow-lg hover:shadow-xl mt-6 font-bold disabled:opacity-60">
                    @(isLoading ? "Creando cuenta..." : "Crear Cuenta")
                </button>
            </EditForm>

            <div class="mt-6 text-center">
                <p class="text-[#4C6B4F]">
                    ¿Ya tienes cuenta?
                    <a href="/login" class="text-[#6C8A6C] hover:text-[#70D939] font-medium transition-colors">
                        Inicia sesión
                    </a>
                </p>
            </div>
        </div>
    </div>
</div>

@code {
    private RegisterRequestDTO registerDto = new RegisterRequestDTO();
    private string? profileImagePreview;
    private string errorMessage = string.Empty;
    private bool isLoading = false;
    private bool mostrarPassword = false;

    private string PasswordInputType => mostrarPassword ? "text" : "password";
    private string PasswordToggleIcon => mostrarPassword ? "eye-off" : "eye";
    private string PasswordToggleTitle => mostrarPassword ? "Ocultar contraseña" : "Mostrar contraseña";
    private bool TieneLongitudMinima => registerDto.Password?.Length >= 8;
    private bool TieneLetrasYNumeros => !string.IsNullOrEmpty(registerDto.Password)
        && registerDto.Password.Any(char.IsLetter)
        && registerDto.Password.Any(char.IsDigit);
    private bool TieneCaracterEspecial => !string.IsNullOrEmpty(registerDto.Password)
        && registerDto.Password.Any(c => !char.IsLetterOrDigit(c) && !char.IsWhiteSpace(c));
    private bool PasswordEsSegura => TieneLongitudMinima && TieneLetrasYNumeros && TieneCaracterEspecial;

    private async Task HandleImageChange(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            var resizedFile = await file.RequestImageFileAsync("image/png", 200, 200);
            var buffer = new byte[resizedFile.Size];
            await resizedFile.OpenReadStream().ReadAsync(buffer);
            profileImagePreview = $"data:image/png;base64,{Convert.ToBase64String(buffer)}";
            registerDto.ProfileImageBase64 = profileImagePreview;
        }
    }

    private async Task HandleSubmit()
    {
        if (!PasswordEsSegura)
        {
            errorMessage = "La contraseña no cumple todos los requisitos.";
            return;
        }

        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            var response = await Http.PostAsJsonAsync("/api/auth/register", new
            {
                Username = registerDto.Username,
                Email    = registerDto.Email,
                Password = registerDto.Password
            });

            if (response.IsSuccessStatusCode)
            {
                NavigationManager.NavigateTo("/login");
            }
            else
            {
                errorMessage = await response.Content.ReadAsStringAsync();
                if (string.IsNullOrEmpty(errorMessage))
                    errorMessage = "Error al crear la cuenta.";
            }
        }
        catch
        {
            errorMessage = "No se pudo conectar con el servidor.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void TogglePasswordVisibility()
    {
        mostrarPassword = !mostrarPassword;
    }

    private static string GetPasswordRuleClass(bool cumplido)
        => cumplido
            ? "flex items-center gap-2 text-[#4C6B4F] font-medium"
            : "flex items-center gap-2 text-[#A6AAA9]";

    // Este DTO debería ir en tu proyecto Shared
    public class RegisterRequestDTO
    {
        public string Username { get; set; } = "";
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
        public string? ProfileImageBase64 { get; set; }
    }
}
