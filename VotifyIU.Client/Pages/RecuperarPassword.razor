@page "/recuperar-password"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@layout EmptyLayout
@inject HttpClient Http
@inject NavigationManager NavigationManager

<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-[#E9EFE1] via-[#B5D6AC] to-[#90A896]">
    <div class="w-full max-w-md px-6">
        <div class="bg-white rounded-2xl shadow-2xl p-8">

            <div class="flex justify-center mb-6">
                <img src="imagenes/logo-votify.png" alt="Votify" class="h-16 object-contain" />
            </div>

            <div class="text-center mb-8">
                <h1 class="text-2xl font-bold text-[#1A281B] mb-2">¿Olvidaste tu contraseña?</h1>
                <p class="text-[#6C8A6C] text-sm">Introduce tu correo y te enviaremos un enlace para restablecerla.</p>
            </div>

            @if (enviado)
            {
                <div class="p-4 bg-[#E9EFE1] rounded-xl text-center text-[#4C6B4F]">
                    <p class="font-medium">✓ Correo enviado</p>
                    <p class="text-sm mt-1">Revisa tu bandeja de entrada y sigue el enlace.</p>
                </div>
            }
            else
            {
                <div class="space-y-4">
                    <input @bind="email" @onkeydown="OnKeyDown" type="email" placeholder="tu@email.com"
                           class="w-full h-10 px-3 py-2 text-sm bg-[#E9EFE1] border border-[#B5D6AC] rounded-md focus:outline-none focus:border-[#6C8A6C]" />

                    @if (!string.IsNullOrEmpty(errorMsg))
                    {
                        <p class="text-sm text-red-500">@errorMsg</p>
                    }

                    <button @onclick="Enviar" disabled="@enviando"
                            class="w-full bg-gradient-to-r from-[#6C8A6C] to-[#4C6B4F] text-white py-3 rounded-xl font-bold hover:opacity-90 transition-opacity disabled:opacity-60">
                        @(enviando ? "Enviando..." : "Enviar enlace")
                    </button>
                </div>
            }

            <div class="mt-6 text-center">
                <a href="@(enviado ? "/login" : UrlVolver)" class="text-[#6C8A6C] hover:text-[#4C6B4F] text-sm transition-colors">
                    ← Volver
                </a>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private string email = string.Empty;
    private string errorMsg = string.Empty;
    private bool enviando = false;
    private bool enviado = false;

    private string UrlVolver => string.IsNullOrEmpty(ReturnUrl) ? "/login" : ReturnUrl;

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Enviar();
    }

    private async Task Enviar()
    {
        if (string.IsNullOrWhiteSpace(email)) { errorMsg = "Introduce un correo válido."; return; }
        enviando = true; errorMsg = string.Empty;
        var res = await Http.PostAsJsonAsync("/api/auth/forgot-password", new { Email = email });
        if (res.IsSuccessStatusCode) { enviado = true; }
        else { errorMsg = await res.Content.ReadAsStringAsync(); }
        enviando = false;
    }
}
