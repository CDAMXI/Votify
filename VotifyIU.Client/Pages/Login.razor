@page "/"
@page "/login"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using Votify.shared
@layout EmptyLayout
@inject NavigationManager NavigationManager
@inject HttpClient Http

<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-[#E9EFE1] via-[#B5D6AC] to-[#90A896]">
    <div class="w-full max-w-md px-6">
        <div class="bg-white rounded-2xl shadow-2xl p-8">

            <div class="flex justify-center mb-8">
                <img src="imagenes/logo-votify.png" alt="Votify" class="h-16 object-contain" />
            </div>

            <div class="text-center mb-8">
                <h1 class="text-3xl text-[#1A281B] mb-2">Bienvenido a Votify</h1>
                <p class="text-[#6C8A6C]">Inicia sesión para votar en hackathones</p>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="mb-4 p-3 bg-red-100 text-red-700 rounded-xl text-sm text-center">
                    @errorMessage
                </div>
            }

            <EditForm Model="@loginDto" OnValidSubmit="HandleSubmit" class="space-y-6">

                <div class="space-y-2">
                    <label for="username" class="text-[#4C6B4F]">Usuario</label>
                    <InputText id="username"
                               @bind-Value="loginDto.Username"
                               placeholder="Ingresa tu usuario"
                               required
                               class="w-full h-10 rounded-md border bg-[#E9EFE1] border-[#B5D6AC] px-3 py-2 text-sm focus:outline-none focus:border-[#6C8A6C] focus:ring-1 focus:ring-[#6C8A6C]" />
                </div>

                <div class="space-y-2">
                    <label for="password" class="text-[#4C6B4F]">Contraseña</label>
                    <InputText type="password"
                               id="password"
                               @bind-Value="loginDto.Password"
                               placeholder="Ingresa tu contraseña"
                               required
                               class="w-full h-10 rounded-md border bg-[#E9EFE1] border-[#B5D6AC] px-3 py-2 text-sm focus:outline-none focus:border-[#6C8A6C] focus:ring-1 focus:ring-[#6C8A6C]" />
                </div>

                <div class="text-right">
                    <a href="/recuperar-password" class="text-sm text-[#6C8A6C] hover:text-[#4C6B4F] transition-colors">
                        ¿Olvidaste tu contraseña?
                    </a>
                </div>

                <button type="submit" disabled="@isLoading"
                        class="w-full bg-gradient-to-r from-[#6C8A6C] to-[#4C6B4F] hover:from-[#4C6B4F] hover:to-[#345F35] text-white py-6 rounded-xl transition-all duration-300 shadow-lg hover:shadow-xl font-medium disabled:opacity-60">
                    @(isLoading ? "Iniciando sesión..." : "Iniciar Sesión")
                </button>
            </EditForm>

            <div class="mt-6 text-center">
                <p class="text-[#4C6B4F]">
                    ¿No tienes cuenta?
                    <a href="/register" class="text-[#6C8A6C] hover:text-[#70D939] font-medium transition-colors">
                        Regístrate aquí
                    </a>
                </p>
            </div>

        </div>
    </div>
</div>
@code {
    private UserLoginDTO loginDto = new UserLoginDTO();
    private string errorMessage = string.Empty;
    private bool isLoading = false;

    private async Task HandleSubmit()
    {
        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            var response = await Http.PostAsJsonAsync("/api/auth/login", new
            {
                Username = loginDto.Username,
                Password = loginDto.Password
            });

            if (response.IsSuccessStatusCode)
            {
                NavigationManager.NavigateTo("/dashboard");
            }
            else
            {
                errorMessage = "Usuario o contraseña incorrectos.";
            }
        }
        catch
        {
            errorMessage = "No se pudo conectar con el servidor.";
        }
        finally
        {
            isLoading = false;
        }
    }

    public class UserLoginDTO
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}