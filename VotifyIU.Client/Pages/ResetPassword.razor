@page "/reset-password"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@layout EmptyLayout
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-[#E9EFE1] via-[#B5D6AC] to-[#90A896]">
    <div class="w-full max-w-md px-6">
        <div class="bg-white rounded-2xl shadow-2xl p-8">

            <div class="flex justify-center mb-6">
                <img src="imagenes/logo-votify.png" alt="Votify" class="h-16 object-contain" />
            </div>

            <div class="text-center mb-8">
                <h1 class="text-2xl font-bold text-[#1A281B] mb-2">Nueva contraseña</h1>
                <p class="text-[#6C8A6C] text-sm">Introduce tu nueva contraseña.</p>
            </div>

            @if (exito)
            {
                <div class="p-6 bg-[#E9EFE1] rounded-xl text-center text-[#4C6B4F] space-y-3">
                    <p class="text-2xl">✓</p>
                    <p class="font-semibold text-[#1A281B]">Contraseña establecida correctamente</p>
                    <p class="text-sm text-[#6C8A6C]">Esta pestaña se cerrará en</p>
                    <p class="text-5xl font-bold text-[#4C6B4F]">@contador</p>
                    <p class="text-sm text-[#6C8A6C]">segundos</p>
                </div>
            }
            else
            {
                <div class="space-y-4">
                    <input @bind="nuevaPassword" @onkeydown="OnKeyDown" type="password" placeholder="Nueva contraseña"
                           class="w-full h-10 px-3 py-2 text-sm bg-[#E9EFE1] border border-[#B5D6AC] rounded-md focus:outline-none focus:border-[#6C8A6C]" />
                    <input @bind="confirmar" @onkeydown="OnKeyDown" type="password" placeholder="Confirmar contraseña"
                           class="w-full h-10 px-3 py-2 text-sm bg-[#E9EFE1] border border-[#B5D6AC] rounded-md focus:outline-none focus:border-[#6C8A6C]" />

                    @if (!string.IsNullOrEmpty(errorMsg))
                    {
                        <p class="text-sm text-red-500">@errorMsg</p>
                    }

                    <button @onclick="Guardar" disabled="@guardando"
                            class="w-full bg-gradient-to-r from-[#6C8A6C] to-[#4C6B4F] text-white py-3 rounded-xl font-bold hover:opacity-90 transition-opacity disabled:opacity-60">
                        @(guardando ? "Guardando..." : "Guardar contraseña")
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    private string nuevaPassword = string.Empty;
    private string confirmar = string.Empty;
    private string errorMsg = string.Empty;
    private bool guardando = false;
    private bool exito = false;
    private int contador = 10;

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Guardar();
    }

    private async Task Guardar()
    {
        if (string.IsNullOrWhiteSpace(nuevaPassword)) { errorMsg = "Introduce una contraseña."; return; }
        if (nuevaPassword != confirmar) { errorMsg = "Las contraseñas no coinciden."; return; }
        if (string.IsNullOrEmpty(Token)) { errorMsg = "Token no válido."; return; }

        guardando = true; errorMsg = string.Empty;
        var res = await Http.PostAsJsonAsync("/api/auth/reset-password", new { Token, NuevaPassword = nuevaPassword });
        if (res.IsSuccessStatusCode)
        {
            exito = true;
            IniciarContador();
        }
        else { errorMsg = await res.Content.ReadAsStringAsync(); }
        guardando = false;
    }

    private async void IniciarContador()
    {
        while (contador > 0)
        {
            await Task.Delay(1000);
            contador--;
            StateHasChanged();
        }
        await JS.InvokeVoidAsync("eval", "window.close();");
    }
}
