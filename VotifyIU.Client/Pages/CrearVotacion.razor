@page "/crear-votacion"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using Votify.shared
@layout EmptyLayout
@inject NavigationManager NavigationManager
@inject HttpClient Http

<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-[#E9EFE1] via-[#B5D6AC] to-[#90A896] px-4 py-8">
    <div class="w-full max-w-4xl bg-white rounded-2xl shadow-2xl overflow-hidden flex">

        <!-- Panel izquierdo -->
        <div class="hidden md:flex flex-col justify-between bg-gradient-to-b from-[#4C6B4F] to-[#1A281B] text-white p-10 w-80 flex-shrink-0">
            <div>
                <a href="/dashboard" class="flex items-center gap-2 text-[#B5D6AC] hover:text-white transition-colors text-sm mb-10">
                    ← Volver
                </a>
                <img src="imagenes/LogoVotifyPNG.png" alt="Votify" class="h-14 object-contain mb-8" />
                <h1 class="text-3xl font-bold mb-3">Crear Evento</h1>
                <p class="text-[#B5D6AC] text-sm leading-relaxed">
                    Configura un nuevo evento de votación. Define las categorías, los pesos de votación y los códigos de acceso.
                </p>
            </div>
            <p class="text-[#6C8A6C] text-xs">Votify · Plataforma de votaciones</p>
        </div>

        <!-- Panel derecho: formulario -->
        <div class="flex-1 p-8 md:p-10 overflow-y-auto max-h-screen">

            <!-- Cabecera móvil -->
            <div class="flex items-center gap-3 mb-6 md:hidden">
                <a href="/dashboard" class="text-[#6C8A6C] hover:text-[#4C6B4F] text-sm">← Volver</a>
                <img src="imagenes/LogoVotifyPNG.png" alt="Votify" class="h-10 object-contain ml-auto" />
            </div>

            <h2 class="text-2xl font-bold text-[#1A281B] mb-1 hidden md:block">Nuevo evento</h2>
            <p class="text-[#6C8A6C] text-sm mb-6 hidden md:block">Rellena los datos del evento</p>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="mb-4 p-3 bg-red-100 text-red-700 rounded-xl text-sm border border-red-200">
                    ⚠️ @errorMessage
                </div>
            }

            <EditForm Model="@votacionDto" OnValidSubmit="HandleSubmit" class="space-y-5">

                <!-- Título -->
                <div class="space-y-1">
                    <label class="text-sm font-medium text-[#4C6B4F]">Título</label>
                    <InputText @bind-Value="votacionDto.Titulo"
                               placeholder="¿Cómo se llamará la votación?"
                               disabled="@isLoading"
                               required
                               class="w-full h-10 rounded-lg border bg-[#E9EFE1] border-[#B5D6AC] px-3 py-2 text-sm focus:outline-none focus:border-[#6C8A6C] focus:ring-1 focus:ring-[#6C8A6C]" />
                </div>

                <!-- Descripción -->
                <div class="space-y-1">
                    <label class="text-sm font-medium text-[#4C6B4F]">Descripción</label>
                    <div class="relative">
                        <textarea value="@votacionDto.Descripcion"
                                  @oninput="OnDescripcionInput"
                                  maxlength="500"
                                  placeholder="Describe la votación"
                                  disabled="@isLoading"
                                  class="w-full min-h-[80px] rounded-lg border bg-[#E9EFE1] border-[#B5D6AC] px-3 py-2 text-sm focus:outline-none focus:border-[#6C8A6C] focus:ring-1 focus:ring-[#6C8A6C]"></textarea>
                        <span class="absolute bottom-2 right-3 text-xs text-[#A6AAA9]">@descripcionLength/500</span>
                    </div>
                </div>

                <!-- Fechas -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="space-y-1">
                        <label class="text-sm font-medium text-[#4C6B4F]">Fecha de inicio</label>
                        <InputDate @bind-Value="votacionDto.FechaIni"
                                   disabled="@isLoading"
                                   class="w-full h-10 rounded-lg border bg-[#E9EFE1] border-[#B5D6AC] px-3 py-2 text-sm focus:outline-none focus:border-[#6C8A6C] focus:ring-1 focus:ring-[#6C8A6C]" />
                    </div>
                    <div class="space-y-1">
                        <label class="text-sm font-medium text-[#4C6B4F]">Fecha de fin</label>
                        <InputDate @bind-Value="votacionDto.FechaFin"
                                   disabled="@isLoading"
                                   class="w-full h-10 rounded-lg border bg-[#E9EFE1] border-[#B5D6AC] px-3 py-2 text-sm focus:outline-none focus:border-[#6C8A6C] focus:ring-1 focus:ring-[#6C8A6C]" />
                    </div>
                </div>

                <!-- Toggle: competidores votan -->
                <div class="flex items-center justify-between bg-[#F8FAF7] rounded-lg px-4 py-3 border border-[#B5D6AC]/40">
                    <div>
                        <p class="text-sm font-medium text-[#1A281B]">Los competidores pueden votar</p>
                        <p class="text-xs text-[#6C8A6C]">Si está activo, los propios participantes podrán emitir votos</p>
                    </div>
                    <button type="button" @onclick="ToggleCompetidoresVotan"
                            class="relative w-11 h-6 rounded-full transition-colors duration-200 focus:outline-none @(votacionDto.PermiteCompetidoresVotar ? "bg-[#6C8A6C]" : "bg-gray-300")">
                        <span class="absolute top-0.5 left-0.5 w-5 h-5 bg-white rounded-full shadow transition-transform duration-200 @(votacionDto.PermiteCompetidoresVotar ? "translate-x-5" : "translate-x-0")"></span>
                    </button>
                </div>

                <!-- Separador -->
                <div class="border-t border-[#B5D6AC]/40 pt-1">
                    <p class="text-xs font-semibold text-[#6C8A6C] uppercase tracking-wider">Categorías y baremos</p>
                </div>

                <!-- Input nueva categoría -->
                <div class="space-y-2">
                    <div class="flex gap-2">
                        <input @bind="nuevaCategoriaNombre"
                               @bind:event="oninput"
                               @onkeydown="OnCategoriaKeyDown"
                               placeholder="Nombre de la categoría"
                               disabled="@isLoading"
                               class="flex-1 h-10 rounded-lg border bg-[#E9EFE1] border-[#B5D6AC] px-3 text-sm focus:outline-none focus:border-[#6C8A6C] focus:ring-1 focus:ring-[#6C8A6C]" />
                        <input type="number" @bind="nuevaCategoriaBaremo"
                               min="0" placeholder="Baremo"
                               disabled="@isLoading"
                               class="w-24 h-10 rounded-lg border bg-[#E9EFE1] border-[#B5D6AC] px-3 text-sm focus:outline-none focus:border-[#6C8A6C] focus:ring-1 focus:ring-[#6C8A6C]" />
                        <button type="button" @onclick="AgregarCategoria"
                                class="h-10 px-4 bg-[#6C8A6C] hover:bg-[#4C6B4F] text-white text-sm font-bold rounded-lg transition-colors">
                            +
                        </button>
                    </div>
                    @if (!string.IsNullOrEmpty(errorCategoria))
                    {
                        <p class="text-xs text-red-600">⚠️ @errorCategoria</p>
                    }
                    <!-- Chips de categorías -->
                    @if (votacionDto.Categorias.Any())
                    {
                        <div class="flex flex-wrap gap-2 mt-1">
                            @foreach (var cat in votacionDto.Categorias)
                            {
                                <span class="flex items-center gap-1 bg-[#E9EFE1] border border-[#B5D6AC] text-[#1A281B] text-xs font-medium px-3 py-1 rounded-full">
                                    @cat.Nombre
                                    <span class="text-[#6C8A6C] font-bold">baremo @cat.Peso</span>
                                    <button type="button" @onclick="() => EliminarCategoria(cat)"
                                            class="ml-1 text-[#A6AAA9] hover:text-red-500 font-bold leading-none">×</button>
                                </span>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-xs text-[#A6AAA9]">Sin categorías todavía. Escribe el nombre, el baremo y pulsa + o Enter.</p>
                    }
                </div>

                <!-- Separador -->
                <div class="border-t border-[#B5D6AC]/40 pt-1">
                    <p class="text-xs font-semibold text-[#6C8A6C] uppercase tracking-wider">Peso de los votos</p>
                </div>

                <!-- Peso jurado / público -->
                <div class="grid grid-cols-2 gap-4">
                    <div class="space-y-1">
                        <label class="text-sm font-medium text-[#4C6B4F]">Peso voto jurado (%)</label>
                        <input type="number" @bind="votacionDto.PesoJurado"
                               min="0" max="100"
                               disabled="@isLoading"
                               class="w-full h-10 rounded-lg border bg-[#E9EFE1] border-[#B5D6AC] px-3 text-sm focus:outline-none focus:border-[#6C8A6C] focus:ring-1 focus:ring-[#6C8A6C]" />
                    </div>
                    <div class="space-y-1">
                        <label class="text-sm font-medium text-[#4C6B4F]">Peso voto público (%)</label>
                        <input type="number" @bind="votacionDto.PesoPublico"
                               min="0" max="100"
                               disabled="@isLoading"
                               class="w-full h-10 rounded-lg border bg-[#E9EFE1] border-[#B5D6AC] px-3 text-sm focus:outline-none focus:border-[#6C8A6C] focus:ring-1 focus:ring-[#6C8A6C]" />
                    </div>
                </div>
                @if (votacionDto.PesoJurado + votacionDto.PesoPublico != 100)
                {
                    <p class="text-xs text-amber-600">⚠️ Los pesos deben sumar 100% (actualmente @(votacionDto.PesoJurado + votacionDto.PesoPublico)%)</p>
                }
                else
                {
                    <p class="text-xs text-[#6C8A6C]">✓ Los pesos suman 100%</p>
                }

                <!-- Separador -->
                <div class="border-t border-[#B5D6AC]/40 pt-1">
                    <p class="text-xs font-semibold text-[#6C8A6C] uppercase tracking-wider">Códigos de acceso</p>
                </div>

                <!-- Códigos -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="space-y-1">
                        <label class="text-sm font-medium text-[#4C6B4F]">Código encargado</label>
                        <input @bind="votacionDto.CodigoEncargado"
                               placeholder="Ej: ENC2026"
                               disabled="@isLoading"
                               class="w-full h-10 rounded-lg border bg-[#E9EFE1] border-[#B5D6AC] px-3 text-sm font-mono focus:outline-none focus:border-[#6C8A6C] focus:ring-1 focus:ring-[#6C8A6C]" />
                    </div>
                    <div class="space-y-1">
                        <label class="text-sm font-medium text-[#4C6B4F]">Código jurado</label>
                        <input @bind="votacionDto.CodigoJurado"
                               placeholder="Ej: JUR2026"
                               disabled="@isLoading"
                               class="w-full h-10 rounded-lg border bg-[#E9EFE1] border-[#B5D6AC] px-3 text-sm font-mono focus:outline-none focus:border-[#6C8A6C] focus:ring-1 focus:ring-[#6C8A6C]" />
                    </div>
                </div>

                <!-- Botón submit -->
                <button type="submit" disabled="@isLoading"
                        class="w-full bg-gradient-to-r from-[#6C8A6C] to-[#4C6B4F] hover:from-[#4C6B4F] hover:to-[#345F35] text-white py-3 rounded-xl transition-all duration-300 shadow-lg hover:shadow-xl font-medium disabled:opacity-60 flex items-center justify-center gap-2 mt-2">
                    @if (isLoading)
                    {
                        <div class="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
                        <span>Creando evento...</span>
                    }
                    else
                    {
                        <span>Crear Evento</span>
                    }
                </button>

            </EditForm>
        </div>
    </div>
</div>

@code {
    private VotacionDTO votacionDto = new VotacionDTO
    {
        FechaIni = DateTime.Now,
        FechaFin = DateTime.Now.AddDays(1),
        PesoJurado = 70,
        PesoPublico = 30
    };

    private bool isLoading = false;
    private string errorMessage = string.Empty;
    private int descripcionLength = 0;

    // Categorías
    private string nuevaCategoriaNombre = "";
    private int nuevaCategoriaBaremo = 0;
    private string? errorCategoria = null;


    private void OnDescripcionInput(ChangeEventArgs e)
    {
        votacionDto.Descripcion = e.Value?.ToString() ?? string.Empty;
        descripcionLength = votacionDto.Descripcion.Length;
    }

    private void ToggleCompetidoresVotan()
    {
        votacionDto.PermiteCompetidoresVotar = !votacionDto.PermiteCompetidoresVotar;
    }

    private void AgregarCategoria()
    {
        errorCategoria = null;
        string nombre = nuevaCategoriaNombre.Trim();

        if (string.IsNullOrEmpty(nombre))
        {
            errorCategoria = "El nombre de la categoría no puede estar vacío.";
            return;
        }
        if (votacionDto.Categorias.Any(c => c.Nombre.Equals(nombre, StringComparison.OrdinalIgnoreCase)))
        {
            errorCategoria = "Ya existe una categoría con ese nombre.";
            return;
        }
        if (nuevaCategoriaBaremo < 0 || nuevaCategoriaBaremo > 100)
        {
            errorCategoria = "El peso debe estar entre 0 y 100.";
            return;
        }

        votacionDto.Categorias.Add(new CategoriaBaremoDTO { Nombre = nombre, Peso = nuevaCategoriaBaremo });
        nuevaCategoriaNombre = "";
        nuevaCategoriaBaremo = 0;
    }

    private void OnCategoriaKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") AgregarCategoria();
    }

    private void EliminarCategoria(CategoriaBaremoDTO cat)
    {
        votacionDto.Categorias.Remove(cat);
    }

    private async Task HandleSubmit()
    {
        errorMessage = string.Empty;

        if (votacionDto.PesoJurado + votacionDto.PesoPublico != 100)
        {
            errorMessage = $"Los pesos de jurado y público deben sumar 100% (actualmente {votacionDto.PesoJurado + votacionDto.PesoPublico}%).";
            return;
        }

        isLoading = true;
        try
        {
            var response = await Http.PostAsJsonAsync("/api/votaciones", votacionDto);

            if (response.IsSuccessStatusCode)
            {
                NavigationManager.NavigateTo("/dashboard");
            }
            else
            {
                errorMessage = await response.Content.ReadAsStringAsync();
                if (string.IsNullOrWhiteSpace(errorMessage))
                    errorMessage = "No se pudo crear el evento.";
            }
        }
        catch
        {
            errorMessage = "Error de conexión con el servidor.";
        }
        finally
        {
            isLoading = false;
        }
    }
}
