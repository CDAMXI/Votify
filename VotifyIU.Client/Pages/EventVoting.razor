    {
        errorVoto = null;
        mostrandoConfirmacionVoto = true;
    }

    private void CerrarConfirmacionVoto()
    {
        mostrandoConfirmacionVoto = false;
    }

    private async Task ConfirmarYEnviarVoto()
    {
        if (enviandoVoto) return;
        enviandoVoto = true;
        try
        {
            await SubmitCurrentVote();
        }
        finally
        {
            enviandoVoto = false;
            mostrandoConfirmacionVoto = false;
        }
    }

    private async Task CerrarExitoYContinuar()
    {
        mostrandoExitoVoto = false;
        bool todosVotados = mockProjects.All(p => votedProjects.Contains(p.Id));
        if (votesSubmitted >= 3 || todosVotados)
        {
            await Http.PostAsync($"/api/votos/finalizar/{EventId}", null);
            NavigationManager.NavigateTo("/dashboard");
            return;
        }
        VolverAListaJurado();
    }

