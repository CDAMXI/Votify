    private async Task CrearProyectoCompetidorAsync()
    {
        errorProyectoCompetidor = null;
        if (string.IsNullOrWhiteSpace(nuevoProyectoCompetidorNombre))
        {
            errorProyectoCompetidor = "El nombre del proyecto es obligatorio.";
            return;
        }
        if (string.IsNullOrWhiteSpace(nuevoProyectoCompetidorDescripcion))
        {
            errorProyectoCompetidor = "La descripción del proyecto es obligatoria.";
            return;
        }

        creandoProyectoCompetidor = true;
        try
        {
            var resp = await Http.PostAsJsonAsync($"/api/proyectos/{EventId}", new
            {
                Nombre = nuevoProyectoCompetidorNombre.Trim(),
                Descripcion = nuevoProyectoCompetidorDescripcion.Trim(),
                UsernameCompetidor = (string?)null
            });

            if (!resp.IsSuccessStatusCode)
            {
                errorProyectoCompetidor = await resp.Content.ReadAsStringAsync();
                return;
            }

            var creado = await resp.Content.ReadFromJsonAsync<ProyectoResultadoDTO>();
            if (creado == null)
            {
                errorProyectoCompetidor = "No se pudo guardar el proyecto.";
                return;
            }

            if (!string.IsNullOrWhiteSpace(nuevaImagenProyectoBase64))
            {
                var imgResp = await Http.PutAsJsonAsync($"/api/proyectos/{EventId}/{creado.Id}/foto", new
                {
                    Base64Foto = nuevaImagenProyectoBase64
                });

                if (!imgResp.IsSuccessStatusCode)
                {
                    errorProyectoCompetidor = "El proyecto se creó, pero no se pudo subir la imagen.";
                }
                else
                {
                    imagenDataUrl = nuevaImagenProyectoBase64;
                    hasProjectImage = true;
                }
            }

            creado = LimpiarProyectoResultado(creado);
            miProyectoCompetidor = new Project
            {
                Id = creado.Id.ToString(),
                DbId = creado.Id,
                Name = creado.Nombre,
                Team = string.IsNullOrWhiteSpace(creado.Competidor) ? currentUsername ?? string.Empty : creado.Competidor,
                Category = ObtenerCategoriaProyecto(creado),
                Description = creado.Descripcion
            };

            mockProjects.RemoveAll(p => p.DbId == miProyectoCompetidor.DbId);
            mockProjects.Add(miProyectoCompetidor);
            nuevoProyectoCompetidorNombre = string.Empty;
            nuevoProyectoCompetidorDescripcion = string.Empty;
            nuevaImagenProyectoBase64 = null;
            nuevaImagenProyectoPreview = null;
            if (string.IsNullOrWhiteSpace(imagenDataUrl))
            {
                hasProjectImage = false;
            }
            errorImagen = null;
        }
        catch (Exception ex)
        {
            errorProyectoCompetidor = $"Error de conexión: {ex.Message}";
        }
        finally
        {
            creandoProyectoCompetidor = false;
        }
    }

    private bool ProyectoCoincideConCategoriaActual(ProyectoResultadoDTO proyecto)
    {
        if (string.IsNullOrWhiteSpace(votacionActual?.Titulo))
            return true;

        var categoria = ObtenerCategoriaProyecto(proyecto);
        return string.IsNullOrWhiteSpace(categoria)
            || string.Equals(categoria, votacionActual.Titulo, StringComparison.OrdinalIgnoreCase);
    }

    private ProyectoResultadoDTO LimpiarProyectoResultado(ProyectoResultadoDTO proyecto)
    {
        proyecto.Categoria = ObtenerCategoriaProyecto(proyecto);
        proyecto.Participantes = proyecto.Participantes?
            .Where(p => !string.IsNullOrWhiteSpace(p) && !p.StartsWith(CategoryMarkerPrefix, StringComparison.OrdinalIgnoreCase))
            .ToList() ?? new List<string>();
        return proyecto;
    }

    private string ObtenerCategoriaProyecto(ProyectoResultadoDTO proyecto)
    {
        if (!string.IsNullOrWhiteSpace(proyecto.Categoria))
            return proyecto.Categoria;

        var categoria = proyecto.Participantes?
            .FirstOrDefault(p => !string.IsNullOrWhiteSpace(p) && p.StartsWith(CategoryMarkerPrefix, StringComparison.OrdinalIgnoreCase));

        if (!string.IsNullOrWhiteSpace(categoria))
            return categoria[CategoryMarkerPrefix.Length..].Trim();

        return CategoriaActual;
    }

    private void AplicarCriteriosDeVotacion()
    {
        var categoria = votacionActual?.Categorias?
            .FirstOrDefault(c => string.Equals(c.Nombre, CategoriaActual, StringComparison.OrdinalIgnoreCase))
            ?? votacionActual?.Categorias?.FirstOrDefault();

        var criterios = categoria?.Criterios;
        if ((criterios == null || criterios.Count == 0) && !string.IsNullOrWhiteSpace(votacionActual?.Descripcion))
        {
            criterios = ExtraerCriteriosDesdeDescripcion(votacionActual.Descripcion);
        }

        if (criterios == null || criterios.Count == 0)
            return;

        mockCriteria = criterios
            .Select((criterio, idx) => new Criterion
            {
                Id = (idx + 1).ToString(),
                Name = criterio.Nombre,
                Weight = criterio.Peso,
                Description = string.Empty
            })
            .ToList();
    }

    private List<CriterioDTO> ExtraerCriteriosDesdeDescripcion(string descripcion)
    {
        const string marker = "\n__CRITERIOS__:";
        const string legacyMarker = "\n||CRITERIOS||:";

        int idx = descripcion.IndexOf(marker, StringComparison.Ordinal);
        string markerUsado = marker;

        if (idx < 0)
        {
            idx = descripcion.IndexOf(legacyMarker, StringComparison.Ordinal);
            markerUsado = legacyMarker;
        }

        if (idx < 0)
            return new();

        string encoded = descripcion[(idx + markerUsado.Length)..].Trim();
        if (string.IsNullOrWhiteSpace(encoded))
            return new();

        try
        {
            string json = System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(encoded));
            return System.Text.Json.JsonSerializer.Deserialize<List<CriterioDTO>>(json) ?? new();
        }
        catch
        {
            return new();
        }
    }

    private async Task TogglePausa()
    {
        if (votacionCerrada)
        {
            mensajeGestion = "La votación ya está cerrada definitivamente.";
            errorGestion = true;
            return;
        }

        gestionando = true;
        mensajeGestion = null;
        try
        {
            var resp = await Http.PostAsync($"/api/votaciones/{EventId}/pausar", null);
            if (resp.IsSuccessStatusCode)
            {
                votacionPausada = !votacionPausada;
                mensajeGestion = votacionPausada ? "Votación pausada." : "Votación reanudada.";
                errorGestion = false;
            }
            else
            {
                mensajeGestion = await resp.Content.ReadAsStringAsync();
                errorGestion = true;
            }
        }
        catch
        {
            mensajeGestion = "Error de conexión.";
            errorGestion = true;
        }
        finally { gestionando = false; }
    }

    private async Task CerrarVotacion()
    {
        gestionando = true;
        mensajeGestion = null;
        confirmarCierre = false;
        try
        {
            var resp = await Http.PostAsync($"/api/votaciones/{EventId}/cerrar", null);
            if (resp.IsSuccessStatusCode)
            {
                mensajeGestion = "Votación cerrada definitivamente.";
                errorGestion = false;
                votacionCerrada = true;
                votacionPausada = false;
            }
            else
            {
                mensajeGestion = await resp.Content.ReadAsStringAsync();
                errorGestion = true;
            }
        }
        catch
        {
            mensajeGestion = "Error de conexión.";
            errorGestion = true;
        }
        finally { gestionando = false; }
    }

    private void ToggleEditMode(string criterionId)
    {
        if (editingCriteria.Contains(criterionId))
            editingCriteria.Remove(criterionId);
        else
            editingCriteria.Add(criterionId);
    }

    private double GetScore(string criterionId)
    {
        string key = $"{mockProjects[currentProjectIndex].Id}-{criterionId}";
        return scores.ContainsKey(key) ? scores[key] : 5.0;
    }

    private void HandleScoreChange(string criterionId, string? val)
    {
        if (double.TryParse(val, out double result))
        {
            string key = $"{mockProjects[currentProjectIndex].Id}-{criterionId}";
            result = Math.Clamp(result, 0, 10);
            result = Math.Round(result, 2);
            scores[key] = result;
        }
    }

    private string CalculateTotalScore()
    {
        double total = 0;
        foreach (var c in mockCriteria)
            total += (GetScore(c.Id) * c.Weight) / 100;
        return total.ToString("F1");
    }

    private double CalculateTotalScoreDouble()
    {
        double total = 0;
        foreach (var c in mockCriteria)
            total += (GetScore(c.Id) * c.Weight) / 100;
        return Math.Round(total, 2);
    }

    private double GetProgress() => mockProjects.Count == 0 ? 0 : (votedProjects.Count / (double)mockProjects.Count) * 100;
    private int NonVotedCount => mockProjects.Count(p => !votedProjects.Contains(p.Id));
    private int NonVotedRemainingExcludingCurrent => mockProjects.Count == 0 ? 0 : mockProjects.Count(p => !votedProjects.Contains(p.Id) && p.Id != mockProjects[currentProjectIndex].Id);
    private bool IsLastProject => mockProjects.Count == 0 || currentProjectIndex == mockProjects.Count - 1;

    private async Task SubmitVote()
    {
        if (votesSubmitted >= 3)
        {
            NavigationManager.NavigateTo("/dashboard");
            return;
        }

        var currentProject = mockProjects[currentProjectIndex];
        errorVoto = null;
        if (!int.TryParse(EventId, out int votacionId))
        {
            errorVoto = "ID de votación inválido.";
            return;
        }
        try
        {
            var resp = await Http.PostAsJsonAsync("/api/votos/guardar", new
            {
                VotacionId = votacionId,
                ProyectoId = currentProject.DbId,
                Puntuacion = CalculateTotalScoreDouble(),
                Comentario = string.IsNullOrWhiteSpace(comments) ? (string?)null : comments
            });
            if (!resp.IsSuccessStatusCode)
            {
                var msg = await resp.Content.ReadAsStringAsync();
                errorVoto = $"Error: {msg}";
                return;
            }
        }
        catch (Exception ex)
        {
            errorVoto = $"Error de conexión: {ex.Message}";
            return;
        }

        votedProjects.Add(currentProject.Id);
        votesSubmitted++;
        mostrandoExitoVoto = true;
    }

