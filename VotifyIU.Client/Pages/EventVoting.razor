                                            <div class="flex gap-3">
                                                <button @onclick="() => GuardarProyecto(proj)" disabled="@guardandoProyecto"
                                                        class="bg-gradient-to-r from-[#6C8A6C] to-[#4C6B4F] text-white px-4 py-2 rounded-lg font-bold text-sm hover:opacity-90 disabled:opacity-50">
                                                    @(guardandoProyecto ? "Guardando..." : "Guardar")
                                                </button>
                                                <button @onclick="() => { editandoProyectoId = null; errorEditProyecto = null; }"
                                                        class="px-4 py-2 border border-[#6C8A6C] text-[#6C8A6C] rounded-lg text-sm hover:bg-[#E9EFE1]">
                                                    Cancelar
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                }
                                else if (confirmEliminarProyectoId == proj.Id)
                                {
                                    <div class="bg-red-50 border border-red-200 rounded-xl p-4">
                                        <p class="text-red-700 font-medium text-sm mb-3">¿Eliminar el proyecto "<strong>@proj.Nombre</strong>" y todos sus votos?</p>
                                        <div class="flex gap-3">
                                            <button @onclick="() => EliminarProyecto(proj)" disabled="@eliminandoProyecto"
                                                    class="bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded-lg font-bold text-sm disabled:opacity-50">
                                                @(eliminandoProyecto ? "Eliminando..." : "Sí, eliminar")
                                            </button>
                                            <button @onclick="() => confirmEliminarProyectoId = null"
                                                    class="border border-gray-300 text-gray-500 px-4 py-2 rounded-lg text-sm hover:bg-gray-50">
                                                Cancelar
                                            </button>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="flex items-center justify-between p-4 bg-[#F8FAF7] rounded-xl border border-[#B5D6AC]/30">
                                        <div>
                                            <p class="font-bold text-[#1A281B]">@proj.Nombre</p>
                                            <div class="flex flex-wrap gap-1 mt-1">
                                                <span class="text-xs font-bold text-white bg-[#6C8A6C] px-2 py-0.5 rounded-full">👑 @proj.Competidor</span>
                                                @foreach (var p in proj.Participantes)
                                                {
                                                    <span class="text-xs text-[#4C6B4F] bg-[#E9EFE1] px-2 py-0.5 rounded-full">@p</span>
                                                }
                                            </div>
                                            @if (!string.IsNullOrEmpty(proj.Descripcion))
                                            {
                                                <p class="text-xs text-[#A6AAA9] mt-1">@proj.Descripcion</p>
                                            }
                                        </div>
                                        <div class="flex items-center gap-2 ml-4 flex-shrink-0">
                                            <button @onclick="() => StartEditProyecto(proj)"
                                                    class="border border-[#6C8A6C] text-[#6C8A6C] px-3 py-1.5 rounded-lg text-sm hover:bg-[#E9EFE1] transition-colors">
                                                ✏️
                                            </button>
                                            <button @onclick="() => { confirmEliminarProyectoId = proj.Id; editandoProyectoId = null; }"
                                                    class="border border-red-300 text-red-500 px-3 py-1.5 rounded-lg text-sm hover:bg-red-50 transition-colors">
                                                🗑
                                            </button>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>
            </div>
        }
        else if (Rol == "ENCARGADO")
        {
            <div class="bg-white rounded-2xl shadow-xl p-8 mb-6">
                <div class="flex items-center justify-between mb-6">
                    <h2 class="text-xl font-bold text-[#1A281B]">Control de votación</h2>
                    <span class="px-4 py-2 @(votacionCerrada ? "bg-red-500" : votacionPausada ? "bg-[#90A896]" : "bg-[#6C8A6C]") text-white text-sm font-bold rounded-full">
                        @(votacionCerrada ? "■ Votación cerrada" : votacionPausada ? "⏸ Pausada" : "● Votación abierta")
                    </span>
                </div>
                <div class="grid grid-cols-2 gap-4 mb-6">
                    <button @onclick="TogglePausa" disabled="@(gestionando || votacionCerrada)"
                            class="@(votacionCerrada
                                            ? "bg-[#EFEFEE] text-[#A6AAA9] py-4 rounded-xl font-bold cursor-not-allowed"
                                            : votacionPausada
                                            ? "bg-white border-2 border-[#6C8A6C] text-[#6C8A6C] py-4 rounded-xl font-bold hover:bg-[#E9EFE1] transition-colors disabled:opacity-50"
                                            : "bg-gradient-to-r from-[#6C8A6C] to-[#4C6B4F] text-white py-4 rounded-xl font-bold hover:opacity-90 transition-opacity disabled:opacity-50")">
                        @(gestionando ? "..." : votacionCerrada ? "Votación cerrada" : votacionPausada ? "▶ Reanudar votación" : "⏸ Pausar votación")
                    </button>
                    <button @onclick="MostrarConfirmCierre" disabled="@(gestionando || votacionCerrada)"
                            class="bg-red-50 border-2 border-red-300 text-red-500 py-4 rounded-xl font-bold hover:bg-red-100 transition-colors disabled:opacity-50">
                        ⏹ Cerrar votación
                    </button>
                </div>

                @if (votacionCerrada)
                {
                    <div class="bg-red-50 border border-red-200 rounded-xl p-4 mb-4">
                        <p class="text-red-700 font-medium text-sm">La votación está cerrada definitivamente. Ya no puede reanudarse ni recibir nuevos votos.</p>
                    </div>
                }
                else if (confirmarCierre)
                {
                    <div class="bg-red-50 border border-red-200 rounded-xl p-4 mb-4">
                        <p class="text-red-700 font-medium mb-3 text-sm">¿Cerrar definitivamente? Esta acción no se puede deshacer.</p>
                        <div class="flex gap-3">
                            <button @onclick="CerrarVotacion" disabled="@gestionando"
                                    class="bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded-lg font-bold text-sm disabled:opacity-50">
                                @(gestionando ? "Cerrando..." : "Sí, cerrar")
                            </button>
                            <button @onclick="OcultarConfirmCierre"
                                    class="border border-gray-300 text-gray-500 px-4 py-2 rounded-lg text-sm hover:bg-gray-50">
                                Cancelar
                            </button>
                        </div>
                    </div>
                }

                @if (mensajeGestion != null)
                {
                    <div class="mb-4 p-3 @(errorGestion ? "bg-red-100 text-red-700" : "bg-green-100 text-green-700") rounded-xl text-sm text-center">
                        @mensajeGestion
                    </div>
                }
                <div class="bg-[#E9EFE1] rounded-xl p-5 mb-4">
                    <div class="flex justify-between items-center mb-2">
                        <span class="text-sm font-medium text-[#4C6B4F]">Progreso general</span>
                        <span class="text-sm font-bold text-[#1A281B]">12 / 18 jurados han votado</span>
                    </div>
                    <div class="w-full bg-white rounded-full h-3 overflow-hidden">
                        <div class="bg-gradient-to-r from-[#6C8A6C] to-[#70D939] h-full transition-all duration-300" style="width: 66%"></div>
                    </div>
                    <p class="text-xs text-[#6C8A6C] mt-2">66% completado</p>
                </div>
            </div>

            <div class="bg-white rounded-2xl shadow-xl p-8">
                <h2 class="text-xl font-bold text-[#1A281B] mb-4">Estado por proyecto</h2>
                <div class="space-y-3">
                    @foreach (var (proj, idx) in mockProjects.Select((p, i) => (p, i)))
                    {
                        int votos = idx == 0 ? 12 : 7;
                        int total = 18;
                        double pct = (votos / (double)total) * 100;
                        <div class="p-4 bg-[#F8FAF7] rounded-xl border border-[#B5D6AC]/30">
                            <div class="flex justify-between items-center mb-2">
                                <p class="font-bold text-[#1A281B]">@proj.Name</p>
                                <span class="text-sm font-bold text-[#4C6B4F]">@votos/@total votos</span>
                            </div>
                            <div class="w-full bg-white rounded-full h-2 overflow-hidden">
                                <div class="bg-gradient-to-r from-[#6C8A6C] to-[#70D939] h-full" style="width: @(pct.ToString("F0"))%"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        @if (mostrandoImagenModal)
        {
            <div class="fixed inset-0 bg-black/50 flex items-center justify-center z-50">
                <div class="bg-white rounded-xl p-6 max-w-xl w-full">
                    <div class="flex justify-between items-start mb-4">
                        <h3 class="text-lg font-bold">Contenido del proyecto</h3>
                        <button @onclick="CerrarImagenModal" class="text-gray-500">✕</button>
                    </div>
                    @if (cargandoImagen)
                    {
                        <div class="flex justify-center items-center py-8">
                            <div class="w-8 h-8 border-4 border-[#6C8A6C] border-t-transparent rounded-full animate-spin"></div>
                        </div>
                    }
                    else if (!hasProjectImage)
                    {
                        <div class="p-4 bg-[#F8FAF7] rounded-lg text-sm text-[#6C8A6C]">No hay contenido para este proyecto.</div>
                    }
                    else
                    {
                        <img src="@imagenDataUrl" alt="Contenido" class="w-full h-auto rounded" />
                    }
                    @if (!string.IsNullOrEmpty(errorImagen))
                    {
                        <p class="text-sm text-red-500 mt-3">@errorImagen</p>
                    }
                    <div class="mt-4 flex justify-end gap-2">
                        @if (hasProjectImage)
                        {
                            @if (confirmEliminarImagen)
                            {
                                <button @onclick="ConfirmarEliminarImagenAsync" class="px-4 py-2 bg-red-500 text-white rounded">Sí, eliminar</button>
                                <button @onclick="() => confirmEliminarImagen = false" class="px-4 py-2 border rounded">Cancelar</button>
                            }
                            else
                            {
                                <button @onclick="() => confirmEliminarImagen = true" class="px-4 py-2 bg-red-500 text-white rounded">Eliminar</button>
                            }
                        }
                        <button @onclick="CerrarImagenModal" class="px-4 py-2 border rounded">Cerrar</button>
                    </div>
                </div>
            </div>
        }

        @if (errorVoto != null)
        {
            <div class="fixed bottom-6 left-1/2 -translate-x-1/2 bg-red-600 text-white px-6 py-3 rounded-xl shadow-lg z-50 max-w-md text-center text-sm font-medium">
                ⚠️ @errorVoto
            </div>
        }
    </main>
</div>
@code {
    [Parameter] public string? EventId { get; set; }
    [Parameter]
    [SupplyParameterFromQuery]
    public string? Rol { get; set; }
    private string? errorVoto = null;
    private HashSet<string> editingCriteria = new();
    private int currentProjectIndex = 0;
    private int commentLength = 0;
    private string comments = "";
    private HashSet<string> votedProjects = new();
    private Dictionary<string, double> scores = new();
    private int votesSubmitted = 0; 
    // Lógica de datos (Mock)
    private List<Project> mockProjects = new() {
        new Project { Id = "1", Name = "EcoTrack", Team = "Green Coders", Category = "Sostenibilidad", Description = "Rastreador de huella de carbono." },
        new Project { Id = "2", Name = "HealthAI", Team = "MedTech", Category = "Salud", Description = "IA para diagnóstico médico." },
        new Project { Id = "3", Name = "EduSmart", Team = "Future Minds", Category = "Educación", Description = "Plataforma adaptativa de aprendizaje con IA." },
        new Project { Id = "4", Name = "SafeCity", Team = "UrbanTech", Category = "Smart Cities", Description = "Sistema de alerta temprana para emergencias urbanas." },
        new Project { Id = "5", Name = "FoodSaver", Team = "ZeroWaste", Category = "Sostenibilidad", Description = "App para reducir el desperdicio de alimentos." },
        new Project { Id = "6", Name = "FinTrack", Team = "FinTech Lab", Category = "Finanzas", Description = "Gestor inteligente de gastos personales." }
    };
    private List<Criterion> mockCriteria = new() {
        new Criterion { Id = "1", Name = "Innovación", Weight = 25, Description = "Originalidad de la solución." },
        new Criterion { Id = "2", Name = "Viabilidad", Weight = 25, Description = "Factibilidad técnica y económica." },
        new Criterion { Id = "3", Name = "Impacto", Weight = 25, Description = "Valor generado para usuarios o sociedad." },
        new Criterion { Id = "4", Name = "Presentación", Weight = 25, Description = "Claridad y calidad de la exposición." }
    };
    private bool cargando = true;
    private bool yaVotadoEnEvento = false;
    private string? avisoSinDatos = null;

    // Estado del organizador — crear proyecto
    private List<ProyectoResultadoDTO> proyectosOrganizador = new();
    private bool mostrarFormProyecto = false;
    private string nuevoNombre = "";
    private string nuevaDescripcion = "";
    private string nuevoCompetidor = "";
    private string? errorProyecto = null;
    private bool creandoProyecto = false;

    // Estado del organizador — eliminar evento
    private bool mostrarConfirmEliminarEvento = false;
    private bool eliminandoEvento = false;
    private string? errorEliminarEvento = null;

    // Estado del organizador — editar/eliminar proyecto
    private int? editandoProyectoId = null;
    private string editProyectoNombre = "";
    private string editProyectoDescripcion = "";
    private string? errorEditProyecto = null;
    private bool guardandoProyecto = false;
    private int? confirmEliminarProyectoId = null;
    private bool eliminandoProyecto = false;
    // Estado encargado
    private bool votacionPausada = false;
    private bool votacionCerrada = false;
    private bool gestionando = false;
    private bool confirmarCierre = false;
    private string? mensajeGestion = null;
    private bool errorGestion = false;

    private void MostrarConfirmCierre() => confirmarCierre = true;
    private void OcultarConfirmCierre() => confirmarCierre = false;

    // Participantes adicionales (edición de proyecto)
    private List<string> editParticipantes = new();
    private string busquedaParticipante = "";
    private string editParticipanteLeader = "";

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(Rol))
        {
            NavigationManager.NavigateTo($"/event-access/{EventId}?dest=voting");
            return;
        }

        try
        {
            // 1. Cargar proyectos reales
            var reales = await Http.GetFromJsonAsync<List<ProyectoResultadoDTO>>($"/api/resultados/{EventId}");
            if (reales != null && reales.Count > 0)
            {
                mockProjects = reales.Select(p => new Project
                {
                    Id = p.Id.ToString(),
                    DbId = p.Id,
                    Name = p.Nombre,
                    Team = p.Competidor,
                    Category = "",
                    Description = p.Descripcion
                }).ToList();

                // Si es organizador, sincronizar lista de gestión
                if (Rol == "ORGANIZADOR")
                    proyectosOrganizador = reales;
            }
            else
            {
                avisoSinDatos = "Esta votación no tiene proyectos registrados en la base de datos. El organizador debe añadirlos antes de que se pueda votar.";
            }

            // 2. Cargar votos ya emitidos por este usuario en esta votación
            var votados = await Http.GetFromJsonAsync<List<int>>($"/api/votos/misVotos/{EventId}");
            if (votados != null)
            {
                foreach (var dbId in votados)
                {
                    var proj = mockProjects.FirstOrDefault(p => p.DbId == dbId);
                    if (proj != null)
                    {
                        votedProjects.Add(proj.Id);
                        int idx = mockProjects.IndexOf(proj);
                        if (idx >= 0) publicosVotados.Add(idx);
                    }
                }
            }

            votesSubmitted = votedProjects.Count;

            // 3. Comprobar si ya alcanzó el límite de votos (para JURADO)
            yaVotadoEnEvento = votesSubmitted >= 3;

            // Si es competidor, intentar cargar la imagen asociada a su proyecto
            if (Rol == "COMPETIDOR")
                await TryLoadMyProjectImage();
        }
        catch
        {
            if (string.IsNullOrEmpty(avisoSinDatos))
                avisoSinDatos = "No se pudieron cargar los datos del evento. Inténtalo de nuevo más tarde.";
        }
        finally
        {
            await TryLoadMyProjectImage();
            cargando = false;
        }
        // estado de la votación para encargado/organizador
        if (Rol == "ENCARGADO" || Rol == "ORGANIZADOR")
        {
            try
            {
                if (int.TryParse(EventId, out int votId))
                {
                    var votacion = await Http.GetFromJsonAsync<VotacionDTO>($"/api/votaciones/{votId}");
                    if (votacion != null)
                    {
                        votacionCerrada = !votacion.Estado && votacion.FechaFin <= DateTime.Now;
                        votacionPausada = !votacion.Estado && !votacionCerrada;
                    }
                }
            }
            catch { }
        }
    }

    // Imagen del proyecto (competidor)
    private bool hasProjectImage = false;
    private string? imagenDataUrl = null;
    private bool cargandoImagen = false;
    private bool confirmEliminarImagen = false;
    private bool mostrandoImagenModal = false;
    private string? errorImagen = null;
    private readonly long maxImageSize = 5 * 1024 * 1024; // 5 MB

    private async Task TryLoadMyProjectImage()
    {
        var proj = mockProjects.Count > 0 ? mockProjects[0] : null;
        if (proj == null || proj.DbId == 0) return;
        cargandoImagen = true;
        try
        {
            var resp = await Http.GetAsync($"/api/proyectos/{EventId}/{proj.DbId}/imagen");
            if (resp.IsSuccessStatusCode)
            {
                var bytes = await resp.Content.ReadAsByteArrayAsync();
                if (bytes != null && bytes.Length > 0)
                {
                    imagenDataUrl = $"data:image/png;base64,{Convert.ToBase64String(bytes)}";
                    hasProjectImage = true;
                }
                else
                {
                    hasProjectImage = false;
                    imagenDataUrl = null;
                }
            }
            else
            {
                hasProjectImage = false;
                imagenDataUrl = null;
            }
        }
        catch { hasProjectImage = false; imagenDataUrl = null; }
        finally { cargandoImagen = false; StateHasChanged(); }
    }

    private async Task OnInputFileChange(InputFileChangeEventArgs e)
    {
        errorImagen = string.Empty;
        try
        {
            var file = e.File;
            if (file == null) return;

            var proj = mockProjects.Count > 0 ? mockProjects[0] : null;
            if (proj == null || proj.DbId == 0)
            {
                await JS.InvokeVoidAsync("alert", "No hay proyecto válido para subir la imagen.");
                return;
            }

            if (hasProjectImage)
            {
                var confirmar = await JS.InvokeAsync<bool>("confirm", "Ya existe una imagen. ¿Deseas reemplazarla?");
                if (!confirmar) return;
            }

            var resized = await file.RequestImageFileAsync("image/jpeg", 300, 300);
            var buffer = new byte[resized.Size];
            await resized.OpenReadStream(maxAllowedSize: 1024 * 1024).ReadAsync(buffer);
            var base64 = $"data:image/jpeg;base64,{Convert.ToBase64String(buffer)}";

            var res = await Http.PutAsJsonAsync($"/api/proyectos/{EventId}/{proj.DbId}/foto", new { Base64Foto = base64 });
            if (res.IsSuccessStatusCode)
            {
                imagenDataUrl = base64;
                hasProjectImage = true;
                errorImagen = null;
            }
            else
            {
                errorImagen = await res.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            errorImagen = $"Error al procesar la imagen: {ex.Message}";
        }
        finally { StateHasChanged(); }
    }

    private async Task UploadImageAsync(Project proj, IBrowserFile file)
    {
        cargandoImagen = true;
        errorImagen = null;
        try
        {
            using var ms = new MemoryStream();
            await file.OpenReadStream(maxImageSize).CopyToAsync(ms);
            var bytes = ms.ToArray();

            using var content = new MultipartFormDataContent();
            var streamContent = new ByteArrayContent(bytes);
            streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
            content.Add(streamContent, "file", file.Name);

            var resp = await Http.PostAsync($"/api/proyectos/{EventId}/{proj.DbId}/imagen", content);
            if (resp.IsSuccessStatusCode)
            {
                imagenDataUrl = $"data:image/png;base64,{Convert.ToBase64String(bytes)}";
                hasProjectImage = true;
            }
            else
            {
                var msg = await resp.Content.ReadAsStringAsync();
                errorImagen = $"Error al subir: {msg}";
            }
        }
        catch (Exception ex)
        {
            errorImagen = $"Error de conexión: {ex.Message}";
        }
        finally { cargandoImagen = false; }
    }

    private void MostrarImagenModal()
    {
        mostrandoImagenModal = true;
    }

    private void CerrarImagenModal()
    {
        mostrandoImagenModal = false;
        confirmEliminarImagen = false;
    }

    private async Task ConfirmarEliminarImagenAsync()
    {
        var proj = mockProjects.Count > 0 ? mockProjects[0] : null;
        if (proj == null || proj.DbId == 0) return;
        confirmEliminarImagen = false;
        cargandoImagen = true;
        try
        {
            var resp = await Http.PutAsJsonAsync($"/api/proyectos/{EventId}/{proj.DbId}/foto", new { Base64Foto = "" });
            if (resp.IsSuccessStatusCode)
            {
                hasProjectImage = false;
                imagenDataUrl = null;
            }
            else
            {
                errorImagen = await resp.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            errorImagen = $"Error de conexión: {ex.Message}";
        }
        finally { cargandoImagen = false; StateHasChanged(); }
    }
    private async Task TogglePausa()
    {
        if (votacionCerrada)
        {
            mensajeGestion = "La votación ya está cerrada definitivamente.";
            errorGestion = true;
            return;
        }

        gestionando = true;
        mensajeGestion = null;
        try
        {
            var resp = await Http.PostAsync($"/api/votaciones/{EventId}/pausar", null);
            if (resp.IsSuccessStatusCode)
            {
                votacionPausada = !votacionPausada;
                mensajeGestion = votacionPausada ? "Votación pausada." : "Votación reanudada.";
                errorGestion = false;
