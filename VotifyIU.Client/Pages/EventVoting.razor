@page "/event-voting/{EventId}"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using Votify.shared
@using System.Linq
@layout EmptyLayout
@inject NavigationManager NavigationManager
@inject HttpClient Http
<style>
    input[type=number]::-webkit-inner-spin-button,
    input[type=number]::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
    input[type=number] { -moz-appearance: textfield; }
</style>
<div class="min-h-screen bg-gradient-to-br from-[#E9EFE1] to-[#B5D6AC]">
    <header class="bg-white shadow-sm border-b border-[#B5D6AC]">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-4">
                    <a href="/dashboard" class="flex items-center text-[#6C8A6C] hover:bg-[#E9EFE1] px-4 py-2 rounded-md transition-colors">
                        <span class="mr-2">←</span> Volver
                    </a>
                    <img src="imagenes/logo-votify.png" alt="Votify" class="h-16 object-contain" />
                    <h1 class="text-xl font-bold text-[#1A281B]">HackUPC 2026</h1>
                </div>
                <div class="flex items-center gap-2 text-[#4C6B4F]">
                    <span class="font-medium">Proyecto @(currentProjectIndex + 1) de @mockProjects.Count</span>
                </div>
            </div>
        </div>
    </header>
    <main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        @if (Rol == "JURADO")
        {
            @if (yaVotadoEnEvento)
            {
                <div class="bg-white rounded-2xl shadow-xl p-8 text-center">
                    <p class="text-2xl font-bold text-[#1A281B] mb-2">Ya has votado en este evento</p>
                    <p class="text-[#6C8A6C]">Tu evaluación ya fue registrada. No puedes volver a votar.</p>
                    <a href="/dashboard" class="mt-6 inline-block bg-gradient-to-r from-[#6C8A6C] to-[#4C6B4F] text-white px-6 py-3 rounded-xl font-bold">
                        Volver al Dashboard
                    </a>
                </div>
            }
            else
            {
                <div class="mb-6">
                    <div class="flex justify-between items-center mb-2">
                        <div class="flex items-center gap-4">   
                            <span class="text-sm text-[#4C6B4F]">Progreso de votación</span>
                            <span class="text-sm text-[#4C6B4F]">@votedProjects.Count/@mockProjects.Count proyectos evaluados</span>
                            <span class="   text-sm text-[#4C6B4F]">• Votos realizados: @votesSubmitted/3</span>
                        </div>            
                    </div>
                    <div class="w-full bg-white rounded-full h-2 overflow-hidden">
                        <div class="bg-gradient-to-r from-[#6C8A6C] to-[#70D939] h-full transition-all duration-300"
                        style="width: @(GetProgress() + "%")">
                        </div>
                    </div>
                </div>
                <div class="bg-white rounded-2xl shadow-xl p-8 mb-6">
                    @{
                        var project = mockProjects[currentProjectIndex];
                    }
                    <div class="mb-6">
                        <div class="flex items-start justify-between mb-4">
                            <div>
                                <h2 class="text-3xl font-bold text-[#1A281B] mb-2">@project.Name</h2>
                                <p class="text-[#6C8A6C] mb-1">Equipo: @project.Team</p>
                                <span class="inline-block px-3 py-1 bg-[#E9EFE1] text-[#4C6B4F] rounded-full text-sm">
                                    @project.Category
                                </span>
                            </div>
                            @if (votedProjects.Contains(project.Id))
                            {
                                <div class="flex items-center gap-2 text-[#70D939] bg-[#E9EFE1] px-3 py-1 rounded-full">
                                    <span class="text-sm font-bold">★ Votado</span>
                                </div>
                            }
                        </div>
                        <p class="text-[#4C6B4F] leading-relaxed">@project.Description</p>
                    </div>
                    <div class="space-y-6 mb-6">
                        <h3 class="text-xl font-bold text-[#1A281B]">Criterios de Evaluación</h3>
                        @foreach (var criterion in mockCriteria)
                        {
                            <div class="bg-[#EFEFEE] rounded-xl p-6">
                                <div class="flex items-center justify-between mb-3">
                                    <div class="flex-1">
                                        <label class="text-[#1A281B] text-base font-bold">
                                            @criterion.Name
                                            <span class="text-[#6C8A6C] ml-2 text-sm font-normal">(Peso: @criterion.Weight%)</span>
                                        </label>
                                        <p class="text-sm text-[#6C8A6C] mt-1">@criterion.Description</p>
                                    </div>
                                    <div class="ml-4 text-right">
                                        @if (editingCriteria.Contains(criterion.Id))
                                        {
                                            <input type="number"
                                            min="0" max="10" step="0.01"
                                            value="@GetScore(criterion.Id)"
                                            @onchange="(e) => HandleScoreChange(criterion.Id, e.Value?.ToString())"
                                            @onblur="() => ToggleEditMode(criterion.Id)"
                                            class="text-3xl font-bold text-[#6C8A6C] w-20 bg-transparent border-b-2 border-[#6C8A6C] outline-none text-right" />
                                        }
                                        else if (votedProjects.Contains(project.Id))
                                        {
                                            <span class="text-3xl font-bold text-[#6C8A6C]">
                                                @GetScore(criterion.Id)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-3xl font-bold text-[#6C8A6C] cursor-pointer"
                                            @onclick="() => ToggleEditMode(criterion.Id)">
                                                @GetScore(criterion.Id)
                                            </span>
                                        }
                                        <span class="text-[#A6AAA9]">/10</span>
                                    </div>
                                </div>
                                <input type="range"
                                min="0" max="10" step="0.5"
                                value="@GetScore(criterion.Id)"
                                disabled="@votedProjects.Contains(project.Id)"
                                @oninput="(e) => HandleScoreChange(criterion.Id, e.Value?.ToString())"
                                class="w-full h-2 bg-[#B5D6AC] rounded-lg appearance-none cursor-pointer accent-[#6C8A6C] my-4" />
                                <div class="flex justify-between text-xs text-[#A6AAA9]">
                                    <span>0 - Muy bajo</span>
                                    <span>5 - Promedio</span>
                                    <span>10 - Excelente</span>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="bg-gradient-to-r from-[#6C8A6C] to-[#70D939] rounded-xl p-6 mb-6 shadow-md">
                        <div class="flex items-center justify-between text-white font-bold">
                            <span class="text-lg">Puntuación Total Ponderada</span>
                            <span class="text-4xl">@CalculateTotalScore()/10</span>
                        </div>
                    </div>
                    <div class="mb-6">
                        <label for="comments" class="text-[#1A281B] font-bold mb-2 block">Comentarios (opcional)</label>
                        <div class="relative">
                            <textarea id="comments"
                            value="@comments"
                            @oninput="(e) => { comments = e.Value?.ToString() ?? string.Empty; commentLength = comments.Length; }"
                            maxlength="500"
                            placeholder="Comparte tus observaciones sobre el proyecto..."
                            class="w-full min-h-[120px] p-4 rounded-xl bg-[#E9EFE1] border-[#B5D6AC] focus:ring-2 focus:ring-[#6C8A6C] outline-none transition-all"></textarea>
                            <span class="absolute bottom-2 right-3 text-xs text-[#A6AAA9]">@commentLength/500</span>
                        </div>
                    </div>
                    <div class="flex gap-4">
                        @if (votedProjects.Contains(project.Id))
                        {
                            <span class="flex-1 text-center text-sm text-[#A6AAA9] py-4 font-medium">✓ Ya evaluado</span>
                            @if (currentProjectIndex < mockProjects.Count - 1)
                            {
                                <button @onclick="NavigateNext"
                                class="flex-1 bg-gradient-to-r from-[#6C8A6C] to-[#4C6B4F] text-white py-4 rounded-xl font-bold shadow-lg hover:opacity-90 transition-opacity">
                                    Siguiente Proyecto
                                </button>
                            }
                        }
                        else
                        {
                        <button @onclick="SubmitVote"
                            class="flex-1 bg-gradient-to-r from-[#6C8A6C] to-[#4C6B4F] text-white py-4 rounded-xl font-bold shadow-lg hover:opacity-90 transition-opacity">
                                @(((votesSubmitted + 1) >= 3 || IsLastProject) ? "Votar (Finalizar votación)" : (currentProjectIndex < mockProjects.Count - 1 ? "Siguiente Proyecto" : "Finalizar Votación"))
                            </button>
                        }
                        @if (currentProjectIndex > 0)
                        {
                            <button @onclick="PreviousProject"
                            class="px-8 border-2 border-[#6C8A6C] text-[#6C8A6C] py-4 rounded-xl font-bold hover:bg-[#E9EFE1] transition-colors">
                                Anterior
                            </button>
                        }
                        @if (!votedProjects.Contains(project.Id))
                        {
                            <button @onclick="SkipNext"
                                class="px-6 border-2 border-[#6C8A6C] text-[#6C8A6C] py-4 rounded-xl font-bold hover:bg-[#E9EFE1] transition-colors">
                                @(IsLastProject ? "Saltar Proyecto (Finalizar votación)" : "Saltar Proyecto")
                            </button>
                        }
                    </div>
                </div>
            }
        }
        else if (Rol == "PUBLICO")
        {
            @if (yaVotadoEnEvento)
            {
                <div class="bg-white rounded-2xl shadow-xl p-8 text-center">
                    <p class="text-2xl font-bold text-[#1A281B] mb-2">Ya has votado en este evento</p>
                    <p class="text-[#6C8A6C]">Tu voto ya fue registrado.</p>
                    <a href="/dashboard" class="mt-6 inline-block bg-gradient-to-r from-[#6C8A6C] to-[#4C6B4F] text-white px-6 py-3 rounded-xl font-bold">
                        Volver al Dashboard
                    </a>
                </div>
            }
            else if (!publicoMostrarVotacion)
            {
                <div class="bg-white rounded-2xl shadow-xl p-8 mb-6">
                    <h2 class="text-xl font-bold text-[#1A281B] mb-4">Proyectos del evento</h2>
                    <div class="space-y-3">
                        @for (int i = 0; i < mockProjects.Count; i++)
                        {
                            var proj = mockProjects[i];
                            var idx = i;
                            <div class="flex items-center justify-between p-4 bg-[#F8FAF7] rounded-xl border border-[#B5D6AC]/30">
                                <div>
                                    <p class="font-bold text-[#1A281B]">@proj.Name</p>
                                    <p class="text-sm text-[#6C8A6C]">@proj.Team · @proj.Category</p>
                                    <p class="text-sm text-[#4C6B4F] mt-1">@proj.Description</p>
                                </div>
                                <button @onclick="() => { publicoProyectoIndex = idx; publicoMostrarVotacion = true; }"
                                        class="ml-4 bg-gradient-to-r from-[#6C8A6C] to-[#4C6B4F] text-white px-4 py-2 rounded-xl font-bold hover:opacity-90 transition-opacity">
                                    Votar
                                </button>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                var proj = mockProjects[publicoProyectoIndex];
                <div class="bg-white rounded-2xl shadow-xl p-8 mb-6">
                    <button @onclick="() => publicoMostrarVotacion = false"
                            class="mb-4 text-[#6C8A6C] hover:underline flex items-center gap-1">
                        ← Volver a la lista
                    </button>
                    <h2 class="text-3xl font-bold text-[#1A281B] mb-2">@proj.Name</h2>
                    <p class="text-[#6C8A6C] mb-1">Equipo: @proj.Team</p>
                    <span class="inline-block px-3 py-1 bg-[#E9EFE1] text-[#4C6B4F] rounded-full text-sm mb-4">@proj.Category</span>
                    <p class="text-[#4C6B4F] mb-6">@proj.Description</p>

                    <div class="space-y-6 mb-6">
                        <h3 class="text-xl font-bold text-[#1A281B]">Criterios de Evaluación</h3>
                        @foreach (var criterion in mockCriteria)
                        {
                            <div class="bg-[#EFEFEE] rounded-xl p-6">
                                <div class="flex items-center justify-between mb-3">
                                    <div class="flex-1">
                                        <label class="text-[#1A281B] text-base font-bold">
                                            @criterion.Name
                                            <span class="text-[#6C8A6C] ml-2 text-sm font-normal">(Peso: @criterion.Weight%)</span>
                                        </label>
                                        <p class="text-sm text-[#6C8A6C] mt-1">@criterion.Description</p>
                                    </div>
                                    <div class="ml-4 text-right">
                                        <span class="text-3xl font-bold text-[#6C8A6C]">@GetScore(criterion.Id)</span>
                                        <span class="text-[#A6AAA9]">/10</span>
                                    </div>
                                </div>
                                <input type="range" min="0" max="10" step="0.5"
                                       value="@GetScore(criterion.Id)"
                                       @oninput="(e) => HandleScoreChange(criterion.Id, e.Value?.ToString())"
                                       class="w-full h-2 bg-[#B5D6AC] rounded-lg appearance-none cursor-pointer accent-[#6C8A6C] my-4" />
                                <div class="flex justify-between text-xs text-[#A6AAA9]">
                                    <span>0 - Muy bajo</span>
                                    <span>5 - Promedio</span>
                                    <span>10 - Excelente</span>
                                </div>
                            </div>
                        }
                    </div>
                    <button @onclick="SubmitVotoPublico"
                            class="w-full bg-gradient-to-r from-[#6C8A6C] to-[#4C6B4F] text-white py-4 rounded-xl font-bold shadow-lg hover:opacity-90 transition-opacity">
                        Enviar voto
                    </button>
                </div>
            }
        }
        else if (Rol == "COMPETIDOR")
        {
            <div class="bg-white rounded-2xl shadow-xl p-8 mb-6 text-center">
                <div class="w-20 h-20 rounded-full bg-gradient-to-br from-[#E9EFE1] to-[#B5D6AC] flex items-center justify-center mx-auto mb-4 text-4xl">🚀</div>
                <h2 class="text-2xl font-bold text-[#1A281B] mb-2">Tu proyecto está siendo evaluado</h2>
                <p class="text-[#6C8A6C] mb-6">Los jurados están revisando tu trabajo ahora mismo. Los resultados estarán disponibles al terminar la votación.</p>
                <div class="bg-[#E9EFE1] rounded-xl p-6 mb-6 text-left">
                    <h3 class="text-lg font-bold text-[#1A281B] mb-3">Tu proyecto</h3>
                    @{var myProj = mockProjects[0];}
                    <p class="text-xl font-bold text-[#4C6B4F]">@myProj.Name</p>
                    <p class="text-sm text-[#6C8A6C]">Equipo: @myProj.Team</p>
                    <span class="inline-block mt-2 px-3 py-1 bg-white text-[#4C6B4F] rounded-full text-xs font-bold">@myProj.Category</span>
                    <p class="text-sm text-[#4C6B4F] mt-3 leading-relaxed">@myProj.Description</p>
                </div>
                <div class="flex items-center justify-center gap-3 text-[#6C8A6C]">
                    <div class="w-3 h-3 rounded-full bg-[#6C8A6C] animate-bounce" style="animation-delay:0s"></div>
                    <div class="w-3 h-3 rounded-full bg-[#6C8A6C] animate-bounce" style="animation-delay:0.2s"></div>
                    <div class="w-3 h-3 rounded-full bg-[#6C8A6C] animate-bounce" style="animation-delay:0.4s"></div>
                    <span class="text-sm font-medium ml-2">Votación en curso</span>
                </div>
            </div>
        }
        else if (Rol == "ORGANIZADOR")
        {
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
                <div class="bg-white rounded-xl p-5 shadow-sm flex items-center gap-4">
                    <div class="w-12 h-12 rounded-full bg-gradient-to-br from-[#6C8A6C] to-[#70D939] flex items-center justify-center text-white text-xl">👥</div>
                    <div>
                        <p class="text-xs text-[#6C8A6C] font-medium">Participantes</p>
                        <p class="text-2xl font-bold text-[#1A281B]">250</p>
                    </div>
                </div>
                <div class="bg-white rounded-xl p-5 shadow-sm flex items-center gap-4">
                    <div class="w-12 h-12 rounded-full bg-gradient-to-br from-[#6C8A6C] to-[#70D939] flex items-center justify-center text-white text-xl">🏆</div>
                    <div>
                        <p class="text-xs text-[#6C8A6C] font-medium">Proyectos</p>
                        <p class="text-2xl font-bold text-[#1A281B]">@mockProjects.Count</p>
                    </div>
                </div>
                <div class="bg-white rounded-xl p-5 shadow-sm flex items-center gap-4">
                    <div class="w-12 h-12 rounded-full bg-gradient-to-br from-[#6C8A6C] to-[#70D939] flex items-center justify-center text-white text-xl">⚖️</div>
                    <div>
                        <p class="text-xs text-[#6C8A6C] font-medium">Jurados</p>
                        <p class="text-2xl font-bold text-[#1A281B]">18</p>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-2xl shadow-xl p-8 mb-6">
                <h2 class="text-xl font-bold text-[#1A281B] mb-4">Proyectos inscritos</h2>
                <div class="space-y-3">
                    @foreach (var proj in mockProjects)
                    {
                        <div class="flex items-center justify-between p-4 bg-[#F8FAF7] rounded-xl border border-[#B5D6AC]/30">
                            <div>
                                <p class="font-bold text-[#1A281B]">@proj.Name</p>
                                <p class="text-sm text-[#6C8A6C]">@proj.Team · @proj.Category</p>
                            </div>
                            <span class="px-3 py-1 bg-[#E9EFE1] text-[#4C6B4F] text-xs font-bold rounded-full">Inscrito</span>
                        </div>
                    }
                </div>
            </div>

            <div class="bg-white rounded-2xl shadow-xl p-8">
                <h2 class="text-xl font-bold text-[#1A281B] mb-4">Criterios de evaluación</h2>
                <div class="space-y-3">
                    @foreach (var criterion in mockCriteria)
                    {
                        <div class="flex items-center justify-between p-4 bg-[#F8FAF7] rounded-xl border border-[#B5D6AC]/30">
                            <div>
                                <p class="font-bold text-[#1A281B]">@criterion.Name</p>
                                <p class="text-sm text-[#6C8A6C]">@criterion.Description</p>
                            </div>
                            <span class="text-lg font-bold text-[#4C6B4F]">@criterion.Weight%</span>
                        </div>
                    }
                </div>
            </div>
        }
        else if (Rol == "ENCARGADO")
        {
            <div class="bg-white rounded-2xl shadow-xl p-8 mb-6">
                <div class="flex items-center justify-between mb-6">
                    <h2 class="text-xl font-bold text-[#1A281B]">Control de votación</h2>
                    <span class="px-4 py-2 bg-[#6C8A6C] text-white text-sm font-bold rounded-full">● Votación abierta</span>
                </div>
                <div class="grid grid-cols-2 gap-4 mb-6">
                    <button class="bg-gradient-to-r from-[#6C8A6C] to-[#4C6B4F] text-white py-4 rounded-xl font-bold hover:opacity-90 transition-opacity">
                        ⏸ Pausar votación
                    </button>
                    <button class="bg-red-50 border-2 border-red-300 text-red-500 py-4 rounded-xl font-bold hover:bg-red-100 transition-colors">
                        ⏹ Cerrar votación
                    </button>
                </div>
                <div class="bg-[#E9EFE1] rounded-xl p-5 mb-4">
                    <div class="flex justify-between items-center mb-2">
                        <span class="text-sm font-medium text-[#4C6B4F]">Progreso general</span>
                        <span class="text-sm font-bold text-[#1A281B]">12 / 18 jurados han votado</span>
                    </div>
                    <div class="w-full bg-white rounded-full h-3 overflow-hidden">
                        <div class="bg-gradient-to-r from-[#6C8A6C] to-[#70D939] h-full transition-all duration-300" style="width: 66%"></div>
                    </div>
                    <p class="text-xs text-[#6C8A6C] mt-2">66% completado</p>
                </div>
            </div>

            <div class="bg-white rounded-2xl shadow-xl p-8">
                <h2 class="text-xl font-bold text-[#1A281B] mb-4">Estado por proyecto</h2>
                <div class="space-y-3">
                    @foreach (var (proj, idx) in mockProjects.Select((p, i) => (p, i)))
                    {
                        int votos = idx == 0 ? 12 : 7;
                        int total = 18;
                        double pct = (votos / (double)total) * 100;
                        <div class="p-4 bg-[#F8FAF7] rounded-xl border border-[#B5D6AC]/30">
                            <div class="flex justify-between items-center mb-2">
                                <p class="font-bold text-[#1A281B]">@proj.Name</p>
                                <span class="text-sm font-bold text-[#4C6B4F]">@votos/@total votos</span>
                            </div>
                            <div class="w-full bg-white rounded-full h-2 overflow-hidden">
                                <div class="bg-gradient-to-r from-[#6C8A6C] to-[#70D939] h-full" style="width: @(pct.ToString("F0"))%"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </main>
</div>
@code {
    [Parameter] public string? EventId { get; set; }
    [Parameter]
    [SupplyParameterFromQuery]
    public string? Rol { get; set; }
    private HashSet<string> editingCriteria = new();
    private int currentProjectIndex = 0;
    private int commentLength = 0;
    private string comments = "";
    private HashSet<string> votedProjects = new();
    private Dictionary<string, double> scores = new();
    private int votesSubmitted = 0; 
    // Lógica de datos (Mock)
    private List<Project> mockProjects = new() {
        new Project { Id = "1", Name = "EcoTrack", Team = "Green Coders", Category = "Sostenibilidad", Description = "Rastreador de huella de carbono." },
        new Project { Id = "2", Name = "HealthAI", Team = "MedTech", Category = "Salud", Description = "IA para diagnóstico médico." },
        new Project { Id = "3", Name = "EduSmart", Team = "Future Minds", Category = "Educación", Description = "Plataforma adaptativa de aprendizaje con IA." },
        new Project { Id = "4", Name = "SafeCity", Team = "UrbanTech", Category = "Smart Cities", Description = "Sistema de alerta temprana para emergencias urbanas." },
        new Project { Id = "5", Name = "FoodSaver", Team = "ZeroWaste", Category = "Sostenibilidad", Description = "App para reducir el desperdicio de alimentos." },
        new Project { Id = "6", Name = "FinTrack", Team = "FinTech Lab", Category = "Finanzas", Description = "Gestor inteligente de gastos personales." }
    };
    private List<Criterion> mockCriteria = new() {
        new Criterion { Id = "1", Name = "Innovación", Weight = 25, Description = "Originalidad de la solución." },
        new Criterion { Id = "2", Name = "Viabilidad", Weight = 25, Description = "Factibilidad técnica y económica." },
        new Criterion { Id = "3", Name = "Impacto", Weight = 25, Description = "Valor generado para usuarios o sociedad." },
        new Criterion { Id = "4", Name = "Presentación", Weight = 25, Description = "Claridad y calidad de la exposición." }
    };
    private bool yaVotadoEnEvento = false;
    protected override async Task OnInitializedAsync()
    {
        try
        {
            yaVotadoEnEvento = await Http.GetFromJsonAsync<bool>($"/api/votos/hasVotado/{EventId}");
        }
        catch
        {
            yaVotadoEnEvento = false;
        }
        // Inicializar contador de votaciones locales (si ya hay elementos e    n votedProjects)
        votesSubmitted = votedProjects.Count;
    }
    private void ToggleEditMode(string criterionId)
    {
        if (editingCriteria.Contains(criterionId))
            editingCriteria.Remove(criterionId);
        else
            editingCriteria.Add(criterionId);
    }
    private double GetScore(string criterionId)
    {
        string key = $"{mockProjects[currentProjectIndex].Id}-{criterionId}";
        return scores.ContainsKey(key) ? scores[key] : 5.0;
    }
    private void HandleScoreChange(string criterionId, string? val)
    {
        if (double.TryParse(val, out double result))
        {
            string key = $"{mockProjects[currentProjectIndex].Id}-{criterionId}";
            result = Math.Clamp(result, 0, 10);
            result = Math.Round(result, 2);
            scores[key] = result;
        }
    }
    private string CalculateTotalScore()
    {
        double total = 0;
        var currentId = mockProjects[currentProjectIndex].Id;
        foreach (var c in mockCriteria)
        {
            total += (GetScore(c.Id) * c.Weight) / 100;
        }
        return total.ToString("F1");
    }
    private double GetProgress() => (votedProjects.Count / (double)mockProjects.Count) * 100;
    private int NonVotedCount => mockProjects.Count(p => !votedProjects.Contains(p.Id));
    private int NonVotedRemainingExcludingCurrent => mockProjects.Count(p => !votedProjects.Contains(p.Id) && p.Id != mockProjects[currentProjectIndex].Id);
    private bool IsLastProject => currentProjectIndex == mockProjects.Count - 1;
    private async Task SubmitVote()
    {
        // Limitar a 3 votaciones por evento
        if (votesSubmitted >= 3)
        {
            // opcional: mostrar mensaje o redirigir al dashboard
            NavigationManager.NavigateTo("/dashboard");
            return; 
        }

        votedProjects.Add(mockProjects[currentProjectIndex].Id);
        votesSubmitted++;

        if (votesSubmitted >= 3)
        {
            // Al alcanzar el límite, finalizar y volver al dashboard
            await Http.PostAsync($"/api/votos/finalizar/{EventId}", null);
            NavigationManager.NavigateTo("/dashboard");
            return;
        }

        // Si es el último proyecto de la lista, finalizar la votación tras votar
        if (IsLastProject)
        {
            await Http.PostAsync($"/api/votos/finalizar/{EventId}", null);
            NavigationManager.NavigateTo("/dashboard");
            return;
        }

        if (currentProjectIndex < mockProjects.Count - 1)
        {
            currentProjectIndex++;
            comments = "";
        }
        else
        {
            // Fallback: finalizar
            await Http.PostAsync($"/api/votos/finalizar/{EventId}", null);
            NavigationManager.NavigateTo("/dashboard");
        }
    }

    private async Task FinalizeVotingAsync()
    {
        try
        {
            await Http.PostAsync($"/api/votos/finalizar/{EventId}", null);
        }
        catch
        {
            // Ignorar errores en finalización del ejemplo
        }
        NavigationManager.NavigateTo("/dashboard");
    }

    private async Task SkipNext()
    {
        // Solo finalizar si el proyecto actual es el último de la lista.
        if (IsLastProject)
        {
            await FinalizeVotingAsync();
            return;
        }

        // Buscar siguiente proyecto no votado; si no hay, avanzar al siguiente índice hasta el final
        int nextIndex = currentProjectIndex + 1;
        while (nextIndex < mockProjects.Count && votedProjects.Contains(mockProjects[nextIndex].Id))
        {
            nextIndex++;
        }

        if (nextIndex < mockProjects.Count)
        {
            currentProjectIndex = nextIndex;
            return;
        }

        // No se encontró proyecto no votado después: mover al último proyecto disponible (sin finalizar)
        currentProjectIndex = mockProjects.Count - 1;
    }
    private void NavigateNext()
    {
        if (currentProjectIndex < mockProjects.Count - 1)
            currentProjectIndex++;
    }
    private void PreviousProject() => currentProjectIndex--;

    private bool publicoMostrarVotacion = false;
    private int publicoProyectoIndex = 0;

    private async Task SubmitVotoPublico()
    {
        await Http.PostAsync($"/api/votos/finalizar/{EventId}", null);
        yaVotadoEnEvento = true;
        publicoMostrarVotacion = false;
    }

