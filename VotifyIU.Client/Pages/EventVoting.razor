    private void OpenContentModal(Project project)
    {
        modalProjectName = project.Name;
        modalProjectId = project.Id;
        // add cache busting param so updated image is fetched after upload
        modalImageVersion = DateTime.UtcNow.Ticks;
        showContentModal = true;
    }

    private void CloseContentModal()
    {
        showContentModal = false;
        modalProjectName = string.Empty;
    }

    private async Task OnSelectedFile(InputFileChangeEventArgs e, string projectId)
    {
        uploadMessage = string.Empty;
        var file = e.File;
        if (file == null)
        {
            uploadMessage = "No se seleccionó archivo.";
            return;
        }

        if (!string.Equals(file.ContentType, "image/png", StringComparison.OrdinalIgnoreCase))
        {
            uploadMessage = "Solo se permiten archivos PNG.";
            return;
        }

        // store pending file and build preview
        pendingFile = file;
        pendingProjectId = projectId;

        try
        {
            using var ms = new MemoryStream();
            await file.OpenReadStream(10 * 1024 * 1024).CopyToAsync(ms);
            var bytes = ms.ToArray();
            previewImageUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(bytes)}";
            // show confirmation modal
            showUploadConfirm = true;
        }
        catch (Exception ex)
        {
            uploadMessage = "Error al leer fichero: " + ex.Message;
        }
    }

    private async Task ConfirmUploadAsync()
    {
        uploadMessage = string.Empty;
        if (pendingFile == null || string.IsNullOrEmpty(pendingProjectId))
        {
            uploadMessage = "No hay fichero pendiente.";
            showUploadConfirm = false;
            previewImageUrl = string.Empty;
            return;
        }

        try
        {
            var content = new MultipartFormDataContent();
            var stream = pendingFile.OpenReadStream(10 * 1024 * 1024);
            var sc = new StreamContent(stream);
            sc.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(pendingFile.ContentType);
            content.Add(sc, "file", $"{pendingProjectId}.png");

            var resp = await Http.PostAsync($"/api/projects/{pendingProjectId}/content", content);
            if (resp.IsSuccessStatusCode)
            {
                uploadMessage = "Contenido subido correctamente.";
                // bump image version so modal image fetches fresh copy
                modalImageVersion = DateTime.UtcNow.Ticks;
                // open modal to show uploaded content
                modalProjectId = pendingProjectId!;
                var proj = mockProjects.FirstOrDefault(p => p.Id == modalProjectId);
                modalProjectName = proj?.Name ?? string.Empty;
                showContentModal = true;
            }
            else
            {
                uploadMessage = $"Error al subir contenido ({(int)resp.StatusCode}).";
            }
        }
        catch (Exception ex)
        {
            uploadMessage = "Error al subir: " + ex.Message;
        }

        // clear pending
        pendingFile = null;
        pendingProjectId = null;
        previewImageUrl = string.Empty;
        showUploadConfirm = false;
    }

    private async Task DeleteProjectContentAsync(string projectId)
    {
        uploadMessage = string.Empty;
        try
        {
            var resp = await Http.DeleteAsync($"/api/projects/{projectId}/content");
            if (resp.IsSuccessStatusCode)
            {
                uploadMessage = "Contenido eliminado correctamente.";
                // clear preview if it was the same project
                if (pendingProjectId == projectId)
                {
                    pendingFile = null;
                    pendingProjectId = null;
                    previewImageUrl = string.Empty;
                    showUploadConfirm = false;
                }
                // update modal image version so modal shows fallback
                modalImageVersion = DateTime.UtcNow.Ticks;
                // open modal to show fallback message
                var proj = mockProjects.FirstOrDefault(p => p.Id == projectId);
                modalProjectName = proj?.Name ?? string.Empty;
                modalProjectId = projectId;
                showContentModal = true;
            }
            else if (resp.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                // If no image, open modal to inform
                var proj = mockProjects.FirstOrDefault(p => p.Id == projectId);
                modalProjectName = proj?.Name ?? string.Empty;
                modalProjectId = projectId;
                showContentModal = true;
                uploadMessage = "No existe contenido para eliminar.";
            }
            else
            {
                int status = (int)resp.StatusCode;
                uploadMessage = $"Error al eliminar contenido ({status}).";
                
            }
        }
        catch (Exception ex)
        {
            uploadMessage = "Error al eliminar: " + ex.Message;
        }
    }

    private void CancelUpload()
    {
        pendingFile = null;
        pendingProjectId = null;
        previewImageUrl = string.Empty;
        uploadMessage = "Carga cancelada.";
        showUploadConfirm = false;
    }

    private void ShowDeleteConfirm(string projectId, string projectName)
    {
        deleteProjectId = projectId;
        deleteProjectName = projectName;
        showDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        deleteProjectId = string.Empty;
        deleteProjectName = string.Empty;
        showDeleteConfirm = false;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (string.IsNullOrEmpty(deleteProjectId))
        {
            uploadMessage = "Proyecto inválido.";
            showDeleteConfirm = false;
            return;
        }

        try
        {
            var resp = await Http.DeleteAsync($"/api/projects/{deleteProjectId}/content");
            if (resp.IsSuccessStatusCode)
            {
                uploadMessage = "Contenido eliminado correctamente.";
                // bump version so modal image will not show cached deleted image
                modalImageVersion = DateTime.UtcNow.Ticks;
            }
            else if (resp.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                uploadMessage = "No existe contenido para eliminar.";
            }
            else
            {
                uploadMessage = $"Error al eliminar contenido ({(int)resp.StatusCode}).";
            }
        }
        catch (Exception ex)
        {
            uploadMessage = "Error al eliminar: " + ex.Message;
        }

        // close confirmation
        showDeleteConfirm = false;
        deleteProjectId = string.Empty;
        deleteProjectName = string.Empty;
        // clear any pending upload preview for the same project
        if (pendingProjectId == deleteProjectId)
        {
            pendingFile = null;
            pendingProjectId = null;
            previewImageUrl = string.Empty;
            showUploadConfirm = false;
        }
    }
    private void ToggleEditMode(string criterionId)
    {
        if (editingCriteria.Contains(criterionId))
            editingCriteria.Remove(criterionId);
        else
            editingCriteria.Add(criterionId);
    }
    private double GetScore(string criterionId)
    {
        string key = $"{mockProjects[currentProjectIndex].Id}-{criterionId}";
        return scores.ContainsKey(key) ? scores[key] : 5.0;
    }
    private void HandleScoreChange(string criterionId, string? val)
    {
        if (double.TryParse(val, out double result))
        {
            string key = $"{mockProjects[currentProjectIndex].Id}-{criterionId}";
            result = Math.Clamp(result, 0, 10);
            result = Math.Round(result, 2);
            scores[key] = result;
        }
    }
    private string CalculateTotalScore()
    {
        double total = 0;
        var currentId = mockProjects[currentProjectIndex].Id;
        foreach (var c in mockCriteria)
        {
            total += (GetScore(c.Id) * c.Weight) / 100;
        }
        return total.ToString("F1");
    }
    private double GetProgress() => (votedProjects.Count / (double)mockProjects.Count) * 100;
    private int NonVotedCount => mockProjects.Count(p => !votedProjects.Contains(p.Id));
    private int NonVotedRemainingExcludingCurrent => mockProjects.Count(p => !votedProjects.Contains(p.Id) && p.Id != mockProjects[currentProjectIndex].Id);
    private bool IsLastProject => currentProjectIndex == mockProjects.Count - 1;
    private async Task SubmitVote()
    {
        // Limitar a 3 votaciones por evento
        if (votesSubmitted >= 3)
        {
            // opcional: mostrar mensaje o redirigir al dashboard
            NavigationManager.NavigateTo("/dashboard");
            return; 
        }

        votedProjects.Add(mockProjects[currentProjectIndex].Id);
        votesSubmitted++;

        if (votesSubmitted >= 3)
        {
            // Al alcanzar el límite, finalizar y volver al dashboard
            await Http.PostAsync($"/api/votos/finalizar/{EventId}", null);
            NavigationManager.NavigateTo("/dashboard");
            return;
        }

        // Si es el último proyecto de la lista, finalizar la votación tras votar
        if (IsLastProject)
        {
            await Http.PostAsync($"/api/votos/finalizar/{EventId}", null);
            NavigationManager.NavigateTo("/dashboard");
            return;
        }

        if (currentProjectIndex < mockProjects.Count - 1)
        {
            currentProjectIndex++;
            comments = "";
        }
        else
        {
            // Fallback: finalizar
            await Http.PostAsync($"/api/votos/finalizar/{EventId}", null);
            NavigationManager.NavigateTo("/dashboard");
        }
    }

    private async Task FinalizeVotingAsync()
    {
        try
        {
            await Http.PostAsync($"/api/votos/finalizar/{EventId}", null);
        }
        catch
        {
            // Ignorar errores en finalización del ejemplo
        }
        NavigationManager.NavigateTo("/dashboard");
    }

    private async Task SkipNext()
    {
        // Solo finalizar si el proyecto actual es el último de la lista.
        if (IsLastProject)
        {
            await FinalizeVotingAsync();
            return;
        }

        // Buscar siguiente proyecto no votado; si no hay, avanzar al siguiente índice hasta el final
        int nextIndex = currentProjectIndex + 1;
        while (nextIndex < mockProjects.Count && votedProjects.Contains(mockProjects[nextIndex].Id))
        {
            nextIndex++;
        }

        if (nextIndex < mockProjects.Count)
        {
            currentProjectIndex = nextIndex;
            return;
        }

        // No se encontró proyecto no votado después: mover al último proyecto disponible (sin finalizar)
        currentProjectIndex = mockProjects.Count - 1;
    }
    private void NavigateNext()
    {
        if (currentProjectIndex < mockProjects.Count - 1)
            currentProjectIndex++;
    }
    private void PreviousProject() => currentProjectIndex--;
