@page "/event-voting/{EventId}"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using Votify.shared
@using System.Linq
@using Microsoft.AspNetCore.Components.Forms
@layout EmptyLayout
@inject NavigationManager NavigationManager
@inject HttpClient Http
@inject IJSRuntime JS
@inject INavigationHistoryService Historial
<style>
    input[type=number]::-webkit-inner-spin-button,
    input[type=number]::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
    input[type=number] { -moz-appearance: textfield; }

</style>
<div class="min-h-screen bg-gradient-to-br from-[#E9EFE1] to-[#B5D6AC]">
    <header class="bg-white shadow-sm border-b border-[#B5D6AC]">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 grid grid-cols-3 items-center">
            <div></div>
            <div class="flex items-center justify-center gap-4">
                <img src="imagenes/logo-votify.png" alt="Votify" class="h-16 object-contain" />
                <div class="text-center">
                    <h1 class="text-xl font-bold text-[#1A281B]">Evento: @NombreEventoActual</h1>
                    <p class="text-sm font-medium text-[#6C8A6C]">Votación: @NombreVotacionActual</p>
                </div>
            </div>
            <div class="flex justify-end items-center gap-2 text-[#4C6B4F]">
                @if (EstaEnVistaDetalle)
                {
                    <span class="font-medium">Proyecto @(currentProjectIndex + 1) de @mockProjects.Count</span>
                }
            </div>
        </div>
    </header>
    <main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        @if (cargando)
        {
            <div class="flex justify-center items-center py-24">
                <div class="w-10 h-10 border-4 border-[#6C8A6C] border-t-transparent rounded-full animate-spin"></div>
            </div>
        }
        else if (avisoSinDatos != null && (Rol == "JURADO" || Rol == "PUBLICO"))
        {
            <div class="bg-white rounded-2xl shadow-xl p-8 text-center">
                <div class="text-5xl mb-4">📋</div>
                <p class="text-xl font-bold text-[#1A281B] mb-2">Sin proyectos disponibles</p>
                <p class="text-[#6C8A6C]">@avisoSinDatos</p>
                <button type="button" @onclick="VolverAtras" class="mt-6 inline-block bg-gradient-to-r from-[#6C8A6C] to-[#4C6B4F] text-white px-6 py-3 rounded-xl font-bold">
                    Volver
                </button>
            </div>
        }

    
        else if (Rol == "JURADO" || Rol == "PUBLICO")
        {
            @if (Rol == "JURADO" && yaVotadoEnEvento)
            {
                <div class="bg-white rounded-2xl shadow-xl p-8 text-center">
                    <p class="text-2xl font-bold text-[#1A281B] mb-2">Ya has votado en este evento</p>
                    <p class="text-[#6C8A6C]">Tu evaluación ya fue registrada. No puedes volver a votar.</p>
                    <button type="button" @onclick="VolverAtras" class="mt-6 inline-block bg-gradient-to-r from-[#6C8A6C] to-[#4C6B4F] text-white px-6 py-3 rounded-xl font-bold">
                        Volver
                    </button>
                </div>
            }
            else if (!EstaEnVistaDetalle)
            {
                <div class="mb-6">
                    <div class="flex justify-between items-center mb-2">
                        <div class="flex items-center gap-4">
                            <span class="text-sm text-[#4C6B4F]">Progreso de votación</span>
                            <span class="text-sm text-[#4C6B4F]">@votedProjects.Count/@mockProjects.Count proyectos evaluados</span>
                            <span class="text-sm text-[#4C6B4F]">• Votos realizados: @(Rol == "JURADO" ? $"{votesSubmitted}/3" : $"{votesSubmitted}/{mockProjects.Count}")</span>
                        </div>
                    </div>
                    <div class="w-full bg-white rounded-full h-2 overflow-hidden">
                        <div class="bg-gradient-to-r from-[#6C8A6C] to-[#70D939] h-full transition-all duration-300"
                             style="width: @(GetProgress() + "%")">
                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-2xl shadow-xl p-8 mb-6">
                    <h2 class="text-2xl font-bold text-[#1A281B] mb-2">Proyectos del evento</h2>
                    <p class="text-[#6C8A6C] mb-6">Selecciona el proyecto que quieras votar. Puedes votar los proyectos en el orden que prefieras.</p>

                    @if (mockProjects.Count == 0)
                    {
                        <div class="p-4 bg-[#F8FAF7] border border-[#B5D6AC] rounded-lg text-sm text-[#6C8A6C]">
                            No hay proyectos disponibles para votar en este evento.
                        </div>
                    }
                    else
                    {
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                            @foreach (var proyectoLista in mockProjects)
                            {
                                bool yaVotado = votedProjects.Contains(proyectoLista.Id);
                                <button @onclick="() => AbrirProyectoParaVotar(proyectoLista.Id)"
                                        class="relative text-left bg-[#F8FAF7] border border-[#B5D6AC]/40 rounded-xl p-5 hover:shadow-md hover:border-[#6C8A6C] transition-all">
                                    @if (yaVotado)
                                    {
                                        <span class="absolute top-3 right-3 text-xs font-bold text-white bg-[#6C8A6C] px-2 py-1 rounded-full">★ Votado</span>
                                    }
                                    else
                                    {
                                        <span class="absolute top-3 right-3 text-xs font-bold text-[#6C8A6C] bg-white border border-[#B5D6AC] px-2 py-1 rounded-full">Sin votar</span>
                                    }
                                    <h3 class="text-lg font-bold text-[#1A281B] mb-2 pr-24">@proyectoLista.Name</h3>
                                    <p class="text-sm text-[#6C8A6C] mb-2">Equipo: @proyectoLista.Team</p>
                                    <span class="inline-block px-2 py-1 bg-[#E9EFE1] text-[#4C6B4F] rounded-full text-xs">
                                        @proyectoLista.Category
                                    </span>
                                </button>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="mb-6">
                    <div class="flex justify-between items-center mb-2">
                        <div class="flex items-center gap-4">
                            <span class="text-sm text-[#4C6B4F]">Progreso de votación</span>
                            <span class="text-sm text-[#4C6B4F]">@votedProjects.Count/@mockProjects.Count proyectos evaluados</span>
                            <span class="text-sm text-[#4C6B4F]">• Votos realizados: @(Rol == "JURADO" ? $"{votesSubmitted}/3" : $"{votesSubmitted}/{mockProjects.Count}")</span>
                        </div>
                    </div>
                    <div class="w-full bg-white rounded-full h-2 overflow-hidden">
                        <div class="bg-gradient-to-r from-[#6C8A6C] to-[#70D939] h-full transition-all duration-300"
                        style="width: @(GetProgress() + "%")">
                        </div>
                    </div>
                </div>
                <div class="bg-white rounded-2xl shadow-xl p-8 mb-6">
                    @{
                        var project = mockProjects[currentProjectIndex];
                    }
                    <div class="mb-6">
                        <div class="flex items-start justify-between mb-4">
                            <div>
                                <div class="flex items-center gap-3">
                                    <h2 class="text-3xl font-bold text-[#1A281B] mb-2">@project.Name</h2>
                                    <button @onclick="() => ViewProjectMedia(project)" class="px-3 py-1 bg-[#6C8A6C] text-white rounded-md text-sm">Ver contenido</button>
                                </div>
                                <p class="text-[#6C8A6C] mb-1">Equipo: @project.Team</p>
                                <span class="inline-block px-3 py-1 bg-[#E9EFE1] text-[#4C6B4F] rounded-full text-sm">
                                    @project.Category
                                </span>
                            </div>
                            @if (votedProjects.Contains(project.Id))
                            {
                                <div class="flex items-center gap-2 text-[#70D939] bg-[#E9EFE1] px-3 py-1 rounded-full">
                                    <span class="text-sm font-bold">★ Votado</span>
                                </div>
                            }
                        </div>
                        <p class="text-[#4C6B4F] leading-relaxed">@project.Description</p>
                    </div>
                    <div class="space-y-6 mb-6">
                        <h3 class="text-xl font-bold text-[#1A281B] flex items-center gap-2">
                            <Icon Name="star" CssClass="w-5 h-5 text-[#6C8A6C]" />
                            Criterios de Evaluación
                        </h3>
                        @foreach (var criterion in mockCriteria)
                        {
                            <div class="bg-[#EFEFEE] rounded-xl p-6">
                                <div class="flex items-center justify-between mb-3">
                                    <div class="flex-1 flex items-start gap-3">
                                        <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-[#6C8A6C]/15 flex items-center justify-center text-[#4C6B4F]">
                                            <Icon Name="@IconoParaCriterio(criterion.Name)" CssClass="w-5 h-5" />
                                        </div>
                                        <div class="flex-1">
                                            <label class="text-[#1A281B] text-base font-bold">
                                                @criterion.Name
                                                <span class="text-[#6C8A6C] ml-2 text-sm font-normal">(Peso: @criterion.Weight%)</span>
                                            </label>
                                            <p class="text-sm text-[#6C8A6C] mt-1">@criterion.Description</p>
                                        </div>
                                    </div>
                                    <div class="ml-4 text-right">
                                        @if (editingCriteria.Contains(criterion.Id))
                                        {
                                            <input type="number"
                                            min="0" max="10" step="0.01"
                                            value="@GetScore(criterion.Id)"
                                            @onchange="(e) => HandleScoreChange(criterion.Id, e.Value?.ToString())"
                                            @onblur="() => ToggleEditMode(criterion.Id)"
                                            class="text-3xl font-bold text-[#6C8A6C] w-20 bg-[#E9EFE1] border-b-2 border-[#B5D6AC] outline-none text-right" />
                                        }
                                        else if (votedProjects.Contains(project.Id))
                                        {
                                            <span class="text-3xl font-bold text-[#6C8A6C]">
                                                @GetScore(criterion.Id)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-3xl font-bold text-[#6C8A6C] cursor-pointer"
                                            @onclick="() => ToggleEditMode(criterion.Id)">
                                                @GetScore(criterion.Id)
                                            </span>
                                        }
                                        <span class="text-[#A6AAA9]">/10</span>
                                    </div>
                                </div>
                                <input type="range"
                                min="0" max="10" step="0.5"
                                value="@GetScore(criterion.Id)"
                                disabled="@votedProjects.Contains(project.Id)"
                                @oninput="(e) => HandleScoreChange(criterion.Id, e.Value?.ToString())"
                                class="w-full h-2 bg-[#E9EFE1] rounded-lg appearance-none cursor-pointer accent-[#6C8A6C] my-4" />
                                <div class="flex justify-between text-xs text-[#A6AAA9]">
                                    <span>0 - Muy bajo</span>
                                    <span>5 - Promedio</span>
                                    <span>10 - Excelente</span>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="bg-gradient-to-r from-[#6C8A6C] to-[#70D939] rounded-xl p-6 mb-6 shadow-md">
                        <div class="flex items-center justify-between text-white font-bold">
                            <span class="text-lg">Puntuación Total Ponderada</span>
                            <span class="text-4xl">@CalculateTotalScore()/10</span>
                        </div>
                    </div>
                    <div class="mb-6">
                        <label for="comments" class="text-[#1A281B] font-bold mb-2 block">Comentarios (opcional)</label>
                        <div class="relative">
                            <textarea value="@comments"
                                      @oninput="(e) => { comments = e.Value?.ToString() ?? string.Empty; commentLength = comments.Length; }"
                                      maxlength="500"
                                      placeholder="Comparte tus observaciones sobre el proyecto..."
                                      class="w-full min-h-[120px] p-4 rounded-xl bg-[#E9EFE1] border border-[#B5D6AC] focus:outline-none focus:border-[#6C8A6C] outline-none transition-all"></textarea>
                            <span class="absolute bottom-2 right-3 text-xs text-[#A6AAA9]">@commentLength/500</span>
                        </div>
                    </div>
                    <button @onclick="AbrirConfirmacionVoto"
                            class="w-full bg-gradient-to-r from-[#6C8A6C] to-[#4C6B4F] text-white py-4 rounded-xl font-bold shadow-lg hover:opacity-90 transition-opacity">
                        Enviar voto
                    </button>

                    <div class="mt-4 flex items-center gap-3">
                        <button @onclick="VolverAListaJurado"
                                class="px-4 py-2 border border-[#6C8A6C] text-[#6C8A6C] rounded-lg font-semibold hover:bg-[#F8FAF7]">
                            ← Volver a la lista
                        </button>
                    </div>
                </div>

                @if (mostrandoConfirmacionVoto)
                {
                    var proyectoConfirmacion = mockProjects[currentProjectIndex];
                    <div class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4">
                        <div class="bg-white rounded-2xl shadow-2xl max-w-lg w-full max-h-[90vh] overflow-y-auto">
                            <div class="p-6 border-b border-[#B5D6AC]">
                                <h3 class="text-xl font-bold text-[#1A281B]">Confirmar voto</h3>
                                <p class="text-sm text-[#6C8A6C] mt-1">Revisa tu evaluación de <span class="font-semibold">@proyectoConfirmacion.Name</span> antes de enviarla.</p>
                            </div>
                            <div class="p-6 space-y-3">
                                @foreach (var criterion in mockCriteria)
                                {
                                    <div class="flex items-center justify-between bg-[#F8FAF7] rounded-lg px-4 py-3">
                                        <span class="text-sm font-medium text-[#1A281B]">@criterion.Name</span>
                                        <span class="text-lg font-bold text-[#6C8A6C]">@GetScore(criterion.Id)<span class="text-sm text-[#A6AAA9]">/10</span></span>
                                    </div>
                                }
                                <div class="flex items-center justify-between bg-gradient-to-r from-[#6C8A6C] to-[#70D939] rounded-lg px-4 py-3 text-white">
                                    <span class="text-sm font-bold">Puntuación total ponderada</span>
                                    <span class="text-xl font-bold">@CalculateTotalScore()/10</span>
                                </div>
                                <div class="pt-2">
                                    <p class="text-xs font-semibold text-[#4C6B4F] mb-1">Comentario</p>
                                    <p class="text-sm text-[#1A281B] bg-[#F8FAF7] rounded-lg px-4 py-3 border border-[#B5D6AC]/40 whitespace-pre-wrap">
                                        @(string.IsNullOrWhiteSpace(comments) ? "(sin comentario)" : comments)
                                    </p>
                                </div>
                            </div>
                            <div class="p-6 border-t border-[#B5D6AC] flex flex-col sm:flex-row gap-3">
                                <button @onclick="CerrarConfirmacionVoto"
                                        class="flex-1 px-4 py-3 border border-[#6C8A6C] text-[#6C8A6C] rounded-xl font-semibold hover:bg-[#F8FAF7]">
                                    Cancelar
                                </button>
                                <button @onclick="ConfirmarYEnviarVoto" disabled="@enviandoVoto"
                                        class="flex-1 px-4 py-3 bg-gradient-to-r from-[#6C8A6C] to-[#4C6B4F] text-white rounded-xl font-bold hover:opacity-90 disabled:opacity-50">
                                    @(enviandoVoto ? "Enviando..." : "Confirmar y enviar")
                                </button>
                            </div>
                        </div>
                    </div>
                }

                @if (mostrandoExitoVoto)
                {
                    var proyectoVotado = mockProjects[currentProjectIndex];
                    <div class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4">
                        <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full text-center p-8">
                            <div class="w-24 h-24 rounded-full bg-[#70D939] flex items-center justify-center mx-auto mb-6 shadow-lg">
                                <svg class="w-14 h-14 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                                </svg>
                            </div>
                            <h3 class="text-3xl font-bold text-[#1A281B] mb-3">¡Voto Registrado!</h3>
                            <p class="text-[#6C8A6C] mb-1">
                                Tu voto para <span class="font-bold text-[#1A281B]">@proyectoVotado.Name</span> ha sido registrado exitosamente.
                            </p>
                            <p class="text-[#6C8A6C] mb-6">
                                Puntuación total: <span class="font-bold">@CalculateTotalScore()/10</span>
                            </p>
                            <button @onclick="CerrarExitoYContinuar"
                                    class="w-full px-4 py-4 bg-gradient-to-r from-[#6C8A6C] to-[#4C6B4F] text-white rounded-xl font-bold hover:opacity-90 flex items-center justify-center gap-2">
                                Continuar al Siguiente Proyecto
                                <span class="text-xl leading-none">›</span>
                            </button>
                            <p class="text-sm text-[#A6AAA9] mt-4">
                                Progreso: @votedProjects.Count/@mockProjects.Count proyectos evaluados
                            </p>
                        </div>
                    </div>
                }
            }
        }
        else if (Rol == "COMPETIDOR")
        {
            <div class="bg-white rounded-2xl shadow-xl p-8 mb-6 text-center">
                <div class="w-20 h-20 rounded-full bg-gradient-to-br from-[#E9EFE1] to-[#B5D6AC] flex items-center justify-center mx-auto mb-4 text-4xl">🚀</div>
                @if (miProyectoCompetidor == null)
                {
                    <h2 class="text-2xl font-bold text-[#1A281B] mb-2">Presenta tu proyecto</h2>
                    <p class="text-[#6C8A6C] mb-6">Envía tu proyecto para la categoría <span class="font-bold">@CategoriaActual</span>. La imagen es opcional y podrás subirla después.</p>
                    <div class="bg-[#E9EFE1] rounded-xl p-6 mb-6 text-left max-w-2xl mx-auto">
                        <div class="space-y-4">
                            <div>
                                <label class="text-sm font-medium text-[#4C6B4F] block mb-1">Nombre del proyecto *</label>
                                <input @bind="nuevoProyectoCompetidorNombre"
                                       class="w-full px-4 py-2 rounded-lg bg-white border border-[#B5D6AC] focus:outline-none focus:border-[#6C8A6C] text-[#1A281B]" />
                            </div>
                            <div>
                                <label class="text-sm font-medium text-[#4C6B4F] block mb-1">Descripción *</label>
                                <textarea @bind="nuevoProyectoCompetidorDescripcion"
                                          class="w-full px-4 py-2 rounded-lg bg-white border border-[#B5D6AC] focus:outline-none focus:border-[#6C8A6C] text-[#1A281B] min-h-[120px]"></textarea>
                            </div>
                            <div>
                                <label class="text-sm font-medium text-[#4C6B4F] block mb-1">Imagen del proyecto (opcional)</label>
                                <div class="flex items-center gap-3">
                                    <label class="px-4 py-2 bg-white border border-[#B5D6AC] rounded-lg text-sm font-semibold text-[#4C6B4F] cursor-pointer hover:bg-[#F8FAF7] transition-colors">
                                        @(procesandoNuevaImagen ? "Procesando..." : "Seleccionar imagen")
                                        <InputFile OnChange="OnNuevoProyectoImageChange" accept="image/*" style="display:none" />
                                    </label>
                                    @if (!string.IsNullOrWhiteSpace(nuevaImagenProyectoPreview))
                                    {
                                        <span class="text-xs text-[#6C8A6C]">Imagen lista para subir</span>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(nuevaImagenProyectoPreview))
                                {
                                    <div class="mt-2 p-2 bg-white border border-[#B5D6AC] rounded-lg">
                                        <img src="@nuevaImagenProyectoPreview" alt="Vista previa" class="max-h-28 mx-auto" />
                                    </div>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(errorProyectoCompetidor))
                            {
                                <p class="text-red-500 text-sm font-medium">⚠️ @errorProyectoCompetidor</p>
                            }
                            <div class="flex flex-col sm:flex-row gap-3 pt-2">
                                <button @onclick="CrearProyectoCompetidorAsync" disabled="@creandoProyectoCompetidor"
                                        class="bg-gradient-to-r from-[#6C8A6C] to-[#4C6B4F] text-white px-6 py-3 rounded-xl font-bold hover:opacity-90 transition-opacity disabled:opacity-50">
                                    @(creandoProyectoCompetidor ? "Guardando..." : "Presentar proyecto")
                                </button>
                                <button type="button" @onclick="VolverAtras"
                                        class="px-6 py-3 border-2 border-[#6C8A6C] text-[#6C8A6C] rounded-xl font-bold hover:bg-[#F8FAF7] transition-colors text-center">
                                    Volver
                                </button>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <h2 class="text-2xl font-bold text-[#1A281B] mb-2">Tu proyecto está siendo evaluado</h2>
                    <p class="text-[#6C8A6C] mb-6">Los jurados están revisando tu trabajo ahora mismo. Los resultados estarán disponibles al terminar la votación.</p>
                    <div class="bg-[#E9EFE1] rounded-xl p-6 mb-6 text-left">
                        <h3 class="text-lg font-bold text-[#1A281B] mb-3">Tu proyecto</h3>
                        @{var myProj = miProyectoCompetidor;}
                        <p class="text-xl font-bold text-[#4C6B4F]">@myProj!.Name</p>
                        <p class="text-sm text-[#6C8A6C]">Equipo: @myProj.Team</p>
                        <span class="inline-block mt-2 px-3 py-1 bg-white text-[#4C6B4F] rounded-full text-xs font-bold">@myProj.Category</span>
                        <p class="text-sm text-[#4C6B4F] mt-3 leading-relaxed">@myProj.Description</p>

                        <div class="mt-4">
                            <h4 class="text-sm font-bold text-[#1A281B] mb-2">Contenido del proyecto</h4>
                            @if (cargandoImagen)
                            {
                                <div class="flex justify-center items-center py-6">
                                    <div class="w-8 h-8 border-4 border-[#6C8A6C] border-t-transparent rounded-full animate-spin"></div>
                                </div>
                            }
                            else if (!hasProjectImage)
                            {
                                <div class="p-4 bg-white rounded-lg border border-[#B5D6AC] text-sm text-[#6C8A6C]">No hay contenido subido.</div>
                            }
                            else
                            {
                                <div class="p-4 bg-white rounded-lg border border-[#B5D6AC]">
                                    <img src="@imagenDataUrl" alt="Contenido" class="max-h-48 mx-auto" />
                                </div>
                            }

                            <div class="mt-3 flex gap-2 items-center">
                                <label class="px-4 py-2 bg-gradient-to-r from-[#6C8A6C] to-[#70D939] text-white rounded-xl font-bold cursor-pointer">
                                    Subir Contenido
                                    <InputFile OnChange="OnInputFileChange" accept="image/*" style="display:none" />
                                </label>
                                <div class="flex-1"></div>
                                <button @onclick="() => MostrarImagenModal()" disabled="@(!hasProjectImage)"
                                        class="px-4 py-2 bg-[#6C8A6C] text-white rounded-xl font-bold disabled:opacity-40 disabled:cursor-not-allowed">Visualizar Contenido</button>
                                <button @onclick="() => confirmEliminarImagen = true" disabled="@(!hasProjectImage)"
                                        class="px-4 py-2 bg-red-500 text-white rounded-xl font-bold disabled:opacity-40 disabled:cursor-not-allowed">Eliminar Contenido</button>
                            </div>
                        </div>

                        <div class="mt-4">
                            <button @onclick="IrAComentariosProyecto"
                                    class="w-full md:w-auto px-5 py-3 bg-white border-2 border-[#6C8A6C] text-[#6C8A6C] rounded-xl font-bold hover:bg-[#E9EFE1] transition-colors">
                                Ver comentarios del proyecto
                            </button>
                        </div>
                    </div>
                    <div class="flex items-center justify-center gap-3 text-[#6C8A6C]">
                        <div class="w-3 h-3 rounded-full bg-[#6C8A6C] animate-bounce" style="animation-delay:0s"></div>
                        <div class="w-3 h-3 rounded-full bg-[#6C8A6C] animate-bounce" style="animation-delay:0.2s"></div>
                        <div class="w-3 h-3 rounded-full bg-[#6C8A6C] animate-bounce" style="animation-delay:0.4s"></div>
                        <span class="text-sm font-medium ml-2">Votación en curso</span>
                    </div>
                }
            </div>
        }
        else if (Rol == "ORGANIZADOR")
        {
            <div class="bg-white rounded-2xl shadow-xl p-8 mb-6">
                <div class="flex items-center justify-between mb-6">
                    <h2 class="text-xl font-bold text-[#1A281B]">Control de votación</h2>
                    <span class="px-4 py-2 @(votacionCerrada ? "bg-red-500" : votacionPausada ? "bg-[#90A896]" : "bg-[#6C8A6C]") text-white text-sm font-bold rounded-full">
                        @(votacionCerrada ? "■ Votación cerrada" : votacionPausada ? "⏸ Pausada" : "● Votación abierta")
                    </span>
                </div>
                <div class="grid grid-cols-2 gap-4 mb-6">
                    <button @onclick="TogglePausa" disabled="@(gestionando || votacionCerrada)"
                            class="@(votacionCerrada
                                        ? "bg-[#EFEFEE] text-[#A6AAA9] py-4 rounded-xl font-bold cursor-not-allowed"
                                        : votacionPausada
                                        ? "bg-white border-2 border-[#6C8A6C] text-[#6C8A6C] py-4 rounded-xl font-bold hover:bg-[#E9EFE1] transition-colors disabled:opacity-50"
                                        : "bg-gradient-to-r from-[#6C8A6C] to-[#4C6B4F] text-white py-4 rounded-xl font-bold hover:opacity-90 transition-opacity disabled:opacity-50")">
                        @(gestionando ? "..." : votacionCerrada ? "Votación cerrada" : votacionPausada ? "▶ Reanudar votación" : "⏸ Pausar votación")
                    </button>
                    <button @onclick="MostrarConfirmCierre" disabled="@(gestionando || votacionCerrada)"
                            class="bg-red-50 border-2 border-red-300 text-red-500 py-4 rounded-xl font-bold hover:bg-red-100 transition-colors disabled:opacity-50">
                        ⏹ Cerrar votación
                    </button>
                </div>

                @if (votacionCerrada)
                {
                    <div class="bg-red-50 border border-red-200 rounded-xl p-4 mb-4">
                        <p class="text-red-700 font-medium text-sm">La votación está cerrada definitivamente. Ya no puede reanudarse ni recibir nuevos votos.</p>
                    </div>
                }
                else if (confirmarCierre)
                {
                    <div class="bg-red-50 border border-red-200 rounded-xl p-4 mb-4">
                        <p class="text-red-700 font-medium mb-3 text-sm">¿Cerrar definitivamente? Esta acción no se puede deshacer.</p>
                        <div class="flex gap-3">
                            <button @onclick="CerrarVotacion" disabled="@gestionando"
                                    class="bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded-lg font-bold text-sm disabled:opacity-50">
                                @(gestionando ? "Cerrando..." : "Sí, cerrar")
                            </button>
                            <button @onclick="OcultarConfirmCierre"
                                    class="border border-gray-300 text-gray-500 px-4 py-2 rounded-lg text-sm hover:bg-gray-50">
                                Cancelar
                            </button>
                        </div>
                    </div>
                }

                @if (mensajeGestion != null)
                {
                    <div class="mb-4 p-3 @(errorGestion ? "bg-red-100 text-red-700" : "bg-green-100 text-green-700") rounded-xl text-sm text-center">
                        @mensajeGestion
                    </div>
                }
            </div>
            <!-- Eliminar evento -->
            <div class="flex justify-end mb-4">
                <button @onclick="() => mostrarConfirmEliminarEvento = !mostrarConfirmEliminarEvento"
                        class="inline-flex items-center gap-2 border border-red-400 text-red-600 px-4 py-2 rounded-lg font-medium text-sm hover:bg-red-50 transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M1 7h22M9 7V4a1 1 0 011-1h4a1 1 0 011 1v3" />
                    </svg>
                    Eliminar evento
                </button>
            </div>
            @if (mostrarConfirmEliminarEvento)
            {
                <div class="bg-red-50 border border-red-200 rounded-xl p-4 mb-4">
                    <p class="text-red-700 font-medium mb-3 text-sm">¿Eliminar este evento? Se borrarán todos los proyectos y votos de forma permanente.</p>
                    <div class="flex gap-3">
                        <button @onclick="EliminarEvento" disabled="@eliminandoEvento"
                                class="bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded-lg font-bold text-sm transition-colors disabled:opacity-50">
                            @(eliminandoEvento ? "Eliminando..." : "Sí, eliminar")
                        </button>
                        <button @onclick="() => mostrarConfirmEliminarEvento = false"
                                class="border border-gray-300 text-gray-500 px-4 py-2 rounded-lg text-sm hover:bg-gray-50 transition-colors">
                            Cancelar
                        </button>
                    </div>
                    @if (errorEliminarEvento != null)
                    {
                        <p class="text-red-500 text-sm mt-2">⚠️ @errorEliminarEvento</p>
                    }
                </div>
            }
            <div class="bg-white rounded-2xl shadow-xl p-8 mb-6">
                <!-- Stats -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                    <div class="bg-white rounded-xl p-5 shadow-sm flex items-center gap-4">
                        <div class="w-12 h-12 rounded-full bg-gradient-to-br from-[#6C8A6C] to-[#70D939] flex items-center justify-center text-white text-xl">🏆</div>
                        <div>
                            <p class="text-xs text-[#6C8A6C] font-medium">Proyectos registrados</p>
                            <p class="text-2xl font-bold text-[#1A281B]">@proyectosOrganizador.Count</p>
                        </div>
                    </div>
                    <div class="bg-white rounded-xl p-5 shadow-sm flex items-center gap-4">
                        <div class="w-12 h-12 rounded-full bg-gradient-to-br from-[#6C8A6C] to-[#70D939] flex items-center justify-center text-white text-xl">👥</div>
                        <div>
                            <p class="text-xs text-[#6C8A6C] font-medium">Competidores</p>
                            <p class="text-2xl font-bold text-[#1A281B]">@proyectosOrganizador.Select(p => p.Competidor).Distinct().Count()</p>
                        </div>
                    </div>
                </div>

                <!-- Proyectos -->
                <div class="bg-white rounded-2xl shadow-xl p-8 mb-6">
                    <div class="flex items-center justify-between mb-4">
                        <h2 class="text-xl font-bold text-[#1A281B]">Proyectos registrados</h2>
                        <button @onclick="() => { mostrarFormProyecto = !mostrarFormProyecto; editandoProyectoId = null; confirmEliminarProyectoId = null; }"
