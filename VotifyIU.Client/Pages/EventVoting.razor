@page "/event-voting/{EventId}"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using Votify.shared
@using System.Linq
@layout EmptyLayout
@inject NavigationManager NavigationManager
@inject HttpClient Http
<style>
    input[type=number]::-webkit-inner-spin-button,
    input[type=number]::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
    input[type=number] { -moz-appearance: textfield; }

</style>
<div class="min-h-screen bg-gradient-to-br from-[#E9EFE1] to-[#B5D6AC]">
    <header class="bg-white shadow-sm border-b border-[#B5D6AC]">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-4">
                    <a href="/dashboard" class="flex items-center text-[#6C8A6C] hover:bg-[#E9EFE1] px-4 py-2 rounded-md transition-colors">
                        <span class="mr-2">←</span> Volver
                    </a>
                    <img src="imagenes/logo-votify.png" alt="Votify" class="h-16 object-contain" />
                    <h1 class="text-xl font-bold text-[#1A281B]">HackUPC 2026</h1>
                </div>
                <div class="flex items-center gap-2 text-[#4C6B4F]">
                    <span class="font-medium">Proyecto @(currentProjectIndex + 1) de @mockProjects.Count</span>
                </div>
            </div>
        </div>
    </header>
    <main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        @if (avisoSinDatos != null && (Rol == "JURADO" || Rol == "PUBLICO"))
        {
            <div class="bg-white rounded-2xl shadow-xl p-8 text-center">
                <div class="text-5xl mb-4">📋</div>
                <p class="text-xl font-bold text-[#1A281B] mb-2">Sin proyectos disponibles</p>
                <p class="text-[#6C8A6C]">@avisoSinDatos</p>
                <a href="/dashboard" class="mt-6 inline-block bg-gradient-to-r from-[#6C8A6C] to-[#4C6B4F] text-white px-6 py-3 rounded-xl font-bold">
                    Volver al Dashboard
                </a>
            </div>
        }
        else if (Rol == "JURADO")
        {
            @if (yaVotadoEnEvento)
            {
                <div class="bg-white rounded-2xl shadow-xl p-8 text-center">
                    <p class="text-2xl font-bold text-[#1A281B] mb-2">Ya has votado en este evento</p>
                    <p class="text-[#6C8A6C]">Tu evaluación ya fue registrada. No puedes volver a votar.</p>
                    <a href="/dashboard" class="mt-6 inline-block bg-gradient-to-r from-[#6C8A6C] to-[#4C6B4F] text-white px-6 py-3 rounded-xl font-bold">
                        Volver al Dashboard
                    </a>
                </div>
            }
            else
            {
                <div class="mb-6">
                    <div class="flex justify-between items-center mb-2">
                        <div class="flex items-center gap-4">   
                            <span class="text-sm text-[#4C6B4F]">Progreso de votación</span>
                            <span class="text-sm text-[#4C6B4F]">@votedProjects.Count/@mockProjects.Count proyectos evaluados</span>
                            <span class="   text-sm text-[#4C6B4F]">• Votos realizados: @votesSubmitted/3</span>
                        </div>            
                    </div>
                    <div class="w-full bg-white rounded-full h-2 overflow-hidden">
                        <div class="bg-gradient-to-r from-[#6C8A6C] to-[#70D939] h-full transition-all duration-300"
                        style="width: @(GetProgress() + "%")">
                        </div>
                    </div>
                </div>
                <div class="bg-white rounded-2xl shadow-xl p-8 mb-6">
                    @{
                        var project = mockProjects[currentProjectIndex];
                    }
                    <div class="mb-6">
                        <div class="flex items-start justify-between mb-4">
                            <div>
                                <h2 class="text-3xl font-bold text-[#1A281B] mb-2">@project.Name</h2>
                                <p class="text-[#6C8A6C] mb-1">Equipo: @project.Team</p>
                                <span class="inline-block px-3 py-1 bg-[#E9EFE1] text-[#4C6B4F] rounded-full text-sm">
                                    @project.Category
                                </span>
                            </div>
                            @if (votedProjects.Contains(project.Id))
                            {
                                <div class="flex items-center gap-2 text-[#70D939] bg-[#E9EFE1] px-3 py-1 rounded-full">
                                    <span class="text-sm font-bold">★ Votado</span>
                                </div>
                            }
                        </div>
                        <p class="text-[#4C6B4F] leading-relaxed">@project.Description</p>
                    </div>
                    <div class="space-y-6 mb-6">
                        <h3 class="text-xl font-bold text-[#1A281B]">Criterios de Evaluación</h3>
                        @foreach (var criterion in mockCriteria)
                        {
                            <div class="bg-[#EFEFEE] rounded-xl p-6">
                                <div class="flex items-center justify-between mb-3">
                                    <div class="flex-1">
                                        <label class="text-[#1A281B] text-base font-bold">
                                            @criterion.Name
                                            <span class="text-[#6C8A6C] ml-2 text-sm font-normal">(Peso: @criterion.Weight%)</span>
                                        </label>
                                        <p class="text-sm text-[#6C8A6C] mt-1">@criterion.Description</p>
                                    </div>
                                    <div class="ml-4 text-right">
                                        @if (editingCriteria.Contains(criterion.Id))
                                        {
                                            <input type="number"
                                            min="0" max="10" step="0.01"
                                            value="@GetScore(criterion.Id)"
                                            @onchange="(e) => HandleScoreChange(criterion.Id, e.Value?.ToString())"
                                            @onblur="() => ToggleEditMode(criterion.Id)"
                                            class="text-3xl font-bold text-[#6C8A6C] w-20 bg-transparent border-b-2 border-[#6C8A6C] outline-none text-right" />
                                        }
                                        else if (votedProjects.Contains(project.Id))
                                        {
                                            <span class="text-3xl font-bold text-[#6C8A6C]">
                                                @GetScore(criterion.Id)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-3xl font-bold text-[#6C8A6C] cursor-pointer"
                                            @onclick="() => ToggleEditMode(criterion.Id)">
                                                @GetScore(criterion.Id)
                                            </span>
                                        }
                                        <span class="text-[#A6AAA9]">/10</span>
                                    </div>
                                </div>
                                <input type="range"
                                min="0" max="10" step="0.5"
                                value="@GetScore(criterion.Id)"
                                disabled="@votedProjects.Contains(project.Id)"
                                @oninput="(e) => HandleScoreChange(criterion.Id, e.Value?.ToString())"
                                class="w-full h-2 bg-[#B5D6AC] rounded-lg appearance-none cursor-pointer accent-[#6C8A6C] my-4" />
                                <div class="flex justify-between text-xs text-[#A6AAA9]">
                                    <span>0 - Muy bajo</span>
                                    <span>5 - Promedio</span>
                                    <span>10 - Excelente</span>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="bg-gradient-to-r from-[#6C8A6C] to-[#70D939] rounded-xl p-6 mb-6 shadow-md">
                        <div class="flex items-center justify-between text-white font-bold">
                            <span class="text-lg">Puntuación Total Ponderada</span>
                            <span class="text-4xl">@CalculateTotalScore()/10</span>
                        </div>
                    </div>
                    <div class="mb-6">
                        <label for="comments" class="text-[#1A281B] font-bold mb-2 block">Comentarios (opcional)</label>
                        <div class="relative">
                            <textarea id="comments"
                            value="@comments"
                            @oninput="(e) => { comments = e.Value?.ToString() ?? string.Empty; commentLength = comments.Length; }"
                            maxlength="500"
                            placeholder="Comparte tus observaciones sobre el proyecto..."
                            class="w-full min-h-[120px] p-4 rounded-xl bg-[#E9EFE1] border-[#B5D6AC] focus:ring-2 focus:ring-[#6C8A6C] outline-none transition-all"></textarea>
                            <span class="absolute bottom-2 right-3 text-xs text-[#A6AAA9]">@commentLength/500</span>
                        </div>
                    </div>
                    <div class="flex gap-4">
                        @if (votedProjects.Contains(project.Id))
                        {
                            <span class="flex-1 text-center text-sm text-[#A6AAA9] py-4 font-medium">✓ Ya evaluado</span>
                            @if (currentProjectIndex < mockProjects.Count - 1)
                            {
                                <button @onclick="NavigateNext"
                                class="flex-1 bg-gradient-to-r from-[#6C8A6C] to-[#4C6B4F] text-white py-4 rounded-xl font-bold shadow-lg hover:opacity-90 transition-opacity">
                                    Siguiente Proyecto
                                </button>
                            }
                        }
                        else
                        {
                        <button @onclick="SubmitVote"
                            class="flex-1 bg-gradient-to-r from-[#6C8A6C] to-[#4C6B4F] text-white py-4 rounded-xl font-bold shadow-lg hover:opacity-90 transition-opacity">
                                @(((votesSubmitted + 1) >= 3 || IsLastProject) ? "Votar (Finalizar votación)" : (currentProjectIndex < mockProjects.Count - 1 ? "Siguiente Proyecto" : "Finalizar Votación"))
                            </button>
                        }
                        @if (currentProjectIndex > 0)
                        {
                            <button @onclick="PreviousProject"
                            class="px-8 border-2 border-[#6C8A6C] text-[#6C8A6C] py-4 rounded-xl font-bold hover:bg-[#E9EFE1] transition-colors">
                                Anterior
                            </button>
                        }
                        @if (!votedProjects.Contains(project.Id))
                        {
                            <button @onclick="SkipNext"
                                class="px-6 border-2 border-[#6C8A6C] text-[#6C8A6C] py-4 rounded-xl font-bold hover:bg-[#E9EFE1] transition-colors">
                                @(IsLastProject ? "Saltar Proyecto (Finalizar votación)" : "Saltar Proyecto")
                            </button>
                        }
                    </div>
                </div>
            }
        }
        else if (Rol == "PUBLICO")
        {
            @if (!publicoMostrarVotacion)
            {
                <div class="bg-white rounded-2xl shadow-xl p-8 mb-6">
                    <h2 class="text-xl font-bold text-[#1A281B] mb-4">Proyectos del evento</h2>
                    <div class="space-y-3">
                        @for (int i = 0; i < mockProjects.Count; i++)
                        {
                            var proj = mockProjects[i];
                            var idx = i;
                            <div class="flex items-center justify-between p-4 bg-[#F8FAF7] rounded-xl border border-[#B5D6AC]/30">
                                <div>
                                    <p class="font-bold text-[#1A281B]">@proj.Name</p>
                                    <p class="text-sm text-[#6C8A6C]">@proj.Team · @proj.Category</p>
                                    <p class="text-sm text-[#4C6B4F] mt-1">@proj.Description</p>
                                </div>
                                @if (publicosVotados.Contains(idx))
                                {
                                    <span class="ml-4 px-4 py-2 rounded-xl text-sm font-bold bg-[#E9EFE1] text-[#6C8A6C]">✓ Votado</span>
                                }
                                else if (publicosVotados.Count >= 3)
                                {
                                    <span class="ml-4 px-4 py-2 rounded-xl text-sm font-bold bg-[#EFEFEE] text-[#A6AAA9]">Límite alcanzado</span>
                                }
                                else
                                {
                                    <button @onclick="() => { publicoProyectoIndex = idx; currentProjectIndex = idx; publicoMostrarVotacion = true; }"
                                            class="ml-4 bg-gradient-to-r from-[#6C8A6C] to-[#4C6B4F] text-white px-4 py-2 rounded-xl font-bold hover:opacity-90 transition-opacity">
                                        Votar
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                var proj = mockProjects[publicoProyectoIndex];
                <div class="bg-white rounded-2xl shadow-xl p-8 mb-6">
                    <button @onclick="() => publicoMostrarVotacion = false"
                            class="mb-4 text-[#6C8A6C] hover:underline flex items-center gap-1">
                        ← Volver a la lista
                    </button>
                    <h2 class="text-3xl font-bold text-[#1A281B] mb-2">@proj.Name</h2>
                    <p class="text-[#6C8A6C] mb-1">Equipo: @proj.Team</p>
                    <span class="inline-block px-3 py-1 bg-[#E9EFE1] text-[#4C6B4F] rounded-full text-sm mb-4">@proj.Category</span>
                    <p class="text-[#4C6B4F] mb-6">@proj.Description</p>

                    <div class="space-y-6 mb-6">
                        <h3 class="text-xl font-bold text-[#1A281B]">Criterios de Evaluación</h3>
                        @foreach (var criterion in mockCriteria)
                        {
                            <div class="bg-[#EFEFEE] rounded-xl p-6">
                                <div class="flex items-center justify-between mb-3">
                                    <div class="flex-1">
                                        <label class="text-[#1A281B] text-base font-bold">
                                            @criterion.Name
                                            <span class="text-[#6C8A6C] ml-2 text-sm font-normal">(Peso: @criterion.Weight%)</span>
                                        </label>
                                        <p class="text-sm text-[#6C8A6C] mt-1">@criterion.Description</p>
                                    </div>
                                    <div class="ml-4 text-right">
                                        @if (editingCriteria.Contains(criterion.Id))
                                        {
                                            <input type="number" min="0" max="10" step="0.01"
                                                   value="@GetScore(criterion.Id)"
                                                   @onchange="(e) => HandleScoreChange(criterion.Id, e.Value?.ToString())"
                                                   @onblur="() => ToggleEditMode(criterion.Id)"
                                                   class="text-3xl font-bold text-[#6C8A6C] w-20 bg-transparent border-b-2 border-[#6C8A6C] outline-none text-right" />
                                        }
                                        else
                                        {
                                            <span class="text-3xl font-bold text-[#6C8A6C] cursor-pointer"
                                                  @onclick="() => ToggleEditMode(criterion.Id)">
                                                @GetScore(criterion.Id)
                                            </span>
                                        }
                                        <span class="text-[#A6AAA9]">/10</span>
                                    </div>
                                </div>
                                <input type="range" min="0" max="10" step="0.5"
                                       value="@GetScore(criterion.Id)"
                                       @oninput="(e) => HandleScoreChange(criterion.Id, e.Value?.ToString())"
                                       class="w-full h-2 bg-[#B5D6AC] rounded-lg appearance-none cursor-pointer accent-[#6C8A6C] my-4" />
                                <div class="flex justify-between text-xs text-[#A6AAA9]">
                                    <span>0 - Muy bajo</span>
                                    <span>5 - Promedio</span>
                                    <span>10 - Excelente</span>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="mb-6">
                        <label class="text-[#1A281B] font-bold mb-2 block">Comentarios (opcional)</label>
                        <div class="relative">
                            <textarea value="@comments"
                                      @oninput="(e) => { comments = e.Value?.ToString() ?? string.Empty; commentLength = comments.Length; }"
                                      maxlength="500"
                                      placeholder="Comparte tus observaciones sobre el proyecto..."
                                      class="w-full min-h-[120px] p-4 rounded-xl bg-[#E9EFE1] border-[#B5D6AC] focus:ring-2 focus:ring-[#6C8A6C] outline-none transition-all"></textarea>
                            <span class="absolute bottom-2 right-3 text-xs text-[#A6AAA9]">@commentLength/500</span>
                        </div>
                    </div>
                    <button @onclick="SubmitVotoPublico"
                            class="w-full bg-gradient-to-r from-[#6C8A6C] to-[#4C6B4F] text-white py-4 rounded-xl font-bold shadow-lg hover:opacity-90 transition-opacity">
                        Enviar voto
                    </button>
                </div>
            }
        }
        else if (Rol == "COMPETIDOR")
        {
            <div class="bg-white rounded-2xl shadow-xl p-8 mb-6 text-center">
                <div class="w-20 h-20 rounded-full bg-gradient-to-br from-[#E9EFE1] to-[#B5D6AC] flex items-center justify-center mx-auto mb-4 text-4xl">🚀</div>
                <h2 class="text-2xl font-bold text-[#1A281B] mb-2">Tu proyecto está siendo evaluado</h2>
                <p class="text-[#6C8A6C] mb-6">Los jurados están revisando tu trabajo ahora mismo. Los resultados estarán disponibles al terminar la votación.</p>
                <div class="bg-[#E9EFE1] rounded-xl p-6 mb-6 text-left">
                    <h3 class="text-lg font-bold text-[#1A281B] mb-3">Tu proyecto</h3>
                    @{var myProj = mockProjects[0];}
                    <p class="text-xl font-bold text-[#4C6B4F]">@myProj.Name</p>
                    <p class="text-sm text-[#6C8A6C]">Equipo: @myProj.Team</p>
                    <span class="inline-block mt-2 px-3 py-1 bg-white text-[#4C6B4F] rounded-full text-xs font-bold">@myProj.Category</span>
                    <p class="text-sm text-[#4C6B4F] mt-3 leading-relaxed">@myProj.Description</p>
                </div>
                <div class="flex items-center justify-center gap-3 text-[#6C8A6C]">
                    <div class="w-3 h-3 rounded-full bg-[#6C8A6C] animate-bounce" style="animation-delay:0s"></div>
                    <div class="w-3 h-3 rounded-full bg-[#6C8A6C] animate-bounce" style="animation-delay:0.2s"></div>
                    <div class="w-3 h-3 rounded-full bg-[#6C8A6C] animate-bounce" style="animation-delay:0.4s"></div>
                    <span class="text-sm font-medium ml-2">Votación en curso</span>
                </div>
            </div>
        }
        else if (Rol == "ORGANIZADOR")
        {
            <!-- Eliminar evento -->
            <div class="flex justify-end mb-4">
                <button @onclick="() => mostrarConfirmEliminarEvento = !mostrarConfirmEliminarEvento"
                        class="border border-red-400 text-red-500 px-4 py-2 rounded-lg font-medium text-sm hover:bg-red-50 transition-colors">
                    🗑 Eliminar evento
                </button>
            </div>
            @if (mostrarConfirmEliminarEvento)
            {
                <div class="bg-red-50 border border-red-200 rounded-xl p-4 mb-4">
                    <p class="text-red-700 font-medium mb-3 text-sm">¿Eliminar este evento? Se borrarán todos los proyectos y votos de forma permanente.</p>
                    <div class="flex gap-3">
                        <button @onclick="EliminarEvento" disabled="@eliminandoEvento"
                                class="bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded-lg font-bold text-sm transition-colors disabled:opacity-50">
                            @(eliminandoEvento ? "Eliminando..." : "Sí, eliminar")
                        </button>
                        <button @onclick="() => mostrarConfirmEliminarEvento = false"
                                class="border border-gray-300 text-gray-500 px-4 py-2 rounded-lg text-sm hover:bg-gray-50 transition-colors">
                            Cancelar
                        </button>
                    </div>
                </div>
            }

            <!-- Stats -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                <div class="bg-white rounded-xl p-5 shadow-sm flex items-center gap-4">
                    <div class="w-12 h-12 rounded-full bg-gradient-to-br from-[#6C8A6C] to-[#70D939] flex items-center justify-center text-white text-xl">🏆</div>
                    <div>
                        <p class="text-xs text-[#6C8A6C] font-medium">Proyectos registrados</p>
                        <p class="text-2xl font-bold text-[#1A281B]">@proyectosOrganizador.Count</p>
                    </div>
                </div>
                <div class="bg-white rounded-xl p-5 shadow-sm flex items-center gap-4">
                    <div class="w-12 h-12 rounded-full bg-gradient-to-br from-[#6C8A6C] to-[#70D939] flex items-center justify-center text-white text-xl">👥</div>
                    <div>
                        <p class="text-xs text-[#6C8A6C] font-medium">Competidores</p>
                        <p class="text-2xl font-bold text-[#1A281B]">@proyectosOrganizador.Select(p => p.Competidor).Distinct().Count()</p>
                    </div>
                </div>
            </div>

            <!-- Proyectos -->
            <div class="bg-white rounded-2xl shadow-xl p-8 mb-6">
                <div class="flex items-center justify-between mb-4">
                    <h2 class="text-xl font-bold text-[#1A281B]">Proyectos registrados</h2>
                    <button @onclick="() => { mostrarFormProyecto = !mostrarFormProyecto; editandoProyectoId = null; confirmEliminarProyectoId = null; }"
                            class="bg-gradient-to-r from-[#6C8A6C] to-[#4C6B4F] text-white px-4 py-2 rounded-xl font-bold hover:opacity-90 transition-opacity text-sm">
                        + Añadir proyecto
                    </button>
                </div>

                @if (mostrarFormProyecto)
                {
                    <div class="bg-[#F8FAF7] border border-[#B5D6AC] rounded-xl p-6 mb-4">
                        <h3 class="text-base font-bold text-[#1A281B] mb-4">Nuevo proyecto</h3>
                        <div class="space-y-3">
                            <div>
                                <label class="text-sm font-medium text-[#4C6B4F] block mb-1">Nombre del proyecto *</label>
                                <input @bind="nuevoNombre" placeholder="Ej: EcoTrack"
                                       class="w-full px-4 py-2 rounded-lg bg-white border border-[#B5D6AC] focus:outline-none focus:border-[#6C8A6C] text-[#1A281B]" />
                            </div>
                            <div>
                                <label class="text-sm font-medium text-[#4C6B4F] block mb-1">Descripción</label>
                                <textarea @bind="nuevaDescripcion" placeholder="Breve descripción del proyecto..."
                                          class="w-full px-4 py-2 rounded-lg bg-white border border-[#B5D6AC] focus:outline-none focus:border-[#6C8A6C] text-[#1A281B] min-h-[80px]"></textarea>
                            </div>
                            <div>
                                <label class="text-sm font-medium text-[#4C6B4F] block mb-1">Username del competidor *</label>
                                <input @bind="nuevoCompetidor" placeholder="Nombre de usuario del competidor registrado"
                                       class="w-full px-4 py-2 rounded-lg bg-white border border-[#B5D6AC] focus:outline-none focus:border-[#6C8A6C] text-[#1A281B]" />
                                <p class="text-xs text-[#A6AAA9] mt-1">El competidor debe tener una cuenta en Votify.</p>
                            </div>
                            @if (errorProyecto != null)
                            {
                                <p class="text-red-500 text-sm font-medium">⚠️ @errorProyecto</p>
                            }
                            <div class="flex gap-3 pt-1">
                                <button @onclick="CrearProyecto" disabled="@creandoProyecto"
                                        class="bg-gradient-to-r from-[#6C8A6C] to-[#4C6B4F] text-white px-6 py-2 rounded-xl font-bold hover:opacity-90 transition-opacity disabled:opacity-50">
                                    @(creandoProyecto ? "Guardando..." : "Guardar proyecto")
                                </button>
                                <button @onclick="() => { mostrarFormProyecto = false; errorProyecto = null; }"
                                        class="px-6 py-2 border-2 border-[#6C8A6C] text-[#6C8A6C] rounded-xl font-bold hover:bg-[#E9EFE1] transition-colors">
                                    Cancelar
                                </button>
                            </div>
                        </div>
                    </div>
                }

                @if (proyectosOrganizador.Count == 0)
                {
                    <p class="text-center text-[#A6AAA9] py-8">No hay proyectos todavía. Añade el primero.</p>
                }
                else
                {
                    <div class="space-y-3">
                        @foreach (var proj in proyectosOrganizador.ToList())
                        {
                            @if (editandoProyectoId == proj.Id)
                            {
                                <div class="bg-[#F8FAF7] border border-[#B5D6AC] rounded-xl p-4">
                                    <div class="space-y-3">
                                        <div>
                                            <label class="text-sm font-medium text-[#4C6B4F] block mb-1">Nombre *</label>
                                            <input @bind="editProyectoNombre"
                                                   class="w-full px-3 py-2 rounded-lg bg-white border border-[#B5D6AC] focus:outline-none focus:border-[#6C8A6C] text-[#1A281B] text-sm" />
                                        </div>
                                        <div>
                                            <label class="text-sm font-medium text-[#4C6B4F] block mb-1">Descripción</label>
                                            <textarea @bind="editProyectoDescripcion"
                                                      class="w-full px-3 py-2 rounded-lg bg-white border border-[#B5D6AC] focus:outline-none focus:border-[#6C8A6C] text-[#1A281B] text-sm min-h-[60px]"></textarea>
                                        </div>
                                        <!-- Participantes -->
                                        <div>
                                            <label class="text-sm font-medium text-[#4C6B4F] block mb-1">Participantes del equipo</label>
                                            <div class="flex flex-wrap gap-2 mb-2">
                                                <span class="inline-flex items-center gap-1 px-3 py-1 bg-[#6C8A6C] text-white rounded-full text-xs font-bold">
                                                    👑 @editParticipanteLeader
                                                </span>
                                                @foreach (var p in editParticipantes)
                                                {
                                                    var pu = p;
                                                    <span class="inline-flex items-center gap-1 px-3 py-1 bg-[#E9EFE1] text-[#1A281B] rounded-full text-xs font-medium">
                                                        @pu
                                                        <button type="button" @onclick="() => editParticipantes.Remove(pu)"
                                                                class="ml-1 text-[#6C8A6C] hover:text-red-500 font-bold leading-none">×</button>
                                                    </span>
                                                }
                                            </div>
                                            <div class="flex gap-2">
                                                <input type="text" @bind="busquedaParticipante" @bind:event="oninput"
                                                       placeholder="Username del participante..."
                                                       @onkeydown="OnParticipanteKeyDown"
                                                       class="flex-1 px-3 py-2 rounded-lg bg-white border border-[#B5D6AC] focus:outline-none focus:border-[#6C8A6C] text-[#1A281B] text-sm" />
                                                <button type="button" @onclick="AgregarParticipanteManual"
                                                        class="px-3 py-2 bg-[#6C8A6C] text-white rounded-lg text-sm font-bold hover:bg-[#4C6B4F] transition-colors">
                                                    + Añadir
                                                </button>
                                            </div>
                                        </div>
                                        @if (errorEditProyecto != null)
                                        {
                                            <p class="text-red-500 text-sm">⚠️ @errorEditProyecto</p>
                                        }
                                        <div class="flex gap-3">
                                            <button @onclick="() => GuardarProyecto(proj)" disabled="@guardandoProyecto"
                                                    class="bg-gradient-to-r from-[#6C8A6C] to-[#4C6B4F] text-white px-4 py-2 rounded-lg font-bold text-sm hover:opacity-90 disabled:opacity-50">
                                                @(guardandoProyecto ? "Guardando..." : "Guardar")
                                            </button>
                                            <button @onclick="() => { editandoProyectoId = null; errorEditProyecto = null; }"
                                                    class="px-4 py-2 border border-[#6C8A6C] text-[#6C8A6C] rounded-lg text-sm hover:bg-[#E9EFE1]">
                                                Cancelar
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                            else if (confirmEliminarProyectoId == proj.Id)
                            {
                                <div class="bg-red-50 border border-red-200 rounded-xl p-4">
                                    <p class="text-red-700 font-medium text-sm mb-3">¿Eliminar el proyecto "<strong>@proj.Nombre</strong>" y todos sus votos?</p>
                                    <div class="flex gap-3">
                                        <button @onclick="() => EliminarProyecto(proj)" disabled="@eliminandoProyecto"
                                                class="bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded-lg font-bold text-sm disabled:opacity-50">
                                            @(eliminandoProyecto ? "Eliminando..." : "Sí, eliminar")
                                        </button>
                                        <button @onclick="() => confirmEliminarProyectoId = null"
                                                class="border border-gray-300 text-gray-500 px-4 py-2 rounded-lg text-sm hover:bg-gray-50">
                                            Cancelar
                                        </button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="flex items-center justify-between p-4 bg-[#F8FAF7] rounded-xl border border-[#B5D6AC]/30">
                                    <div>
                                        <p class="font-bold text-[#1A281B]">@proj.Nombre</p>
                                        <div class="flex flex-wrap gap-1 mt-1">
                                            <span class="text-xs font-bold text-white bg-[#6C8A6C] px-2 py-0.5 rounded-full">👑 @proj.Competidor</span>
                                            @foreach (var p in proj.Participantes)
                                            {
                                                <span class="text-xs text-[#4C6B4F] bg-[#E9EFE1] px-2 py-0.5 rounded-full">@p</span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrEmpty(proj.Descripcion))
                                        {
                                            <p class="text-xs text-[#A6AAA9] mt-1">@proj.Descripcion</p>
                                        }
                                    </div>
                                    <div class="flex items-center gap-2 ml-4 flex-shrink-0">
                                        <button @onclick="() => StartEditProyecto(proj)"
                                                class="border border-[#6C8A6C] text-[#6C8A6C] px-3 py-1.5 rounded-lg text-sm hover:bg-[#E9EFE1] transition-colors">
                                            ✏️
                                        </button>
                                        <button @onclick="() => { confirmEliminarProyectoId = proj.Id; editandoProyectoId = null; }"
                                                class="border border-red-300 text-red-500 px-3 py-1.5 rounded-lg text-sm hover:bg-red-50 transition-colors">
                                            🗑
                                        </button>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                }
            </div>
        }
        else if (Rol == "ENCARGADO")
        {
            <div class="bg-white rounded-2xl shadow-xl p-8 mb-6">
                <div class="flex items-center justify-between mb-6">
                    <h2 class="text-xl font-bold text-[#1A281B]">Control de votación</h2>
                    <span class="px-4 py-2 bg-[#6C8A6C] text-white text-sm font-bold rounded-full">● Votación abierta</span>
                </div>
                <div class="grid grid-cols-2 gap-4 mb-6">
                    <button class="bg-gradient-to-r from-[#6C8A6C] to-[#4C6B4F] text-white py-4 rounded-xl font-bold hover:opacity-90 transition-opacity">
                        ⏸ Pausar votación
                    </button>
                    <button class="bg-red-50 border-2 border-red-300 text-red-500 py-4 rounded-xl font-bold hover:bg-red-100 transition-colors">
                        ⏹ Cerrar votación
                    </button>
                </div>
                <div class="bg-[#E9EFE1] rounded-xl p-5 mb-4">
                    <div class="flex justify-between items-center mb-2">
                        <span class="text-sm font-medium text-[#4C6B4F]">Progreso general</span>
                        <span class="text-sm font-bold text-[#1A281B]">12 / 18 jurados han votado</span>
                    </div>
                    <div class="w-full bg-white rounded-full h-3 overflow-hidden">
                        <div class="bg-gradient-to-r from-[#6C8A6C] to-[#70D939] h-full transition-all duration-300" style="width: 66%"></div>
                    </div>
                    <p class="text-xs text-[#6C8A6C] mt-2">66% completado</p>
                </div>
            </div>

            <div class="bg-white rounded-2xl shadow-xl p-8">
                <h2 class="text-xl font-bold text-[#1A281B] mb-4">Estado por proyecto</h2>
                <div class="space-y-3">
                    @foreach (var (proj, idx) in mockProjects.Select((p, i) => (p, i)))
                    {
                        int votos = idx == 0 ? 12 : 7;
                        int total = 18;
                        double pct = (votos / (double)total) * 100;
                        <div class="p-4 bg-[#F8FAF7] rounded-xl border border-[#B5D6AC]/30">
                            <div class="flex justify-between items-center mb-2">
                                <p class="font-bold text-[#1A281B]">@proj.Name</p>
                                <span class="text-sm font-bold text-[#4C6B4F]">@votos/@total votos</span>
                            </div>
                            <div class="w-full bg-white rounded-full h-2 overflow-hidden">
                                <div class="bg-gradient-to-r from-[#6C8A6C] to-[#70D939] h-full" style="width: @(pct.ToString("F0"))%"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        @if (errorVoto != null)
        {
            <div class="fixed bottom-6 left-1/2 -translate-x-1/2 bg-red-600 text-white px-6 py-3 rounded-xl shadow-lg z-50 max-w-md text-center text-sm font-medium">
                ⚠️ @errorVoto
            </div>
        }
    </main>
</div>
@code {
    [Parameter] public string? EventId { get; set; }
    [Parameter]
    [SupplyParameterFromQuery]
    public string? Rol { get; set; }
    private string? errorVoto = null;
    private HashSet<string> editingCriteria = new();
    private int currentProjectIndex = 0;
    private int commentLength = 0;
    private string comments = "";
    private HashSet<string> votedProjects = new();
    private Dictionary<string, double> scores = new();
    private int votesSubmitted = 0; 
    // Lógica de datos (Mock)
    private List<Project> mockProjects = new() {
        new Project { Id = "1", Name = "EcoTrack", Team = "Green Coders", Category = "Sostenibilidad", Description = "Rastreador de huella de carbono." },
        new Project { Id = "2", Name = "HealthAI", Team = "MedTech", Category = "Salud", Description = "IA para diagnóstico médico." },
        new Project { Id = "3", Name = "EduSmart", Team = "Future Minds", Category = "Educación", Description = "Plataforma adaptativa de aprendizaje con IA." },
        new Project { Id = "4", Name = "SafeCity", Team = "UrbanTech", Category = "Smart Cities", Description = "Sistema de alerta temprana para emergencias urbanas." },
        new Project { Id = "5", Name = "FoodSaver", Team = "ZeroWaste", Category = "Sostenibilidad", Description = "App para reducir el desperdicio de alimentos." },
        new Project { Id = "6", Name = "FinTrack", Team = "FinTech Lab", Category = "Finanzas", Description = "Gestor inteligente de gastos personales." }
    };
    private List<Criterion> mockCriteria = new() {
        new Criterion { Id = "1", Name = "Innovación", Weight = 25, Description = "Originalidad de la solución." },
        new Criterion { Id = "2", Name = "Viabilidad", Weight = 25, Description = "Factibilidad técnica y económica." },
        new Criterion { Id = "3", Name = "Impacto", Weight = 25, Description = "Valor generado para usuarios o sociedad." },
        new Criterion { Id = "4", Name = "Presentación", Weight = 25, Description = "Claridad y calidad de la exposición." }
    };
    private bool yaVotadoEnEvento = false;
    private string? avisoSinDatos = null;

    // Estado del organizador — crear proyecto
    private List<ProyectoResultadoDTO> proyectosOrganizador = new();
    private bool mostrarFormProyecto = false;
    private string nuevoNombre = "";
    private string nuevaDescripcion = "";
    private string nuevoCompetidor = "";
    private string? errorProyecto = null;
    private bool creandoProyecto = false;

    // Estado del organizador — eliminar evento
    private bool mostrarConfirmEliminarEvento = false;
    private bool eliminandoEvento = false;
    private string? errorEliminarEvento = null;

    // Estado del organizador — editar/eliminar proyecto
    private int? editandoProyectoId = null;
    private string editProyectoNombre = "";
    private string editProyectoDescripcion = "";
    private string? errorEditProyecto = null;
    private bool guardandoProyecto = false;
    private int? confirmEliminarProyectoId = null;
    private bool eliminandoProyecto = false;

    // Participantes adicionales (edición de proyecto)
    private List<string> editParticipantes = new();
    private string busquedaParticipante = "";
    private string editParticipanteLeader = "";
    protected override async Task OnInitializedAsync()
    {
        // 1. Cargar proyectos reales
        try
        {
            var reales = await Http.GetFromJsonAsync<List<ProyectoResultadoDTO>>($"/api/resultados/{EventId}");
            if (reales != null && reales.Count > 0)
            {
                mockProjects = reales.Select(p => new Project
                {
                    Id = p.Id.ToString(),
                    DbId = p.Id,
                    Name = p.Nombre,
                    Team = p.Competidor,
                    Category = "",
                    Description = p.Descripcion
                }).ToList();
            }
            else
            {
                avisoSinDatos = "Esta votación no tiene proyectos registrados en la base de datos. El organizador debe añadirlos antes de que se pueda votar.";
            }
        }
        catch (Exception ex)
        {
            avisoSinDatos = $"No se pudieron cargar los proyectos: {ex.Message}";
        }

        // 1b. Si es organizador, cargar proyectos y datos del evento
        if (Rol == "ORGANIZADOR")
        {
            try
            {
                var p = await Http.GetFromJsonAsync<List<ProyectoResultadoDTO>>($"/api/resultados/{EventId}");
                proyectosOrganizador = p ?? new();
            }
            catch { }

            }

        // 2. Cargar votos ya emitidos por este usuario en esta votación
        try
        {
            var votados = await Http.GetFromJsonAsync<List<int>>($"/api/votos/misVotos/{EventId}");
            if (votados != null)
            {
                foreach (var dbId in votados)
                {
                    var proj = mockProjects.FirstOrDefault(p => p.DbId == dbId);
                    if (proj != null)
                    {
                        votedProjects.Add(proj.Id);
                        // Para PUBLICO: marcar también por índice
                        int idx = mockProjects.IndexOf(proj);
                        if (idx >= 0) publicosVotados.Add(idx);
                    }
                }
            }
        }
        catch { /* si falla, el usuario puede re-votar; el servidor rechazará duplicados */ }

        votesSubmitted = votedProjects.Count;

        // 3. Comprobar si ya alcanzó el límite de votos (para JURADO)
        yaVotadoEnEvento = votesSubmitted >= 3;
    }
    private void ToggleEditMode(string criterionId)
    {
        if (editingCriteria.Contains(criterionId))
            editingCriteria.Remove(criterionId);
        else
            editingCriteria.Add(criterionId);
    }
    private double GetScore(string criterionId)
    {
        string key = $"{mockProjects[currentProjectIndex].Id}-{criterionId}";
        return scores.ContainsKey(key) ? scores[key] : 5.0;
    }
    private void HandleScoreChange(string criterionId, string? val)
    {
        if (double.TryParse(val, out double result))
        {
            string key = $"{mockProjects[currentProjectIndex].Id}-{criterionId}";
            result = Math.Clamp(result, 0, 10);
            result = Math.Round(result, 2);
            scores[key] = result;
        }
    }
    private string CalculateTotalScore()
    {
        double total = 0;
        var currentId = mockProjects[currentProjectIndex].Id;
        foreach (var c in mockCriteria)
        {
            total += (GetScore(c.Id) * c.Weight) / 100;
        }
        return total.ToString("F1");
    }
    private double CalculateTotalScoreDouble()
    {
        double total = 0;
        foreach (var c in mockCriteria)
            total += (GetScore(c.Id) * c.Weight) / 100;
        return Math.Round(total, 2);
    }
    private double GetProgress() => (votedProjects.Count / (double)mockProjects.Count) * 100;
    private int NonVotedCount => mockProjects.Count(p => !votedProjects.Contains(p.Id));
    private int NonVotedRemainingExcludingCurrent => mockProjects.Count(p => !votedProjects.Contains(p.Id) && p.Id != mockProjects[currentProjectIndex].Id);
    private bool IsLastProject => currentProjectIndex == mockProjects.Count - 1;
    private async Task SubmitVote()
    {
        // Limitar a 3 votaciones por evento
        if (votesSubmitted >= 3)
        {
            NavigationManager.NavigateTo("/dashboard");
            return;
        }

        // Persistir el voto en la base de datos
        var currentProject = mockProjects[currentProjectIndex];
        errorVoto = null;
        if (!int.TryParse(EventId, out int votacionId))
        {
            errorVoto = "ID de votación inválido.";
            return;
        }
        try
        {
            var resp = await Http.PostAsJsonAsync("/api/votos/guardar", new
            {
                VotacionId = votacionId,
                ProyectoId = currentProject.DbId,
                Puntuacion = CalculateTotalScoreDouble(),
                Comentario = string.IsNullOrWhiteSpace(comments) ? (string?)null : comments
            });
            if (!resp.IsSuccessStatusCode)
            {
                var msg = await resp.Content.ReadAsStringAsync();
                errorVoto = $"Error: {msg}";
                return;
            }
        }
        catch (Exception ex)
        {
            errorVoto = $"Error de conexión: {ex.Message}";
            return;
        }

        votedProjects.Add(currentProject.Id);
        votesSubmitted++;

        if (votesSubmitted >= 3)
        {
            // Al alcanzar el límite, finalizar y volver al dashboard
            await Http.PostAsync($"/api/votos/finalizar/{EventId}", null);
            NavigationManager.NavigateTo("/dashboard");
            return;
        }

        // Si es el último proyecto de la lista, finalizar la votación tras votar
        if (IsLastProject)
        {
            await Http.PostAsync($"/api/votos/finalizar/{EventId}", null);
            NavigationManager.NavigateTo("/dashboard");
            return;
        }

        if (currentProjectIndex < mockProjects.Count - 1)
        {
            currentProjectIndex++;
            comments = "";
        }
        else
        {
            // Fallback: finalizar
            await Http.PostAsync($"/api/votos/finalizar/{EventId}", null);
            NavigationManager.NavigateTo("/dashboard");
        }
    }

    private async Task FinalizeVotingAsync()
    {
        try
        {
            await Http.PostAsync($"/api/votos/finalizar/{EventId}", null);
        }
        catch
        {
            // Ignorar errores en finalización del ejemplo
        }
        NavigationManager.NavigateTo("/dashboard");
    }

    private async Task SkipNext()
    {
        // Solo finalizar si el proyecto actual es el último de la lista.
        if (IsLastProject)
        {
            await FinalizeVotingAsync();
            return;
        }

        // Buscar siguiente proyecto no votado; si no hay, avanzar al siguiente índice hasta el final
        int nextIndex = currentProjectIndex + 1;
        while (nextIndex < mockProjects.Count && votedProjects.Contains(mockProjects[nextIndex].Id))
        {
            nextIndex++;
        }

        if (nextIndex < mockProjects.Count)
        {
            currentProjectIndex = nextIndex;
            return;
        }

        // No se encontró proyecto no votado después: mover al último proyecto disponible (sin finalizar)
        currentProjectIndex = mockProjects.Count - 1;
    }
    private void NavigateNext()
    {
        if (currentProjectIndex < mockProjects.Count - 1)
            currentProjectIndex++;
    }
    private void PreviousProject() => currentProjectIndex--;

    private bool publicoMostrarVotacion = false;
    private int publicoProyectoIndex = 0;
    private HashSet<int> publicosVotados = new();

    private async Task SubmitVotoPublico()
    {
        // Persistir el voto en la base de datos
        var proj = mockProjects[publicoProyectoIndex];
        errorVoto = null;
        if (!int.TryParse(EventId, out int votacionId))
        {
            errorVoto = "ID de votación inválido.";
            return;
        }
        try
        {
            var resp = await Http.PostAsJsonAsync("/api/votos/guardar", new
            {
                VotacionId = votacionId,
                ProyectoId = proj.DbId,
                Puntuacion = CalculateTotalScoreDouble(),
                Comentario = string.IsNullOrWhiteSpace(comments) ? (string?)null : comments
            });
            if (!resp.IsSuccessStatusCode)
            {
                var msg = await resp.Content.ReadAsStringAsync();
                errorVoto = $"Error: {msg}";
                return;
            }
        }
        catch (Exception ex)
        {
            errorVoto = $"Error de conexión: {ex.Message}";
            return;
        }

        publicosVotados.Add(publicoProyectoIndex);
        publicoMostrarVotacion = false;
        comments = "";
        commentLength = 0;
        await Http.PostAsync($"/api/votos/finalizar/{EventId}", null);
    }

    private async Task EliminarEvento()
    {
        eliminandoEvento = true;
        try
        {
            var resp = await Http.DeleteAsync($"/api/votaciones/{EventId}");
            if (resp.IsSuccessStatusCode)
            {
                NavigationManager.NavigateTo("/dashboard");
            }
            else
            {
                errorEliminarEvento = await resp.Content.ReadAsStringAsync();
                mostrarConfirmEliminarEvento = false;
            }
        }
        catch (Exception ex)
        {
            errorEliminarEvento = $"Error de conexión: {ex.Message}";
            mostrarConfirmEliminarEvento = false;
        }
        finally { eliminandoEvento = false; }
    }

    private void AgregarParticipanteManual()
    {
        var u = busquedaParticipante.Trim();
        if (!string.IsNullOrEmpty(u) && u != editParticipanteLeader && !editParticipantes.Contains(u))
            editParticipantes.Add(u);
        busquedaParticipante = string.Empty;
    }

    private void OnParticipanteKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            AgregarParticipanteManual();
    }

    private void StartEditProyecto(ProyectoResultadoDTO proj)
    {
        editandoProyectoId = proj.Id;
        editProyectoNombre = proj.Nombre;
        editProyectoDescripcion = proj.Descripcion ?? "";
        editParticipanteLeader = proj.Competidor;
        editParticipantes = proj.Participantes?.ToList() ?? new();
        busquedaParticipante = "";
        errorEditProyecto = null;
        confirmEliminarProyectoId = null;
        mostrarFormProyecto = false;
    }

    private async Task GuardarProyecto(ProyectoResultadoDTO proj)
    {
        errorEditProyecto = null;
        if (string.IsNullOrWhiteSpace(editProyectoNombre))
        {
            errorEditProyecto = "El nombre es obligatorio.";
            return;
        }
        guardandoProyecto = true;
        try
        {
            var resp = await Http.PutAsJsonAsync($"/api/proyectos/{EventId}/{proj.Id}", new
            {
                Nombre = editProyectoNombre.Trim(),
                Descripcion = editProyectoDescripcion?.Trim() ?? "",
                ParticipantesAdicionales = editParticipantes
            });
            if (resp.IsSuccessStatusCode)
            {
                proj.Nombre = editProyectoNombre.Trim();
                proj.Descripcion = editProyectoDescripcion?.Trim() ?? "";
                proj.Participantes = editParticipantes.ToList();
                editandoProyectoId = null;
            }
            else
            {
                errorEditProyecto = await resp.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            errorEditProyecto = $"Error de conexión: {ex.Message}";
        }
        finally { guardandoProyecto = false; }
    }

    private async Task EliminarProyecto(ProyectoResultadoDTO proj)
    {
        eliminandoProyecto = true;
        try
        {
            var resp = await Http.DeleteAsync($"/api/proyectos/{EventId}/{proj.Id}");
            if (resp.IsSuccessStatusCode)
            {
                proyectosOrganizador.Remove(proj);
                confirmEliminarProyectoId = null;
            }
            else
            {
                errorEditProyecto = await resp.Content.ReadAsStringAsync();
                confirmEliminarProyectoId = null;
            }
        }
        catch (Exception ex)
        {
            errorEditProyecto = $"Error de conexión: {ex.Message}";
            confirmEliminarProyectoId = null;
        }
        finally { eliminandoProyecto = false; }
    }

    private async Task CrearProyecto()
    {
        errorProyecto = null;
        if (string.IsNullOrWhiteSpace(nuevoNombre))
        {
            errorProyecto = "El nombre del proyecto es obligatorio.";
            return;
        }
        if (string.IsNullOrWhiteSpace(nuevoCompetidor))
        {
            errorProyecto = "El username del competidor es obligatorio.";
            return;
        }

        creandoProyecto = true;
        try
        {
            var resp = await Http.PostAsJsonAsync($"/api/proyectos/{EventId}", new
            {
                Nombre = nuevoNombre.Trim(),
                Descripcion = nuevaDescripcion.Trim(),
                UsernameCompetidor = nuevoCompetidor.Trim()
            });

            if (resp.IsSuccessStatusCode)
            {
                var creado = await resp.Content.ReadFromJsonAsync<ProyectoResultadoDTO>();
                if (creado != null) proyectosOrganizador.Add(creado);
                nuevoNombre = "";
                nuevaDescripcion = "";
                nuevoCompetidor = "";
                mostrarFormProyecto = false;
            }
            else
            {
                errorProyecto = await resp.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            errorProyecto = $"Error de conexión: {ex.Message}";
        }
        finally
        {
            creandoProyecto = false;
        }
    }

