@page "/dashboard"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using Votify.shared
@layout EmptyLayout
@inject NavigationManager NavigationManager
@inject HttpClient Http

<div class="min-h-screen bg-gradient-to-br from-[#E9EFE1] to-[#B5D6AC]">
    <header class="bg-white shadow-sm border-b border-[#B5D6AC]">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 grid grid-cols-3 items-center">
            <div></div>
            <div class="flex justify-center">
                <img src="imagenes/logo-votify.png" alt="Votify" class="h-16 object-contain" />
            </div>
            <div class="flex justify-end items-center gap-4">
                <a href="/" class="border border-[#6C8A6C] text-[#6C8A6C] hover:bg-[#E9EFE1] px-4 py-2 rounded-lg transition-colors text-sm font-medium">
                    Cerrar Sesión
                </a>
                <a href="/perfil" class="block w-12 h-12 rounded-full overflow-hidden border-2 border-[#6C8A6C] hover:border-[#4C6B4F] transition-colors flex-shrink-0">
                    <img src="@(string.IsNullOrEmpty(fotoPerfil) ? "imagenes/NoImageProfilePicture.png" : fotoPerfil)"
                         alt="Mi perfil" class="w-full h-full object-cover" />
                </a>
            </div>
        </div>
    </header>
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="bg-white rounded-2xl shadow-lg p-8 mb-8">
            <h2 class="text-3xl font-bold text-[#1A281B] mb-4">Bienvenido a Votify</h2>
            <p class="text-[#4C6B4F] leading-relaxed">
                <strong class="text-[#6C8A6C]">Votify</strong> es un sistema multiplataforma para gestionar votaciones y evaluaciones en eventos competitivos como hackathons, ferias de innovación y concursos.
            </p>
        </div>

        <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4 mb-6">
            <div class="flex items-center gap-2 bg-white/70 p-1 rounded-xl border border-[#B5D6AC] w-fit">
                <button @onclick='() => CambiarFiltroEventos("disponibles")'
                        class='px-4 py-2 rounded-lg text-sm font-medium transition-all @(filtroEventos == "disponibles" ? "bg-[#6C8A6C] text-white shadow" : "text-[#4C6B4F] hover:bg-[#E9EFE1]")'>
                    Eventos Disponibles
                </button>
                <button @onclick='() => CambiarFiltroEventos("finalizados")'
                        class='px-4 py-2 rounded-lg text-sm font-medium transition-all @(filtroEventos == "finalizados" ? "bg-[#6C8A6C] text-white shadow" : "text-[#4C6B4F] hover:bg-[#E9EFE1]")'>
                    Eventos Finalizados
                </button>
            </div>
            <button @onclick="IrACrearVotacion"
                    class="bg-gradient-to-r from-[#6C8A6C] to-[#4C6B4F] hover:from-[#4C6B4F] hover:to-[#345F35] text-white px-5 py-2 rounded-xl font-medium shadow-md transition-all w-fit">
                + Crear Evento
            </button>
        </div>

        @if (cargando)
        {
            <div class="flex justify-center items-center py-24">
                <div class="w-10 h-10 border-4 border-[#6C8A6C] border-t-transparent rounded-full animate-spin"></div>
            </div>
        }
        else if (!eventosFiltrados.Any())
        {
            <div class="bg-white rounded-2xl shadow p-10 text-center text-[#6C8A6C]">
                <p class="text-lg font-medium">@(filtroEventos == "finalizados" ? "No hay eventos finalizados." : "No hay eventos disponibles.")</p>
                <p class="text-sm mt-1">@(filtroEventos == "finalizados" ? "Aquí verás los resultados cuando termine un evento." : "Crea uno con el botón de arriba.")</p>
            </div>
        }
        else
        {

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var ev in eventosFiltrados)
            {
                <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow border border-[#B5D6AC]/30">
                    <div class="p-6 flex flex-col h-full">
                        <div class="flex items-center justify-between mb-4">
                            <span class="px-3 py-1 rounded-full text-xs font-bold inline-flex items-center gap-1.5 @GetStatusColor(ev.Status)">
                                <Icon Name="@GetStatusIcon(ev.Status)" CssClass="w-3.5 h-3.5" />
                                @GetStatusText(ev.Status)
                            </span>
                            @if (ev.Status == "active")
                            {
                                <div class="flex items-center gap-1 text-[#6C8A6C]">
                                    <span class="text-xs font-medium">@GetRoleHint(ev.RolActual)</span>
                                </div>
                            }
                        </div>

                        <h3 class="text-xl font-bold text-[#1A281B] mb-2">@ev.Name</h3>
                        <p class="text-[#6C8A6C] text-sm mb-4 line-clamp-2 h-10 overflow-hidden">@ev.Description</p>
                        <div class="mb-4">
                            <span class="inline-block w-fit px-3 py-1 rounded-full text-xs font-bold @(string.IsNullOrWhiteSpace(ev.RolActual) ? "bg-[#EFEFEE] text-[#6C8A6C]" : "bg-[#E9EFE1] text-[#4C6B4F]")">
                                @(string.IsNullOrWhiteSpace(ev.RolActual) ? "Sin rol asignado" : $"Mi rol: {FormatearRol(ev.RolActual)}")
                            </span>
                        </div>

                        <div class="space-y-2 mb-6 text-sm text-[#4C6B4F]">
                            <div class="flex items-center gap-2">
                                <Icon Name="calendar" CssClass="w-4 h-4 text-[#6C8A6C]" />
                                <span>@ev.Date</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <Icon Name="users" CssClass="w-4 h-4 text-[#6C8A6C]" />
                                <span>@ev.Participants participantes</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <Icon Name="trophy" CssClass="w-4 h-4 text-[#6C8A6C]" />
                                <span>@ev.Projects proyectos</span>
                            </div>
                        </div>

                        <div class="mt-auto">
                        @if (ev.Status == "active")
                        {
                            if(ev.RolActual == "ORGANIZADOR" || ev.RolActual == "ENCARGADO")
                            {
                                    <div class="flex gap-2">
                                        <button @onclick="() => NavigateToEvent(ev.Id)"
                                                class="flex-1 bg-gradient-to-r from-[#6C8A6C] to-[#4C6B4F] text-white py-3 rounded-xl font-bold transition-all shadow-md">
                                            @(ev.Status == "paused" ? "▶ Reanudar" : "Gestionar")
                                        </button>
                                        <button @onclick="() => NavigateToResults(ev.Id)"
                                                class="flex-1 bg-white border-2 border-[#6C8A6C] text-[#6C8A6C] hover:bg-[#E9EFE1] py-3 rounded-xl font-bold transition-all">
                                            Resultados
                                        </button>
                                    </div>
                            }
                            else
                            {
                                <button @onclick="() => NavigateToEvent(ev.Id)"
                                        class="w-full bg-gradient-to-r from-[#6C8A6C] to-[#4C6B4F] text-white py-3 rounded-xl font-bold transition-all shadow-md">
                                    @GetPrimaryActionText(ev.RolActual)
                                </button>
                            }
                        }
                            else if (ev.Status == "paused")
                            {
                                if (ev.RolActual == "ORGANIZADOR" || ev.RolActual == "ENCARGADO")
                                {
                                    <div class="flex gap-2">
                                        <button @onclick="() => NavigateToEvent(ev.Id)"
                                                class="flex-1 bg-gradient-to-r from-[#6C8A6C] to-[#4C6B4F] text-white py-3 rounded-xl font-bold transition-all shadow-md">
                                            ▶ Reanudar / Gestionar
                                        </button>
                                        <button @onclick="() => NavigateToResults(ev.Id)"
                                                class="flex-1 bg-white border-2 border-[#6C8A6C] text-[#6C8A6C] hover:bg-[#E9EFE1] py-3 rounded-xl font-bold transition-all">
                                            Resultados
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <button disabled class="w-full bg-[#EFEFEE] text-[#A6AAA9] py-3 rounded-xl font-bold cursor-not-allowed">
                                        Votación pausada
                                    </button>
                                }
                            }
                        else if (ev.Status == "upcoming")
                        {
                            <button disabled class="w-full bg-[#EFEFEE] text-[#A6AAA9] py-3 rounded-xl font-bold cursor-not-allowed">
                                Próximamente
                            </button>
                        }
                        else if (ev.Status == "finished")
                        {
                            <button @onclick="() => NavigateToResults(ev.Id)" class="w-full bg-[#90A896] hover:bg-[#6C8A6C] text-white py-3 rounded-xl font-bold transition-all">
                                Ver Resultados
                            </button>
                        }
                        </div>
                    </div>
                </div>
            }
        </div>
        } @* fin else *@
    </main>
</div>

@code {
    private string? fotoPerfil;
    private bool cargando = true;
    private string filtroEventos = "disponibles";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var perfilRes = await Http.GetAsync("/api/perfil");
            if (perfilRes.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                NavigationManager.NavigateTo("/login", forceLoad: true);
                return;
            }
            var res = await perfilRes.Content.ReadFromJsonAsync<PerfilDTO>();
            fotoPerfil = res?.FotoPerfil;
        }
        catch { }

        try
        {
            var votaciones = await Http.GetFromJsonAsync<List<VotacionDTO>>("/api/votaciones");
            if (votaciones != null)
            {
                mockEvents = votaciones
                    .GroupBy(v => v.IdEvento)
                    .Select(g =>
                    {
                        var primera = g.OrderBy(v => v.FechaFin).First();
                        var fechaEvento = g.Max(v => v.FechaFin);
                        var ahora = DateTime.Now;
                        bool hayActiva = g.Any(v => v.Estado && v.FechaFin > ahora);
                        bool hayPendiente = g.Any(v => v.FechaFin > ahora);
                        return new EventModel
                        {
                            Id = g.Key.ToString(),
                            Name = string.IsNullOrWhiteSpace(primera.NombreEvento)
                                ? (string.IsNullOrWhiteSpace(primera.Titulo) ? $"Evento #{g.Key}" : primera.Titulo)
                                : primera.NombreEvento,
                            Description = string.IsNullOrWhiteSpace(primera.Descripcion) ? "Sin descripción" : primera.Descripcion,
                            Date = fechaEvento.ToString("dd/MM/yyyy"),
                            FechaOrden = fechaEvento,
                            Status = hayActiva ? "active" : hayPendiente ? "paused" : "finished",
                            Participants = 0,
                            Projects = 0,
                            RolActual = primera.RolActual
                        };
                    })
                    .OrderBy(e => e.FechaOrden)
                    .ToList();
            }
        }
        catch { }
        finally
        {
            cargando = false;
        }
    }

    private class PerfilDTO
    {
        public string? FotoPerfil { get; set; }
    }

    private void NavigateToEvent(string id)
    {
        NavigationManager.NavigateTo($"/event-access/{id}?dest=voting");
    }

    private void NavigateToResults(string id)
    {
        NavigationManager.NavigateTo($"/event-access/{id}?dest=results");
    }

    private string GetStatusColor(string status) => status switch
    {
        "active" => "bg-[#6C8A6C] text-white",
        "upcoming" => "bg-[#B5D6AC] text-[#1A281B]",
        "paused" => "bg-[#90A896] text-white",
        "finished" => "bg-[#A6AAA9] text-white",
        _ => "bg-gray-300"
    };

    private string GetStatusIcon(string status) => status switch
    {
        "active" => "play",
        "upcoming" => "calendar",
        "paused" => "cog",
        "finished" => "check-circle",
        _ => "star"
    };

    private string GetStatusText(string status) => status switch
    {
        "active" => "En Curso",
        "upcoming" => "Próximamente",
        "paused" => "Pausado",
        "finished" => "Finalizado",
        _ => status
    };

    private void IrACrearVotacion()
    {
        NavigationManager.NavigateTo("/crear-votacion");
    }

    private static string GetPrimaryActionText(string? rolActual) => rolActual switch
    {
        "COMPETIDOR" => "Ver mi participación",
        "JURADO" => "Entrar a votar",
        "PUBLICO" => "Entrar al evento",
        _ => "Acceder al evento"
    };

    private static string GetRoleHint(string? rolActual) => rolActual switch
    {
        "ORGANIZADOR" => "● Gestión del evento",
        "ENCARGADO" => "● Control de votación",
        "COMPETIDOR" => "● Participando en el evento",
        "JURADO" => "● Listo para votar",
        "PUBLICO" => "● Acceso público",
        _ => "● Elige tu rol al entrar"
    };

    private static string FormatearRol(string? rolActual) => rolActual switch
    {
        "ORGANIZADOR" => "Organizador",
        "ENCARGADO" => "Encargado",
        "COMPETIDOR" => "Competidor",
        "JURADO" => "Jurado",
        "PUBLICO" => "Público",
        _ => "Sin rol"
    };

    private IEnumerable<EventModel> eventosFiltrados =>
        filtroEventos == "finalizados"
            ? mockEvents.Where(e => e.Status == "finished")
            : mockEvents.Where(e => e.Status != "finished");

    private void CambiarFiltroEventos(string filtro)
    {
        filtroEventos = filtro;
    }

    private List<EventModel> mockEvents = new();

    public class EventModel
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public string Date { get; set; } = "";
        public DateTime FechaOrden { get; set; }
        public int Participants { get; set; }
        public string Status { get; set; } = ""; 
        public int Projects { get; set; }
        public string? RolActual { get; set; }
    }
}
